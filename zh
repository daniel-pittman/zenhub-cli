}

cmd_sprint() {
    load_config

    local sprint_name=""
    local show_urls=true

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-urls)
                show_urls=false
                shift
                ;;
            *)
                if [[ -z "$sprint_name" ]]; then
                    sprint_name="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$sprint_name" ]]; then
        error "Usage: zh sprint <name> [--no-urls]

View issues in a sprint.

Examples:
  zh sprint \"Sprint 5\"
  zh sprint current          # View active sprint
  zh sprint current --no-urls"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting sprint details..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get all open sprints to find the one we want
    local sprints_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            activeSprint {
                id
                name
            }
            sprints(first: 50, filters: {}) {
                nodes {
                    id
                    name
                    state
                }
            }
        }
    }'

    local sprints_vars
    sprints_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local sprints_response
    sprints_response=$(zh_graphql "$sprints_query" "$sprints_vars")

    local sprint_id
    if [[ "$sprint_name" == "current" ]] || [[ "$sprint_name" == "active" ]]; then
        sprint_id=$(echo "$sprints_response" | jq -r '.data.workspace.activeSprint.id // empty')
        if [[ -z "$sprint_id" ]]; then
            error "No active sprint found"
        fi
        sprint_name=$(echo "$sprints_response" | jq -r '.data.workspace.activeSprint.name')
    else
        # Find sprint by name (case-insensitive)
        sprint_id=$(echo "$sprints_response" | jq -r --arg name "$sprint_name" \
            '.data.workspace.sprints.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .id' | head -1)

        if [[ -z "$sprint_id" ]]; then
            echo -e "${RED}Error:${NC} Sprint '${sprint_name}' not found." >&2
            echo ""
            echo "Available sprints:"
            echo "$sprints_response" | jq -r '.data.workspace.sprints.nodes[] | "  - \(.name) (\(.state))"'
            exit 1
        fi
    fi

    # Get sprint details with issues
    local detail_query='
    query($sprintId: ID!) {
        node(id: $sprintId) {
            ... on Sprint {
                id
                name
                description
                state
                startAt
                endAt
                completedPoints
                totalPoints
                closedIssuesCount
                sprintIssues(first: 100) {
                    nodes {
                        issue {
                            number
                            title
                            state
                            htmlUrl
                            estimate {
                                value
                            }
                            assignees {
                                nodes {
                                    login
                                }
                            }
                            repository {
                                ownerName
                                name
                            }
                            pipelineIssues {
                                nodes {
                                    pipeline {
                                        name
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }'

    local detail_vars
    detail_vars=$(jq -n --arg sprint_id "$sprint_id" '{sprintId: $sprint_id}')

    local detail_response
    detail_response=$(zh_graphql "$detail_query" "$detail_vars")

    local sprint_state start_at end_at completed_pts total_pts closed_count description
    sprint_state=$(echo "$detail_response" | jq -r '.data.node.state // "UNKNOWN"')
    start_at=$(echo "$detail_response" | jq -r '.data.node.startAt[:10] // "?"')
    end_at=$(echo "$detail_response" | jq -r '.data.node.endAt[:10] // "?"')
    completed_pts=$(echo "$detail_response" | jq -r '.data.node.completedPoints // 0')
    total_pts=$(echo "$detail_response" | jq -r '.data.node.totalPoints // 0')
    closed_count=$(echo "$detail_response" | jq -r '.data.node.closedIssuesCount // 0')
    description=$(echo "$detail_response" | jq -r '.data.node.description // empty')

    local issue_count
    issue_count=$(echo "$detail_response" | jq '.data.node.sprintIssues.nodes | length')

    echo ""
    echo -e "${BOLD}Sprint: ${sprint_name}${NC}"
    echo ""
    echo -e "  ${CYAN}State:${NC}     ${sprint_state}"
    echo -e "  ${CYAN}Period:${NC}    ${start_at} → ${end_at}"
    echo -e "  ${CYAN}Points:${NC}    ${completed_pts}/${total_pts} completed"
    echo -e "  ${CYAN}Closed:${NC}    ${closed_count} issues"
    if [[ -n "$description" ]]; then
        echo -e "  ${CYAN}Description:${NC} ${description}"
    fi
    echo ""
    echo -e "${BOLD}Issues (${issue_count}):${NC}"
    echo ""

    if [[ "$issue_count" -eq 0 ]]; then
        echo "  No issues in this sprint"
    else
        if [[ "$show_urls" == "true" ]]; then
            echo "$detail_response" | jq -r '.data.node.sprintIssues.nodes[].issue |
                "\(.state)" as $state |
                "  #\(.number) │ \(.repository.ownerName)/\(.repository.name) │ \((.estimate.value // "—") | tostring) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end) │ \(.pipelineIssues.nodes[0].pipeline.name // "—")\n    \(if $state == "CLOSED" then "✓ " else "" end)\(.title)\n    → \(.htmlUrl)\n"'
        else
            echo "$detail_response" | jq -r '.data.node.sprintIssues.nodes[].issue |
                "\(.state)" as $state |
                "  #\(.number | tostring | (" " * (5 - length)) + .) │ \((.estimate.value // "—") | tostring | (" " * (3 - length)) + .) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end | if length > 12 then .[:9] + "..." else . end | . + (" " * (12 - length))) │ \(if $state == "CLOSED" then "✓ " else "  " end)\(.title | if length > 40 then .[:37] + "..." else . end)"'
        fi
    fi
    echo ""
}

cmd_sprint_add() {
    load_config

    local issue_num="${1:-}"
    local sprint_name="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$sprint_name" ]]; then
        error "Usage: zh sprint-add <issue_number> <sprint_name>

Add an issue to a sprint.

Examples:
  zh sprint-add 42 \"Sprint 5\"
  zh sprint-add 42 current    # Add to active sprint"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    info "Adding issue #${issue_num} to sprint '${sprint_name}'..."

    # Get issue ID
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    # Get sprint ID
    local sprints_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            activeSprint {
                id
                name
            }
            sprints(first: 50, filters: { state: { eq: OPEN } }) {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local sprints_vars
    sprints_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local sprints_response
    sprints_response=$(zh_graphql "$sprints_query" "$sprints_vars")

    local sprint_id sprint_actual_name
    if [[ "$sprint_name" == "current" ]] || [[ "$sprint_name" == "active" ]]; then
        sprint_id=$(echo "$sprints_response" | jq -r '.data.workspace.activeSprint.id // empty')
        sprint_actual_name=$(echo "$sprints_response" | jq -r '.data.workspace.activeSprint.name')
        if [[ -z "$sprint_id" ]]; then
            error "No active sprint found"
        fi
    else
        sprint_id=$(echo "$sprints_response" | jq -r --arg name "$sprint_name" \
            '.data.workspace.sprints.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .id' | head -1)
        sprint_actual_name=$(echo "$sprints_response" | jq -r --arg name "$sprint_name" \
            '.data.workspace.sprints.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .name' | head -1)

        if [[ -z "$sprint_id" ]]; then
            echo -e "${RED}Error:${NC} Sprint '${sprint_name}' not found." >&2
            echo ""
            echo "Available open sprints:"
            echo "$sprints_response" | jq -r '.data.workspace.sprints.nodes[] | "  - \(.name)"'
            exit 1
        fi
    fi

    # Add issue to sprint
    local mutation='
    mutation($issueIds: [ID!]!, $sprintIds: [ID!]!) {
        addIssuesToSprints(input: {
            issueIds: $issueIds,
            sprintIds: $sprintIds
        }) {
            clientMutationId
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg issue_id "$issue_id" --arg sprint_id "$sprint_id" \
        '{issueIds: [$issue_id], sprintIds: [$sprint_id]}')

    zh_graphql "$mutation" "$mutation_vars" > /dev/null

    echo ""
    success "Added #${issue_num} (${issue_title}) to sprint '${sprint_actual_name}'"
}

