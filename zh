            cmd_epic_list "$@"
            ;;
        show|view)
            cmd_epic_show "$@"
            ;;
        create|new)
            cmd_epic_create "$@"
            ;;
        update|edit|modify)
            cmd_epic_update "$@"
            ;;
        add)
            cmd_epic_add "$@"
            ;;
        remove|rm)
            cmd_epic_remove "$@"
            ;;
        close)
            cmd_epic_close "$@"
            ;;
        reopen|open)
            cmd_epic_reopen "$@"
            ;;
        delete)
            cmd_epic_delete "$@"
            ;;
        ""|help|-h|--help)
            cat << 'EOF'
zh epic - Manage ZenHub native epics

USAGE:
    zh epic <subcommand> [args]

SUBCOMMANDS:
    list                              List all epics in the workspace
    show <epic#>                      Show epic details + child issues
