cmd_workspaces() {
    load_config

    local owner_repo
    owner_repo=$(get_repo_info)
    info "Getting workspaces for ${owner_repo}..."

    # Get GitHub repo ID
    local gh_id
    gh_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>/dev/null)

    if [[ -z "$gh_id" ]]; then
        error "Could not get GitHub repo ID for: $owner_repo"
    fi

    local query='
    query($ghIds: [Int!]!) {
        repositoriesByGhId(ghIds: $ghIds) {
            id
            name
            workspacesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --argjson gh_id "$gh_id" '{ghIds: [$gh_id]}')

    local response
    response=$(zh_graphql "$query" "$variables")

    echo ""
    echo -e "${BOLD}Workspaces:${NC}"
    echo ""

    echo "$response" | jq -r '.data.repositoriesByGhId[0].workspacesConnection.nodes[] |
        "  \(.name)\n    ID: \(.id)\n"'
}

cmd_pipelines() {
    load_config

    local owner_repo
    if [[ -n "${1:-}" ]]; then
        owner_repo="$1"
    else
        owner_repo=$(get_repo_info)
    fi

    info "Getting pipelines for ${owner_repo}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            id
            name
            pipelinesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local workspace_name
    workspace_name=$(echo "$response" | jq -r '.data.workspace.name')

    echo ""
    echo -e "${BOLD}Workspace:${NC} $workspace_name"
    echo -e "${BOLD}Pipelines:${NC}"
    echo ""

    echo "$response" | jq -r '.data.workspace.pipelinesConnection.nodes[] | "  \(.name)"'

    echo ""
    echo -e "${CYAN}Tip:${NC} Use 'zh move <issue#> \"<pipeline name>\"' to move an issue"
}

cmd_move() {
    load_config

    local issue_num="${1:-}"
    local pipeline_name="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$pipeline_name" ]]; then
        error "Usage: zh move <issue_number> <pipeline_name>
Example: zh move 679 \"In Review\""
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Moving issue #${issue_num} to '${pipeline_name}'..."

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get pipeline ID by name
    local pipelines_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            pipelinesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local pipelines_vars
    pipelines_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local pipelines_response
    pipelines_response=$(zh_graphql "$pipelines_query" "$pipelines_vars")

    # Find pipeline by name (case-insensitive, trim whitespace)
    local pipeline_id
    pipeline_id=$(echo "$pipelines_response" | jq -r --arg name "$pipeline_name" \
        '.data.workspace.pipelinesConnection.nodes[] | select((.name | gsub("^\\s+|\\s+$"; "") | ascii_downcase) == ($name | gsub("^\\s+|\\s+$"; "") | ascii_downcase)) | .id')

    if [[ -z "$pipeline_id" ]]; then
        echo -e "${RED}Error:${NC} Pipeline '${pipeline_name}' not found." >&2
        echo ""
        echo "Available pipelines:"
        echo "$pipelines_response" | jq -r '.data.workspace.pipelinesConnection.nodes[] | "  - \(.name)"'
        exit 1
    fi

    # Get the issue ID from ZenHub
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            number
            title
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found in ZenHub"
    fi

    local issue_title
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')

    # Get actual pipeline name we matched (for display)
    local target_pipeline_name
    target_pipeline_name=$(echo "$pipelines_response" | jq -r --arg id "$pipeline_id" \
        '.data.workspace.pipelinesConnection.nodes[] | select(.id == $id) | .name')

    # Move the issue
    local move_mutation='
    mutation($input: MoveIssueInput!) {
        moveIssue(input: $input) {
            issue {
                id
            }
        }
    }'

    local move_vars
    move_vars=$(jq -n \
        --arg issue_id "$issue_id" \
        --arg pipeline_id "$pipeline_id" \
        '{input: {issueId: $issue_id, pipelineId: $pipeline_id, position: 0}}')

    zh_graphql "$move_mutation" "$move_vars" > /dev/null

    echo ""
    success "Moved issue #${issue_num}: ${issue_title}"
    echo -e "  → ${GREEN}${target_pipeline_name}${NC}"
}

cmd_issue() {
    load_config

    local issue_num="${1:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh issue <issue_number>
Example: zh issue 679"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            number
            title
            body
            state
            htmlUrl
            estimate {
                value
            }
            issueType {
                name
            }
            parentIssues {
                nodes {
                    number
                    title
                    repository {
                        ownerName
                        name
                    }
                }
            }
            childIssues {
                nodes {
                    number
                    title
                    state
                    repository {
                        ownerName
                        name
                    }
                }
            }
            assignees {
                nodes {
                    login
                    name
                }
            }
            labels {
                nodes {
                    name
                    color
                }
            }
            pipelineIssues {
                nodes {
                    pipeline {
                        name
                    }
                }
            }
            blockingIssues {
                nodes {
                    number
                    title
                }
            }
            blockedIssues {
                nodes {
                    number
                    title
                }
            }
            createdAt
            updatedAt
        }
    }'

    local variables
    variables=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local issue
    issue=$(echo "$response" | jq '.data.issueByInfo')

    if [[ "$issue" == "null" ]]; then
        error "Issue #${issue_num} not found"
    fi

    local title state pipeline estimate assignees labels gh_url zh_url blocking_issues blocked_issues issue_type parent_issues child_issues
    title=$(echo "$issue" | jq -r '.title')
    state=$(echo "$issue" | jq -r '.state')
    pipeline=$(echo "$issue" | jq -r '.pipelineIssues.nodes[0].pipeline.name // "None"')
    estimate=$(echo "$issue" | jq -r '.estimate.value // "—"')
    issue_type=$(echo "$issue" | jq -r '.issueType.name // "—"')
    assignees=$(echo "$issue" | jq -r '[.assignees.nodes[].login] | join(", ") | if . == "" then "Unassigned" else . end')
    labels=$(echo "$issue" | jq -r '[.labels.nodes[].name] | join(", ") | if . == "" then "None" else . end')
    gh_url=$(echo "$issue" | jq -r '.htmlUrl')
    zh_url=$(build_zenhub_url "$workspace_id" "$owner_repo" "$issue_num")
    blocking_issues=$(echo "$issue" | jq -r '[.blockingIssues.nodes[] | "#\(.number)"] | join(", ")')
    blocked_issues=$(echo "$issue" | jq -r '[.blockedIssues.nodes[] | "#\(.number)"] | join(", ")')
    parent_issues=$(echo "$issue" | jq -r '[.parentIssues.nodes[] | "#\(.number) (\(.repository.ownerName)/\(.repository.name))"] | join(", ")')
    child_issues=$(echo "$issue" | jq -r '[.childIssues.nodes[] | "#\(.number) \(if .state == "CLOSED" then "✓" else "" end)\(.title)"] | join("\n    ")')

    echo ""
    echo -e "${BOLD}#${issue_num}${NC} ${title}"
    echo ""
    echo -e "  ${CYAN}State:${NC}     ${state}"
    echo -e "  ${CYAN}Type:${NC}      ${issue_type}"
    echo -e "  ${CYAN}Pipeline:${NC}  ${pipeline}"
    echo -e "  ${CYAN}Estimate:${NC}  ${estimate}"
    echo -e "  ${CYAN}Assignees:${NC} ${assignees}"
    echo -e "  ${CYAN}Labels:${NC}    ${labels}"
    if [[ -n "$parent_issues" ]]; then
        echo -e "  ${CYAN}Parent:${NC}    ${parent_issues}"
    fi
    if [[ -n "$child_issues" ]]; then
        echo -e "  ${CYAN}Children:${NC}"
        echo -e "    ${child_issues}"
    fi
    if [[ -n "$blocking_issues" ]]; then
        echo -e "  ${YELLOW}Blocked by:${NC} ${blocking_issues}"
    fi
    if [[ -n "$blocked_issues" ]]; then
        echo -e "  ${YELLOW}Blocking:${NC}  ${blocked_issues}"
    fi
    echo -e "  ${CYAN}ZenHub:${NC}    ${zh_url}"
    echo -e "  ${CYAN}GitHub:${NC}    ${gh_url}"
    echo ""
}

cmd_mine() {
    load_config

    local owner_repo
    owner_repo=$(get_repo_info)

    local target_user=""
    local show_urls=true

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-urls)
                show_urls=false
                shift
                ;;
            -*)
                shift
                ;;
            *)
                if [[ -z "$target_user" ]]; then
                    target_user="$1"
                fi
                shift
                ;;
        esac
    done

    # If no user specified, use current GitHub user
    if [[ -z "$target_user" ]]; then
        target_user=$(gh api user --jq '.login' 2>/dev/null)
        if [[ -z "$target_user" ]]; then
            error "Could not get GitHub username (is gh CLI authenticated?)"
        fi
    else
        # Strip @ prefix if present
        target_user="${target_user#@}"
    fi

    info "Finding issues assigned to ${target_user}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get pipeline IDs first
    local pipelines_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            pipelinesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local pipelines_vars
    pipelines_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local pipelines_response
    pipelines_response=$(zh_graphql "$pipelines_query" "$pipelines_vars")

    local pipelines
    pipelines=$(echo "$pipelines_response" | jq -c '.data.workspace.pipelinesConnection.nodes[]')

    # Collect all issues assigned to user across pipelines
    local all_issues="[]"

    while IFS= read -r pipeline; do
        local pipeline_id pipeline_name
        pipeline_id=$(echo "$pipeline" | jq -r '.id')
        pipeline_name=$(echo "$pipeline" | jq -r '.name')

        # Search issues in this pipeline filtered by assignee
        local query='
        query($pipelineId: ID!, $workspaceId: ID!, $filters: IssueSearchFiltersInput!) {
            searchIssuesByPipeline(
                pipelineId: $pipelineId
                filters: $filters
                first: 50
            ) {
                nodes {
                    number
                    title
                    zenhubUrl(workspaceId: $workspaceId)
                    estimate {
                        value
                    }
                    assignees {
                        nodes {
                            login
                        }
                    }
                    repository {
                        ownerName
                        name
                    }
                }
            }
        }'

        local variables
        variables=$(jq -n --arg pipeline_id "$pipeline_id" --arg workspace_id "$workspace_id" --arg user "$target_user" \
            '{pipelineId: $pipeline_id, workspaceId: $workspace_id, filters: {assignees: {in: [$user]}}}')

        local response
        response=$(zh_graphql "$query" "$variables" 2>/dev/null) || continue

        # Add pipeline name to each issue and merge
        local issues_with_pipeline
        issues_with_pipeline=$(echo "$response" | jq --arg pname "$pipeline_name" \
            '[.data.searchIssuesByPipeline.nodes[] | . + {pipeline: $pname}]')

        all_issues=$(echo "$all_issues" "$issues_with_pipeline" | jq -s 'add')
    done <<< "$pipelines"

    local count
    count=$(echo "$all_issues" | jq 'length')

    echo ""
    echo -e "${BOLD}Issues assigned to ${target_user} (${count}):${NC}"
    echo ""

    if [[ "$count" -eq 0 ]]; then
        echo "  No issues assigned"
    else
        if [[ "$show_urls" == "true" ]]; then
            # Show with URLs and repo info (one issue per block)
            echo "$all_issues" | jq -r '.[] |
                "  #\(.number) │ \(.repository.ownerName)/\(.repository.name) │ \(.pipeline)\n    \(.title)\n    → \(.zenhubUrl)\n"'
        else
            # Compact view without URLs
            echo "$all_issues" | jq -r '.[] |
                "\(.repository.ownerName)/\(.repository.name)" as $repo |
                "  #\(.number | tostring | (" " * (5 - length)) + .) │ \($repo | if length > 20 then .[:17] + "..." else . + (" " * (20 - length)) end) │ \(.pipeline | if length > 15 then .[:12] + "..." else . + (" " * (15 - length)) end) │ \(.title | if length > 35 then .[:32] + "..." else . end)"'
        fi
    fi
}

cmd_board() {
    load_config

    local include_closed=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a)
                include_closed=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting board overview for ${owner_repo}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local query
    if [[ "$include_closed" == "true" ]]; then
        query='
        query($workspaceId: ID!) {
            workspace(id: $workspaceId) {
                name
                pipelinesConnection {
                    nodes {
                        id
                        name
                        issues {
                            totalCount
                        }
                    }
                }
            }
        }'
    else
        query='
        query($workspaceId: ID!) {
            workspace(id: $workspaceId) {
                name
                pipelinesConnection {
                    nodes {
                        id
                        name
                        issues(state: OPEN) {
                            totalCount
                        }
                    }
                }
            }
        }'
    fi

    local variables
    variables=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local workspace_name
    workspace_name=$(echo "$response" | jq -r '.data.workspace.name')

    local total
    total=$(echo "$response" | jq '[.data.workspace.pipelinesConnection.nodes[].issues.totalCount] | add')

    echo ""
    if [[ "$include_closed" == "true" ]]; then
        echo -e "${BOLD}Board: ${workspace_name}${NC} (${total} total issues)"
    else
        echo -e "${BOLD}Board: ${workspace_name}${NC} (${total} open issues)"
    fi
    echo ""

    # Print pipelines with counts as a simple bar chart
    echo "$response" | jq -r '.data.workspace.pipelinesConnection.nodes[] |
        "\(.name)\t\(.issues.totalCount)"' | while IFS=$'\t' read -r name count; do
        # Pad the name
        printf "  %-25s %3d " "$name" "$count"
        # Draw a simple bar
        local bar=""
        for ((i=0; i<count && i<30; i++)); do
            bar+="█"
        done
        if [[ $count -gt 30 ]]; then
            bar+="…"
        fi
        echo -e "${GREEN}${bar}${NC}"
    done

    echo ""
}

cmd_pipeline() {
    load_config

    local pipeline_name=""
    local include_closed=false
    local show_urls=true

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a)
                include_closed=true
                shift
                ;;
            --no-urls)
                show_urls=false
                shift
                ;;
            *)
                if [[ -z "$pipeline_name" ]]; then
                    pipeline_name="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$pipeline_name" ]]; then
        error "Usage: zh pipeline <pipeline_name> [--all] [--no-urls]
Example: zh pipeline \"In Progress\"
         zh pipeline todo --all       # Include closed issues
         zh pipeline todo --no-urls   # Hide URLs"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting issues in '${pipeline_name}'..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # First get the pipeline ID
    local pipelines_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            pipelinesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local pipelines_vars
    pipelines_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local pipelines_response
    pipelines_response=$(zh_graphql "$pipelines_query" "$pipelines_vars")

    # Find pipeline by name (case-insensitive, trim whitespace)
    local pipeline_id pipeline_actual_name
    pipeline_id=$(echo "$pipelines_response" | jq -r --arg name "$pipeline_name" \
        '.data.workspace.pipelinesConnection.nodes[] | select((.name | gsub("^\\s+|\\s+$"; "") | ascii_downcase) == ($name | gsub("^\\s+|\\s+$"; "") | ascii_downcase)) | .id')
    pipeline_actual_name=$(echo "$pipelines_response" | jq -r --arg name "$pipeline_name" \
        '.data.workspace.pipelinesConnection.nodes[] | select((.name | gsub("^\\s+|\\s+$"; "") | ascii_downcase) == ($name | gsub("^\\s+|\\s+$"; "") | ascii_downcase)) | .name')

    if [[ -z "$pipeline_id" ]]; then
        echo -e "${RED}Error:${NC} Pipeline '${pipeline_name}' not found." >&2
        echo ""
        echo "Available pipelines:"
        echo "$pipelines_response" | jq -r '.data.workspace.pipelinesConnection.nodes[] | "  - \(.name)"'
        exit 1
    fi

    # Get issues in this pipeline
    local query='
    query($pipelineId: ID!, $workspaceId: ID!, $filters: IssueSearchFiltersInput!) {
        searchIssuesByPipeline(
            pipelineId: $pipelineId
            filters: $filters
            first: 50
        ) {
            nodes {
                number
                title
                state
                zenhubUrl(workspaceId: $workspaceId)
                estimate {
                    value
                }
                assignees {
                    nodes {
                        login
                    }
                }
                repository {
                    ownerName
                    name
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg pipeline_id "$pipeline_id" --arg workspace_id "$workspace_id" \
        '{pipelineId: $pipeline_id, workspaceId: $workspace_id, filters: {}}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local issues
    if [[ "$include_closed" == "true" ]]; then
        issues=$(echo "$response" | jq '.data.searchIssuesByPipeline.nodes')
    else
        issues=$(echo "$response" | jq '[.data.searchIssuesByPipeline.nodes[] | select(.state != "CLOSED")]')
    fi

    local count
    count=$(echo "$issues" | jq 'length')

    local total_count
    total_count=$(echo "$response" | jq '.data.searchIssuesByPipeline.nodes | length')

    local closed_count=$((total_count - count))

    echo ""
    if [[ "$include_closed" == "true" ]]; then
        echo -e "${BOLD}Pipeline: ${pipeline_actual_name}${NC} (${count} issues)"
    else
        if [[ $closed_count -gt 0 ]]; then
            echo -e "${BOLD}Pipeline: ${pipeline_actual_name}${NC} (${count} open, ${closed_count} closed hidden)"
        else
            echo -e "${BOLD}Pipeline: ${pipeline_actual_name}${NC} (${count} issues)"
        fi
    fi
    echo ""

    if [[ "$count" -eq 0 ]]; then
        echo "  No issues in this pipeline"
    else
        if [[ "$show_urls" == "true" ]]; then
            # Show with URLs and repo info
            echo "$issues" | jq -r '.[] |
                "\(.state)" as $state |
                "  #\(.number) │ \(.repository.ownerName)/\(.repository.name) │ \((.estimate.value // "—") | tostring) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end)\n    \(if $state == "CLOSED" then "✓ " else "" end)\(.title)\n    → \(.zenhubUrl)\n"'
        else
            # Compact view without URLs
            echo "$issues" | jq -r '.[] |
                "\(.state)" as $state |
                "  #\(.number | tostring | (" " * (5 - length)) + .) │ \((.estimate.value // "—") | tostring | (" " * (3 - length)) + .) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end | if length > 12 then .[:9] + "..." else . end | . + (" " * (12 - length))) │ \(if $state == "CLOSED" then "✓ " else "  " end)\(.title | if length > 43 then .[:40] + "..." else . end)"'
        fi
    fi
    echo ""
}

cmd_reorder() {
    load_config

    local issue_num="${1:-}"
    local position="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$position" ]]; then
        error "Usage: zh reorder <issue_number> <position>
       zh reorder <issue_number> top
       zh reorder <issue_number> bottom

Examples:
  zh reorder 679 0      # Move to top of pipeline
  zh reorder 679 top    # Move to top
  zh reorder 679 5      # Move to position 5
  zh reorder 679 bottom # Move to bottom"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get the issue's current pipeline
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            number
            title
            pipelineIssues {
                nodes {
                    pipeline {
                        id
                        name
                        issues {
                            totalCount
                        }
                    }
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title pipeline_id pipeline_name total_count
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')
    pipeline_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssues.nodes[0].pipeline.id // empty')
    pipeline_name=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssues.nodes[0].pipeline.name // "Unknown"')
    total_count=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssues.nodes[0].pipeline.issues.totalCount // 0')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found in ZenHub"
    fi

    if [[ -z "$pipeline_id" ]]; then
        error "Issue #${issue_num} is not in any pipeline"
    fi

    # Handle special position keywords
    local pos_int
    case "$position" in
        top|first|0)
            pos_int=0
            ;;
        bottom|last)
            pos_int=$((total_count - 1))
            ;;
        *)
            if [[ "$position" =~ ^[0-9]+$ ]]; then
                pos_int=$position
            else
                error "Invalid position: $position (use a number, 'top', or 'bottom')"
            fi
            ;;
    esac

    info "Moving issue #${issue_num} to position ${pos_int} in '${pipeline_name}'..."

    # Move the issue (to same pipeline but different position)
    local move_mutation='
    mutation($input: MoveIssueInput!) {
        moveIssue(input: $input) {
            issue {
                id
            }
        }
    }'

    local move_vars
    move_vars=$(jq -n \
        --arg issue_id "$issue_id" \
        --arg pipeline_id "$pipeline_id" \
        --argjson position "$pos_int" \
        '{input: {issueId: $issue_id, pipelineId: $pipeline_id, position: $position}}')

    zh_graphql "$move_mutation" "$move_vars" > /dev/null

    echo ""
    success "Reordered issue #${issue_num}: ${issue_title}"
    echo -e "  Now at position ${CYAN}${pos_int}${NC} in ${GREEN}${pipeline_name}${NC}"
}

cmd_estimate() {
    load_config

    local issue_num="${1:-}"
    local points="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$points" ]]; then
        error "Usage: zh estimate <issue_number> <points>
Example: zh estimate 679 3
         zh estimate 679 0.5
         zh estimate 679 clear  # Remove estimate"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # Get the issue ID
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            estimate {
                value
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title old_estimate
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')
    old_estimate=$(echo "$issue_response" | jq -r '.data.issueByInfo.estimate.value // "none"')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    # Handle clear/remove
    local estimate_value
    if [[ "$points" == "clear" ]] || [[ "$points" == "remove" ]] || [[ "$points" == "none" ]]; then
        estimate_value="null"
    else
        if ! [[ "$points" =~ ^[0-9]*\.?[0-9]+$ ]]; then
            error "Invalid estimate: $points (use a number or 'clear')"
        fi
        estimate_value="$points"
    fi

    info "Setting estimate for issue #${issue_num}..."

    local mutation='
    mutation($input: SetEstimateInput!) {
        setEstimate(input: $input) {
            issue {
                id
                estimate {
                    value
                }
            }
        }
    }'

    local mutation_vars
    if [[ "$estimate_value" == "null" ]]; then
        mutation_vars=$(jq -n --arg issue_id "$issue_id" \
            '{input: {issueId: $issue_id, value: null}}')
    else
        mutation_vars=$(jq -n --arg issue_id "$issue_id" --argjson value "$estimate_value" \
            '{input: {issueId: $issue_id, value: $value}}')
    fi

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local new_estimate
    new_estimate=$(echo "$response" | jq -r '.data.setEstimate.issue.estimate.value // "none"')

    echo ""
    success "Updated estimate for #${issue_num}: ${issue_title}"
    echo -e "  ${CYAN}${old_estimate}${NC} → ${GREEN}${new_estimate}${NC} points"
}

cmd_assign() {
    load_config

    local issue_num="${1:-}"
    local username="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$username" ]]; then
        error "Usage: zh assign <issue_number> <github_username>
Example: zh assign 679 daniel-pittman
         zh assign 679 @daniel-pittman"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"
    # Strip @ prefix if present
    username="${username#@}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # Get the issue ID
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            assignees {
                nodes {
                    login
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title current_assignees
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')
    current_assignees=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].login] | join(", ") | if . == "" then "none" else . end')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    # Get workspace ID to look up user
    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get the ZenHub user ID from workspace assignees
    local user_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            assignees {
                nodes {
                    id
                    login
                }
            }
        }
    }'

    local user_vars
    user_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local user_response
    user_response=$(zh_graphql "$user_query" "$user_vars")

    local zh_user_id
    zh_user_id=$(echo "$user_response" | jq -r --arg user "$username" \
        '.data.workspace.assignees.nodes[] | select(.login == $user) | .id // empty')

    if [[ -z "$zh_user_id" ]]; then
        error "User '${username}' not found in workspace. Use 'zh users' to list available users."
    fi

    # Check if user is already assigned
    local already_assigned
    already_assigned=$(echo "$issue_response" | jq -r --arg user "$username" \
        '[.data.issueByInfo.assignees.nodes[].login] | index($user) // empty')

    if [[ -n "$already_assigned" ]]; then
        echo ""
        success "${username} is already assigned to #${issue_num}: ${issue_title}"
        echo -e "  Assignees: ${GREEN}${current_assignees}${NC}"
        return 0
    fi

    info "Assigning ${username} to issue #${issue_num}..."

    local mutation='
    mutation($input: AddAssigneesToIssuesInput!) {
        addAssigneesToIssues(input: $input) {
            successCount
            githubErrors
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg issue_id "$issue_id" --arg user_id "$zh_user_id" \
        '{input: {issueIds: [$issue_id], assigneeIds: [$user_id]}}')

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local success_count
    success_count=$(echo "$response" | jq -r '.data.addAssigneesToIssues.successCount // 0')

    if [[ "$success_count" -eq 0 ]]; then
        local github_errors
        github_errors=$(echo "$response" | jq -r '.data.addAssigneesToIssues.githubErrors // "Unknown error"')
        error "Failed to assign ${username}: ${github_errors}"
    fi

    # Brief delay then re-fetch to get updated assignees list
    sleep 0.5
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")
    local new_assignees
    new_assignees=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].login] | join(", ")')

    echo ""
    success "Assigned ${username} to #${issue_num}: ${issue_title}"
    echo -e "  Assignees: ${GREEN}${new_assignees}${NC}"
}

cmd_unassign() {
    load_config

    local issue_num="${1:-}"
    local username="${2:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh unassign <issue_number> [username]

Examples:
  zh unassign 42 johndoe    # Remove johndoe from issue
  zh unassign 42            # Remove all assignees from issue"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"
    # Strip @ prefix if present (if username provided)
    [[ -n "$username" ]] && username="${username#@}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # Get the issue ID and current assignees
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            assignees {
                nodes {
                    id
                    login
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    # Determine which assignees to remove
    local assignee_ids_to_remove
    if [[ -n "$username" ]]; then
        # Remove specific user - get their ID from the issue's assignees
        assignee_ids_to_remove=$(echo "$issue_response" | jq -r --arg user "$username" \
            '[.data.issueByInfo.assignees.nodes[] | select(.login == $user) | .id]')

        if [[ "$assignee_ids_to_remove" == "[]" ]]; then
            error "User '${username}' is not assigned to issue #${issue_num}"
        fi

        info "Removing ${username} from issue #${issue_num}..."
    else
        # Remove all assignees
        assignee_ids_to_remove=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].id]')

        if [[ "$assignee_ids_to_remove" == "[]" ]]; then
            error "Issue #${issue_num} has no assignees"
        fi

        info "Removing all assignees from issue #${issue_num}..."
    fi

    local mutation='
    mutation($input: RemoveAssigneesFromIssuesInput!) {
        removeAssigneesFromIssues(input: $input) {
            successCount
            githubErrors
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg issue_id "$issue_id" --argjson assignee_ids "$assignee_ids_to_remove" \
        '{input: {issueIds: [$issue_id], assigneeIds: $assignee_ids}}')

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local success_count
    success_count=$(echo "$response" | jq -r '.data.removeAssigneesFromIssues.successCount // 0')

    if [[ "$success_count" -eq 0 ]]; then
        local github_errors
        github_errors=$(echo "$response" | jq -r '.data.removeAssigneesFromIssues.githubErrors // "Unknown error"')
        error "Failed to remove assignee(s): ${github_errors}"
    fi

    # Brief delay then re-fetch to get updated assignees list
    sleep 0.5
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")
    local remaining_assignees
    remaining_assignees=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].login] | join(", ") | if . == "" then "none" else . end')

    echo ""
    if [[ -n "$username" ]]; then
        success "Removed ${username} from #${issue_num}: ${issue_title}"
    else
        success "Removed all assignees from #${issue_num}: ${issue_title}"
    fi
    echo -e "  Assignees: ${CYAN}${remaining_assignees}${NC}"
}

cmd_comment() {
    load_config

    local issue_num=""
    local body=""
    local body_file=""
    local from_stdin=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--file)
                body_file="$2"
                shift 2
                ;;
            --stdin)
                from_stdin=true
                shift
                ;;
            -m|--message)
                body="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$issue_num" ]]; then
                    issue_num="$1"
                elif [[ -z "$body" ]]; then
                    body="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh comment <issue_number> [message] [options]

Add a comment to an issue.

Options:
  -m, --message <text>  Comment text (inline)
  -f, --file <path>     Read comment from file
  --stdin               Read comment from stdin

Examples:
  zh comment 42 \"This is fixed in PR #123\"
  zh comment 42 -m \"Quick update: still investigating\"
  zh comment 42 -f ./detailed-notes.md
  echo \"Automated comment\" | zh comment 42 --stdin"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    # Read body from file if specified
    if [[ -n "$body_file" ]]; then
        if [[ ! -f "$body_file" ]]; then
            error "File not found: $body_file"
        fi
        body=$(cat "$body_file")
    fi

    # Read body from stdin if specified
    if [[ "$from_stdin" == true ]]; then
        body=$(cat)
    fi

    if [[ -z "$body" ]]; then
        error "Comment body is required. Use -m, -f, --stdin, or provide text as argument."
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Adding comment to issue #${issue_num}..."

    # Use GitHub CLI to add comments (comments are a GitHub feature, synced to ZenHub)
    if ! echo "$body" | gh issue comment "$issue_num" --repo "$owner_repo" --body-file - 2>/dev/null; then
        error "Failed to add comment. Issue #${issue_num} may not exist."
    fi

    echo ""
    success "Added comment to #${issue_num}"
    # Show preview of comment (first 100 chars)
    local preview
    preview=$(echo "$body" | head -c 100)
    if [[ ${#body} -gt 100 ]]; then
        preview="${preview}..."
    fi
    echo -e "  Comment: ${preview}"
}

cmd_attach() {
    local issue_num="${1:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh attach <issue_number>

Opens the issue in your browser so you can drag-and-drop attachments.

Note: GitHub's API does not support uploading attachments programmatically.
      File attachments must be added through the web interface.

Example: zh attach 42"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local url="https://github.com/${owner_repo}/issues/${issue_num}"

    echo ""
    info "Opening issue #${issue_num} in browser for attachment upload..."
    echo ""
    echo -e "  ${YELLOW}Note:${NC} GitHub's API does not support file uploads to issues."
    echo -e "  Drag and drop files into the comment box in your browser."
    echo ""

    # Open in browser (works on macOS and Linux)
    if command -v open &> /dev/null; then
        open "$url"
    elif command -v xdg-open &> /dev/null; then
        xdg-open "$url"
    else
        echo -e "  URL: ${CYAN}${url}${NC}"
        echo "  (Could not auto-open browser)"
    fi
}

cmd_close() {
    load_config

    local issue_num="${1:-}"
    local comment="${2:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh close <issue_number> [comment]

Close an issue (moves it to Closed pipeline in ZenHub).

Examples:
  zh close 42
  zh close 42 \"Completed in PR #99\""
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    # Get issue title first for confirmation message
    local issue_title
    issue_title=$(gh issue view "$issue_num" --repo "$owner_repo" --json title --jq '.title' 2>/dev/null)

    if [[ -z "$issue_title" ]]; then
        error "Issue #${issue_num} not found"
    fi

    info "Closing issue #${issue_num}..."

    # Close the issue via GitHub CLI (syncs to ZenHub automatically)
    if [[ -n "$comment" ]]; then
        # Add comment and close
        gh issue close "$issue_num" --repo "$owner_repo" --comment "$comment" 2>/dev/null
    else
        gh issue close "$issue_num" --repo "$owner_repo" 2>/dev/null
    fi

    if [[ $? -eq 0 ]]; then
        echo ""
        success "Closed #${issue_num}: ${issue_title}"
        if [[ -n "$comment" ]]; then
            echo -e "  Comment: ${comment}"
        fi
        echo -e "  ${CYAN}Note:${NC} Issue moved to Closed pipeline in ZenHub"
    else
        error "Failed to close issue #${issue_num}"
    fi
}

