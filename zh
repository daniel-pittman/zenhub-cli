#!/bin/bash
#
# zh - ZenHub CLI Tool
#
# A command-line interface for ZenHub API operations.
# Wraps the ZenHub GraphQL API to manage issues, pipelines, and workspaces.
#
# Repository: https://github.com/acme-user/zenhub-cli
# License: MIT
#

set -euo pipefail

# Read version from VERSION file (same directory as script, resolving symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VERSION=$(cat "${SCRIPT_DIR}/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "unknown")

# =============================================================================
# Configuration
# =============================================================================

CONFIG_DIR="${HOME}/.config/zh"
CONFIG_FILE="${CONFIG_DIR}/config"
ZENHUB_API="https://api.zenhub.com/public/graphql"

# Colors for output
#
# v1.9.2 round-3 (PR #27) finding #9: honor the NO_COLOR informal
# standard (https://no-color.org). When NO_COLOR is set to ANY
# non-empty value, suppress every ANSI escape so the output is plain
# text. Tests can set NO_COLOR=1 to skip the ANSI-strip helper, and
# users on terminals that don't render ANSI (or who prefer plain
# output) get a clean rendering. The variable is checked once at
# script-load time; we don't re-evaluate per-call.
if [[ -n "${NO_COLOR:-}" ]]; then
    RED=''
    GREEN=''
    YELLOW=''
    BLUE=''
    CYAN=''
    NC=''
    BOLD=''
else
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    NC='\033[0m' # No Color
    BOLD='\033[1m'
fi

# =============================================================================
# Helper Functions
# =============================================================================

# v1.9.2 round-7 finding #13: switch error/warn/info/success from
# `echo -e` to `printf '%s\n'`. The `echo -e` form interprets
# escape sequences (\n, \t, \\) inside the payload, which silently
# corrupts ZenHub-side error messages that contain `jq -c` JSON
# strings: a value like `"permission denied:\nrepo is archived"`
# rendered as a real newline, fragmenting the single-line warn
# across multiple stderr lines and invalidating the embedded JSON
# for downstream parsers. The round-6 #4 partial-applied warn at
# zh:3569 embeds `jq -c` output via `${gh_errors}`, so this fix
# matters most there but it's correct everywhere.
#
# The color escapes themselves stay (they're literal ANSI bytes in
# the format string, not in the payload, so printf passes them
# through unchanged). Trailing `\n` is added explicitly.
error() {
    printf "${RED}Error:${NC} %s\n" "$1" >&2
    exit 1
}

warn() {
    printf "${YELLOW}Warning:${NC} %s\n" "$1" >&2
}

info() {
    printf "${BLUE}Info:${NC} %s\n" "$1"
}

success() {
    printf "${GREEN}\xe2\x9c\x93${NC} %s\n" "$1"
}

# v1.9.2 round-3 (PR #27) finding #5: build a single-line cause-hint
# from a possibly-multi-line stderr capture so post-create envelope
# warns can include the actionable detail (e.g. ZenHub's
# "Error: ZenHub API error:\n  Hint: regenerate at https://...")
# rather than only the header line. Collapses internal newlines to
# "; ", strips ANSI escapes, drops empty lines, caps at 240 chars
# with a trailing "..." marker if truncated. Reads from a file path
# (which may be /dev/null per the round-1 #2 fail-soft fallback);
# returns empty when the file is missing / empty / /dev/null.
#
# v1.9.2 round-4 (PR #27) finding #12: prefer the coreutils pipeline
# (sed + awk + paste + tr) but fall back to a pure-bash implementation
# when any of those tools are missing (alpine/busybox containers).
# Without the fallback, the pipeline returns empty and every warn
# silently lost its cause clause with no diagnostic. The pure-bash
# variant strips CSI ANSI escapes, OSC sequences (round-4 finding
# #15), drops empty lines, joins with "; ", and caps at 240 chars
# using only built-in parameter expansion.
zh_cause_hint() {
    local _f="$1"
    if [[ -z "$_f" || "$_f" == "/dev/null" || ! -s "$_f" ]]; then
        printf '%s' ""
        return 0
    fi
    local _raw=""
    # Detect coreutils availability up-front; if any are missing,
    # use the pure-bash fallback. `command -v` returns 0 iff the
    # tool resolves on PATH.
    if command -v sed >/dev/null 2>&1 \
        && command -v awk >/dev/null 2>&1 \
        && command -v paste >/dev/null 2>&1 \
        && command -v tr >/dev/null 2>&1; then
        _raw=$(LC_ALL=C sed -E $'s/\033\\[[0-9;]*[a-zA-Z]//g; s/\033\\][^\007\033]*(\007|\033\\\\)//g' "$_f" 2>/dev/null \
            | awk 'NF>0' \
            | paste -sd';' - \
            | tr -s ';' \
            | sed -e 's/;/; /g' 2>/dev/null || true)
    else
        # Pure-bash fallback: read the file line-by-line, strip
        # ANSI escape sequences via regex match-and-replace, drop
        # empties, join with "; ". Uses pre-computed sentinel
        # strings instead of inline $'\033' interpolation so the
        # bash 3.2 / 4.x regex parser doesn't choke.
        #
        # v1.9.4 round-2 finding #3: pin LC_ALL=C for the duration
        # of this fallback so `${str:i:1}` extracts BYTES, not
        # characters. Otherwise a UTF-8 locale (the modern default)
        # makes the 8-bit C1 byte comparisons below silently fail
        # against the canonical UTF-8 encoding (0xC2 0x9C / 0xC2
        # 0x9B), leaving OSC garbage in the output. `local` here
        # scopes the change to this function call; restoration is
        # automatic on return.
        local LC_ALL=C
        local _esc _csi_re _osc_bel_re
        _esc=$'\033'
        # CSI: ESC [ <params/intermediates> <final-byte>
        _csi_re="${_esc}\[[0-9;]*[a-zA-Z]"
        # OSC, BEL-terminated:    ESC ] <text> BEL
        _osc_bel_re="${_esc}\][^"$'\007\033'"]*"$'\007'
        # v1.9.3 pattern-sweep finding #7: handle ESC-backslash (ST)
        # terminators too. The coreutils sed branch above strips both
        # BEL and ST via `(\007|\033\\\\)`; the pure-bash branch was
        # BEL-only.
        #
        # We deliberately don't run a parallel regex for ST. The naive
        # approach is `_osc_st_re="${_esc}\][^${_esc}]*${_esc}\\\\"` and
        # then `${_line//${BASH_REMATCH[0]}/}` to substitute, but bash's
        # pattern-substitution operator treats the search string as a
        # glob pattern, where a trailing backslash (the ST terminator's
        # second byte) swallows the closing `/` of the substitution.
        # The substitution silently no-ops, the regex re-matches the
        # same span, and the loop spins forever.
        #
        # Instead, normalize ESC-backslash to BEL via a literal-scalar
        # `${var/from/to}` substitution (no glob involved, no infinite
        # loop), then let the existing BEL OSC regex catch every OSC.
        # The normalization is harmless when no OSC is present — a bare
        # ESC `\` outside an OSC is not a thing terminals emit. ESC
        # alone is excluded from the OSC body class so the BEL regex
        # still terminates at the right byte.
        local _bel _st8 _csi8
        _bel=$'\007'
        # v1.9.4 finding #3 / LOW #3: also normalize 8-bit C1 controls.
        # 0x9C is the 8-bit ST (string terminator); fold to BEL so the
        # BEL OSC regex catches OSC sequences that used the single-byte
        # ST. 0x9B is the 8-bit CSI introducer; expand to ESC `[` so
        # the existing CSI regex picks it up. The function-scoped
        # `local LC_ALL=C` above ensures byte-wise comparison, so this
        # also catches the UTF-8-encoded form (0xC2 0x9C / 0xC2 0x9B):
        # the leading 0xC2 falls through to the else-branch (no match
        # for ESC/8-bit C1), then the trailing 0x9C/0x9B byte matches
        # on the next pass.
        _st8=$'\234'
        _csi8=$'\233'
        local _line _out=""
        while IFS= read -r _line || [[ -n "$_line" ]]; do
            # Normalize OSC ST → OSC BEL FIRST. We can't use
            # `${_line//<ESC-backslash>/<BEL>}` because bash's pattern
            # substitution treats the trailing backslash in the search
            # pattern as a glob escape (the backslash needs a next
            # char to escape; there isn't one, so the substitution
            # silently no-ops). A character-by-character scan is slow
            # but correct on a line; this branch only runs on tiny
            # error files, never on the GraphQL response stream.
            local _norm="" _len="${#_line}" _i=0 _ch _next
            while (( _i < _len )); do
                _ch="${_line:_i:1}"
                _next="${_line:_i+1:1}"
                if [[ "$_ch" == "$_esc" && "$_next" == "\\" ]]; then
                    # 7-bit ST: ESC \ → BEL
                    _norm+="$_bel"
                    _i=$((_i + 2))
                elif [[ "$_ch" == "$_st8" ]]; then
                    # 8-bit ST (0x9C) → BEL
                    _norm+="$_bel"
                    _i=$((_i + 1))
                elif [[ "$_ch" == "$_csi8" ]]; then
                    # 8-bit CSI (0x9B) → ESC [
                    _norm+="${_esc}["
                    _i=$((_i + 1))
                else
                    _norm+="$_ch"
                    _i=$((_i + 1))
                fi
            done
            _line="$_norm"
            # Strip every CSI sequence on this line.
            while [[ "$_line" =~ $_csi_re ]]; do
                _line="${_line//${BASH_REMATCH[0]}/}"
            done
            # Strip every BEL-terminated OSC sequence (now covers
            # ST-terminated too, thanks to the normalization above).
            while [[ "$_line" =~ $_osc_bel_re ]]; do
                _line="${_line//${BASH_REMATCH[0]}/}"
            done
            # Skip empty / whitespace-only lines.
            local _trimmed="${_line#"${_line%%[![:space:]]*}"}"
            if [[ -n "$_trimmed" ]]; then
                if [[ -n "$_out" ]]; then
                    _out="${_out}; ${_line}"
                else
                    _out="$_line"
                fi
            fi
        done < "$_f"
        _raw="$_out"
    fi
    if [[ ${#_raw} -gt 240 ]]; then
        _raw="${_raw:0:237}..."
    fi
    printf '%s' "$_raw"
}

# Lowercase a string portably. bash 3.2 (macOS default, and a CI matrix
# target) has no ${var,,} parameter expansion, so use tr.
to_lower() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# Load configuration
load_config() {
    # Round-6 #14: precedence must be env > config (to match Python
    # `resolve_context` round-3 #11 SPEC).
    #
    # The pre-fix idiom `source $CONFIG_FILE` overwrote any
    # environment-set values with config-file values — config-wins.
    # That was inverted vs the Python side, which read env first
    # and only fell back to config. A user with `export ZH_REPO=
    # acme/widgets` and a stale config file would see Python pick
    # `acme/widgets` while bash silently used the config value.
    #
    # Fix: source each config file in a SUBSHELL, capture the
    # variables we care about, then apply them only when the
    # caller's env is unset. The subshell isolates the source so
    # the file's full set of side effects doesn't leak into our
    # process. Quoted-value handling stays correct because bash
    # parses the file with its own rules in the subshell.
    local config_zh_token=""
    local config_zh_rest_token=""
    local config_zh_repo=""
    local config_zh_workspace=""

    _load_config_from() {
        local src="$1"
        [[ -f "$src" ]] || return 0
        # Subshell isolates the source: unset our target vars first
        # so the subshell starts with them empty, then source the
        # file and emit each captured value on its OWN line so the
        # outer reader can pick them by line position. `read -r` with
        # tab-delimited values collapses consecutive tabs (empty
        # fields disappear), so line-per-value is the robust shape.
        local sourced
        sourced=$(
            unset ZH_TOKEN ZH_REST_TOKEN ZH_REPO ZH_WORKSPACE
            # shellcheck disable=SC1090
            source "$src" 2>/dev/null
            printf '%s\n' \
                "${ZH_TOKEN:-}" \
                "${ZH_REST_TOKEN:-}" \
                "${ZH_REPO:-}" \
                "${ZH_WORKSPACE:-}"
        )
        # Parse line-by-line; empty lines stay as empty values.
        local line idx=0
        local t="" r="" p="" w=""
        while IFS= read -r line; do
            case "$idx" in
                0) t="$line" ;;
                1) r="$line" ;;
                2) p="$line" ;;
                3) w="$line" ;;
            esac
            idx=$((idx + 1))
        done <<< "$sourced"
        # First-wins across the two config sources: only set if not
        # already set by an earlier source (or env, see apply step).
        [[ -z "$config_zh_token" ]] && config_zh_token="$t"
        [[ -z "$config_zh_rest_token" ]] && config_zh_rest_token="$r"
        [[ -z "$config_zh_repo" ]] && config_zh_repo="$p"
        [[ -z "$config_zh_workspace" ]] && config_zh_workspace="$w"
    }

    _load_config_from "$CONFIG_FILE"
    _load_config_from ".env"
    unset -f _load_config_from

    # Apply config values ONLY where the corresponding env var is
    # unset/empty. Env wins; config is fallback. Matches Python's
    # resolve_context precedence.
    ZH_TOKEN="${ZH_TOKEN:-$config_zh_token}"
    ZH_REST_TOKEN="${ZH_REST_TOKEN:-$config_zh_rest_token}"
    ZH_REPO="${ZH_REPO:-$config_zh_repo}"
    ZH_WORKSPACE="${ZH_WORKSPACE:-$config_zh_workspace}"

    # Validate required config
    if [[ -z "${ZH_TOKEN:-}" ]]; then
        error "ZH_TOKEN not set. Create ${CONFIG_FILE} with:
  ZH_TOKEN=your_zenhub_api_token

Get your token at: https://app.zenhub.com/settings/tokens"
    fi
}

# Make a GraphQL request to ZenHub API
zh_graphql() {
    local query="$1"
    local variables="${2:-{\}}"

    # Build request body using jq to ensure proper JSON formatting
    local body
    body=$(jq -n --arg q "$query" --argjson v "$variables" '{query: $q, variables: $v}')

    local response
    response=$(curl -s -X POST "$ZENHUB_API" \
        -H "Authorization: Bearer ${ZH_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "$body")

    # Check for errors
    if echo "$response" | jq -e '.errors' > /dev/null 2>&1; then
        local error_msg error_kind
        error_msg=$(echo "$response" | jq -r '.errors[0].message // "Unknown error"')
        # NO_ACCESS (e.g. on createIssue against a repo object) is the mutation-
        # side face of a lapsed ZenHub<->GitHub authorization. Inspect the error
        # type / extensions.code / message and append the re-auth hint so the
        # mutation path gets the same guidance as the empty-result resolution
        # path (see zh_repo_access_hint).
        error_kind=$(echo "$response" | jq -r '[.errors[0].type, .errors[0].extensions.code] | map(select(. != null)) | join(" ")')
        # Match ZenHub's actual access-denied vocabulary (NO_ACCESS type, and the
        # "no access" / "not authorized" human-message variants). Kept narrow on
        # purpose: broader synonyms like "forbidden"/"unauthorized" would risk
        # appending the re-auth hint to unrelated errors. Explicit else (not a
        # fall-through to a second `error`) so the control flow doesn't silently
        # depend on error() calling exit.
        if printf '%s %s' "$error_kind" "$error_msg" | grep -qiE 'NO_ACCESS|no access|not authorized'; then
            error "ZenHub API error: $error_msg
This usually means ZenHub's GitHub authorization has lapsed (its GitHub access
expires separately from your zh token). Sign in at https://app.zenhub.com and
re-authorize GitHub if prompted, then retry."
        else
            error "ZenHub API error: $error_msg"
        fi
    fi

    echo "$response"
}

# Get GitHub owner/repo. Resolution order:
#   1. ZH_REPO_OVERRIDE — set by the `-r` / `--repo` global flag
#   2. ZH_REPO — config-file value (read by load_config)
#   3. git remote get-url origin in the current directory
#
# The first two paths are explicit; the third is the historical default
# and is what every command does when nothing's overridden.
get_repo_info() {
    if [[ -n "${ZH_REPO_OVERRIDE:-}" ]]; then
        echo "$ZH_REPO_OVERRIDE"
        return
    fi
    if [[ -n "${ZH_REPO:-}" ]]; then
        echo "$ZH_REPO"
        return
    fi

    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null || echo "")

    if [[ -z "$remote_url" ]]; then
        error "No repository specified.

Either:
  - Use -r owner/repo (or --repo) to target a specific repository
  - Set ZH_REPO=owner/repo in ${CONFIG_FILE}
  - Run from within a git repository with a GitHub remote (origin)

For multi-workspace repos, also see -w / --workspace and ZH_WORKSPACE."
    fi

    # Parse owner/repo from various URL formats.
    #
    # Repo names on GitHub can contain dots (e.g. "docs.github.io",
    # "my.tool", "internal.docs"). The repo group used to be `[^/.]+`
    # which silently failed to match those.
    #
    # The prefix anchors strictly on either `git@github.com:` (ssh)
    # or `https?://github.com/` (https) — the two forms `git remote
    # get-url origin` emits in practice. Schemes like `ssh://`,
    # `git://`, and `git+ssh://` are accepted by some git clients
    # but not produced by `git remote get-url`, so we reject them to
    # keep this regex in lockstep with the Python parsers in
    # `zh_api._GH_URL_RE` and `similarity._GITHUB_URL_RE`.
    # Round-4 finding #5.
    #
    # Bash extended regex doesn't support non-greedy quantifiers, so
    # we trim any trailing `/` from the URL up-front and match
    # greedily on `[^/]+`, then strip the optional `.git` suffix
    # from the captured repo name.
    local trimmed_url="${remote_url%/}"
    if [[ "$trimmed_url" =~ ^(git@github\.com:|https?://github\.com/)([^/]+)/([^/]+)$ ]]; then
        local owner="${BASH_REMATCH[2]}"
        local repo="${BASH_REMATCH[3]}"
        repo="${repo%.git}"
        echo "${owner}/${repo}"
    else
        error "Could not parse GitHub repository from remote URL: $remote_url"
    fi
}

# Resolve a repo's numeric GitHub ID via the gh CLI, failing closed.
#
# `gh api repos/<owner>/<repo> --jq '.id'` does not fail safely on its own.
# On an HTTP error (404 for a missing or private repo, an auth failure, or a
# misbehaving gh shim that prints an error body but exits 0) the result is
# either a non-zero exit or a non-numeric JSON error body, e.g.
# {"message":"Not Found",...,"status":"404"}. A bare `[[ -z "$gh_id" ]]`
# guard misses the body case; under `set -e` the non-zero case dies silently
# at the bare assignment. The body then flows into the GraphQL
# `$ghIds: [Int!]!` variable and surfaces as a baffling
# "could not coerce value {...} to Int" cascade followed by a misleading
# "No workspace found".
#
# This helper checks BOTH the gh exit status and that the result is purely
# numeric. On success it prints the id and returns 0. On failure it prints
# the (collapsed, one-line) gh diagnostic to stderr and returns 1, so callers
# can abort with a clean actionable message or degrade. The `|| gh_status=$?`
# capture keeps the inner failure from tripping `set -e` before we inspect it.
resolve_gh_repo_id() {
    local owner_repo="$1"
    local gh_id gh_status=0
    gh_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>&1) || gh_status=$?

    if (( gh_status != 0 )) || [[ ! "$gh_id" =~ ^[0-9]+$ ]]; then
        local detail
        detail=$(printf '%s' "$gh_id" | tr '\n' ' ')
        printf "  GitHub lookup for '%s' failed: %s\n" "$owner_repo" "$detail" >&2
        return 1
    fi

    printf '%s' "$gh_id"
}

# Get ZenHub repository ID from owner/repo (uses gh CLI to get GitHub ID first)
# Shared, actionable guidance for the "ZenHub can't see a repo we know exists on
# GitHub" failure. The tell is "reads work but repo access fails": ZenHub
# authenticates ZH_TOKEN and lists workspaces, yet returns no repo object for the
# repo. ZenHub reaches GitHub repo objects through a GitHub OAuth/App grant that
# expires INDEPENDENTLY of ZH_TOKEN, so the usual cause is a lapsed ZenHub<->GitHub
# authorization (re-auth on the website), not a bad token or a missing repo. The
# other cause is the repo simply not being attached to a workspace. Both surface
# identically (empty repositoriesByGhId), so we name both and lead with the auth
# one. Echoes a multi-line message for error() to frame.
zh_repo_access_hint() {
    local owner_repo="$1" gh_id="${2:-}"
    local idnote=""
    [[ -n "$gh_id" ]] && idnote=" (GitHub ID: ${gh_id})"
    cat <<EOF
ZenHub can't see this repository for your account: ${owner_repo}${idnote}.
The token authenticated and workspaces are readable, but ZenHub returned no repo
object. This is usually one of:
  1. ZenHub's GitHub authorization has lapsed. Sign in at https://app.zenhub.com
     and re-authorize GitHub if prompted, then retry. ZenHub's GitHub access
     expires separately from your zh token, so reads keep working while repo
     access is denied -- easy to miss.
  2. The repo isn't connected to a ZenHub workspace. Add it in ZenHub ->
     workspace -> Manage Repositories.
EOF
}

get_repo_id() {
    local owner_repo="$1"

    # First get the GitHub repo ID using gh CLI
    local gh_id
    gh_id=$(resolve_gh_repo_id "$owner_repo") || \
        error "Could not get GitHub repo ID for: $owner_repo (check the repo path and 'gh auth status')"

    # Now query ZenHub with the GitHub ID
    local query='
    query($ghIds: [Int!]!) {
        repositoriesByGhId(ghIds: $ghIds) {
            id
            ghId
            name
        }
    }'

    local variables
    variables=$(jq -n --argjson gh_id "$gh_id" '{ghIds: [$gh_id]}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local repo_id
    repo_id=$(echo "$response" | jq -r '.data.repositoriesByGhId[0].id // empty')

    if [[ -z "$repo_id" ]]; then
        error "$(zh_repo_access_hint "$owner_repo" "$gh_id")"
    fi

    echo "$repo_id"
}

# Hard cap on workspace-list pagination iterations. 50 pages × 50 nodes
# = 2,500 workspaces, vastly more than any plausible per-repo count, so
# the cap only ever fires on a server-side stuck-cursor bug.
ZH_WORKSPACE_PAGINATION_CAP=50

# Walk every page of `workspacesConnection` for a repo and emit a single
# JSON array of `{id, name}` nodes on stdout. Same stuck-cursor +
# iteration-cap defenses as the sub-issue and sprint walkers.
#
# Argument: gh_id (GitHub numeric repo id).
zh_workspaces_fetch_all() {
    local gh_id="$1"

    local query='
    query($ghIds: [Int!]!, $after: String) {
        repositoriesByGhId(ghIds: $ghIds) {
            id
            workspacesConnection(first: 50, after: $after) {
                pageInfo { hasNextPage endCursor }
                nodes { id name }
            }
        }
    }'

    local cursor="null"
    local last_cursor=""
    local iterations=0
    local all_nodes="[]"

    while :; do
        iterations=$((iterations + 1))
        if [[ "$iterations" -gt "$ZH_WORKSPACE_PAGINATION_CAP" ]]; then
            warn "Workspace pagination iteration cap (${ZH_WORKSPACE_PAGINATION_CAP}) reached"
            break
        fi

        local variables
        variables=$(jq -n --argjson gh_id "$gh_id" --argjson after "$cursor" \
            '{ghIds: [$gh_id], after: $after}')

        local response
        response=$(zh_graphql "$query" "$variables")

        # Round-6 #8: `select(. != null)` strips null page entries
        # at aggregation, matching the other three walkers.
        local page_nodes
        page_nodes=$(echo "$response" | jq -c '[(.data.repositoriesByGhId[0].workspacesConnection.nodes // [])[] | select(. != null)]')
        all_nodes=$(jq -n --argjson a "$all_nodes" --argjson b "$page_nodes" '$a + $b')

        local has_next end_cursor
        has_next=$(echo "$response" | jq -r '.data.repositoriesByGhId[0].workspacesConnection.pageInfo.hasNextPage // false')
        end_cursor=$(echo "$response" | jq -r '.data.repositoriesByGhId[0].workspacesConnection.pageInfo.endCursor // ""')

        if [[ "$has_next" != "true" ]]; then
            break
        fi
        if [[ -z "$end_cursor" || "$end_cursor" == "$last_cursor" ]]; then
            warn "Workspace pagination cursor not advancing — bailing"
            break
        fi
        last_cursor="$end_cursor"
        cursor=$(jq -n --arg c "$end_cursor" '$c')
    done

    echo "$all_nodes"
}

# Get workspace ID for a repository (using GitHub ID).
#
# Workspace selection precedence:
#   1. ZH_WORKSPACE_NAME (set by `-w` / `--workspace` global flag) — exact
#      case-insensitive match against the workspace name. Errors with the
#      list of available workspaces if there's no match.
#   2. ZH_WORKSPACE (config-file value) — same resolution as above.
#   3. First workspace returned by the API (historical default).
#
# (1) and (2) are merged via ZH_WORKSPACE_NAME -> ZH_WORKSPACE precedence
# below. The Python `resolve_context` follows the same chain.
#
# Walks every page of `workspacesConnection` via zh_workspaces_fetch_all
# so name resolution finds workspaces beyond position 50.
get_workspace_id() {
    local owner_repo="$1"

    # Get GitHub repo ID
    local gh_id
    gh_id=$(resolve_gh_repo_id "$owner_repo") || \
        error "Could not get GitHub repo ID for: $owner_repo (check the repo path and 'gh auth status')"

    local workspace_nodes
    workspace_nodes=$(zh_workspaces_fetch_all "$gh_id")

    local node_count
    node_count=$(echo "$workspace_nodes" | jq 'length')

    if [[ "$node_count" -eq 0 ]]; then
        error "$(zh_repo_access_hint "$owner_repo" "$gh_id")"
    fi

    # Resolve effective name: flag-set override beats env/config value
    local effective_name="${ZH_WORKSPACE_NAME:-${ZH_WORKSPACE:-}}"

    local workspace_id
    if [[ -n "$effective_name" ]]; then
        # Exact match on the workspace name (case-insensitive).
        workspace_id=$(echo "$workspace_nodes" | jq -r --arg name "$effective_name" \
            '[.[] | select((.name | ascii_downcase) == ($name | ascii_downcase))] | .[0].id // empty')

        if [[ -z "$workspace_id" ]]; then
            echo -e "${RED}Error:${NC} Workspace '${effective_name}' not found for ${owner_repo}." >&2
            echo "" >&2
            echo "Available workspaces:" >&2
            echo "$workspace_nodes" | jq -r '.[] | "  - \(.name)"' >&2
            exit 1
        fi
    else
        # Default: first workspace. Historical behaviour, preserved when
        # neither -w nor ZH_WORKSPACE is set.
        workspace_id=$(echo "$workspace_nodes" | jq -r '.[0].id // empty')
        if [[ -z "$workspace_id" ]]; then
            error "No workspace found for this repository"
        fi
    fi

    echo "$workspace_id"
}

# Build ZenHub URL for an issue
# Format: https://app.zenhub.com/workspaces/<workspace-id>/issues/gh/<owner>/<repo>/<issue-number>
build_zenhub_url() {
    local workspace_id="$1"
    local owner_repo="$2"
    local issue_num="$3"

    echo "https://app.zenhub.com/workspaces/${workspace_id}/issues/gh/${owner_repo}/${issue_num}"
}

# =============================================================================
# Issue-type resolution (v1.9.0: the modern model)
# =============================================================================
#
# ZenHub removed Legacy Epics and ZenhubEpics in June 2025 ("Epics and Projects
# have been replaced with Issue Types and Sub-Issues"). The current model is a
# 5-level Issue Type hierarchy wired with Sub-Issues. assignableIssueTypes
# returns a union of GithubIssueType and ZenhubIssueType, each carrying a single
# `id` that both CreateIssueInput.issueTypeId and
# ChangeIssueTypeOfIssuesInput.issueTypeId accept. That unified id is the reason
# one mechanism covers every level (Initiative/Project/Epic are ZenhubIssueType;
# Bug/Feature/Task are GithubIssueType; Sub-task is ZenhubIssueType): the caller
# never has to branch on the subtype.

# Fetch the workspace's assignable issue types as a JSON array of
# {typename, id, name, level, disposition, isEnabled} on stdout.
# Echoes "[]" if none are returned. Data-driven: no per-noun hardcoding.
zh_fetch_issue_types() {
    local owner_repo="$1"
    local workspace_id="$2"

    # Soft path: this feeds issue-type discovery, so degrade to "[]" rather
    # than aborting. 2>/dev/null suppresses the helper's diagnostic to keep
    # discovery quiet (the caller surfaces its own error if types are needed).
    local gh_id
    gh_id=$(resolve_gh_repo_id "$owner_repo" 2>/dev/null) || {
        echo "[]"
        return
    }

    local query='
    query($ghIds: [Int!]!, $workspaceId: ID!) {
        repositoriesByGhId(ghIds: $ghIds) {
            assignableIssueTypes(workspaceId: $workspaceId, first: 100) {
                nodes {
                    __typename
                    ... on GithubIssueType { id name level disposition isEnabled }
                    ... on ZenhubIssueType { id name level disposition isEnabled }
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --argjson gh_id "$gh_id" --arg workspace_id "$workspace_id" \
        '{ghIds: [$gh_id], workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    # v1.9.1 item #4: belt-and-suspenders filter on isEnabled. The
    # endpoint is named `assignableIssueTypes` and field-level inspection
    # suggests the server already excludes disabled types, but
    # zh_hierarchy_require_type's error message tells the user to
    # "Enable it... then retry". If the server ever begins returning
    # disabled-but-assignable rows (or a future workspace surfaces one),
    # the "enable it" branch needs a way to actually fire. Keep the
    # filter client-side so the contract on isEnabled is explicit
    # regardless of server behavior.
    echo "$response" | jq -c '
        [ (.data.repositoriesByGhId[0].assignableIssueTypes.nodes // [])[]
          | select(.isEnabled != false)
          | {typename: .__typename, id: .id, name: .name, level: .level,
             disposition: .disposition, isEnabled: .isEnabled} ]'
}

# Resolve an issue-type name (case-insensitive) to its id, using a pre-fetched
# types JSON array. Echoes the id, or empty if no match. Pure jq, no network.
#
# v1.9.1 item #4: zh_fetch_issue_types now filters out isEnabled=false rows
# before this lookup ever runs, so a disabled type cannot resolve to an id
# from here. The previous absence of that filter meant the "enable it in
# workspace settings" hint in zh_hierarchy_require_type could not fire even
# when the server returned a disabled row.
zh_issue_type_id_from() {
    local types_json="$1"
    local name="$2"
    echo "$types_json" | jq -r --arg name "$name" \
        'map(select((.name | ascii_downcase) == ($name | ascii_downcase))) | .[0].id // empty'
}

# Build a human-friendly "Available types: ..." list from a types JSON array.
zh_issue_type_names_from() {
    local types_json="$1"
    echo "$types_json" | jq -r '[.[].name] | join(", ")'
}

# Fetch the workspace's configured priorities as a JSON array of {id, name,
# color} on stdout. Echoes "[]" if none are configured.
zh_fetch_priorities() {
    local workspace_id="$1"

    local query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            prioritiesConnection {
                nodes { id name color }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    echo "$response" | jq -c '.data.workspace.prioritiesConnection.nodes // []'
}

# Resolve a priority name (case-insensitive) to its id, using a pre-fetched
# priorities JSON array. Echoes the id, or empty if no match.
zh_priority_id_from() {
    local priorities_json="$1"
    local name="$2"
    echo "$priorities_json" | jq -r --arg name "$name" \
        'map(select((.name | ascii_downcase) == ($name | ascii_downcase))) | .[0].id // empty'
}

