main() {
    local command="${1:-help}"
    shift || true

    case "$command" in
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "zh version ${VERSION}"
            ;;
        issue|i|show)
            cmd_issue "$@"
            ;;
        mine|my)
            cmd_mine "$@"
            ;;
        board|b|overview)
            cmd_board "$@"
            ;;
        pipeline|pipe|col)
            cmd_pipeline "$@"
            ;;
        pipelines|pipes|p)
            cmd_pipelines "$@"
            ;;
        workspaces|ws)
            cmd_workspaces "$@"
            ;;
        move|mv|m)
            cmd_move "$@"
            ;;
        reorder|order|pos)
            cmd_reorder "$@"
            ;;
        estimate|est|points)
            cmd_estimate "$@"
            ;;
        assign)
            cmd_assign "$@"
            ;;
        unassign)
            cmd_unassign "$@"
            ;;
        create|new)
            cmd_create "$@"
            ;;
        comment|c)
            cmd_comment "$@"
            ;;
        attach)
            cmd_attach "$@"
            ;;
        types)
            cmd_types "$@"
            ;;
        labels)
            cmd_labels "$@"
            ;;
        users)
            cmd_users "$@"
            ;;
        block|blocked-by|depends)
            cmd_block "$@"
            ;;
        unblock)
            cmd_unblock "$@"
            ;;
        priority|prio)
            cmd_priority "$@"
            ;;
        *)
            error "Unknown command: $command

Run 'zh help' for usage information."
            ;;
    esac
}

main "$@"
