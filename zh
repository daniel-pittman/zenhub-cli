        workspace(id: $workspaceId) {
            assignees {
                nodes {
                    id
                    login
                }
            }
        }
    }'

    local user_vars
    user_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local user_response
    user_response=$(zh_graphql "$user_query" "$user_vars")

    local zh_user_id
    zh_user_id=$(echo "$user_response" | jq -r --arg user "$username" \
        '.data.workspace.assignees.nodes[] | select(.login == $user) | .id // empty')

    if [[ -z "$zh_user_id" ]]; then
        error "User '${username}' not found in workspace. Use 'zh users' to list available users."
    fi

    # Check if user is already assigned
    local already_assigned
    already_assigned=$(echo "$issue_response" | jq -r --arg user "$username" \
        '[.data.issueByInfo.assignees.nodes[].login] | index($user) // empty')

    if [[ -n "$already_assigned" ]]; then
        echo ""
        success "${username} is already assigned to #${issue_num}: ${issue_title}"
        echo -e "  Assignees: ${GREEN}${current_assignees}${NC}"
        return 0
    fi

    info "Assigning ${username} to issue #${issue_num}..."

    local mutation='
    mutation($input: AddAssigneesToIssuesInput!) {
        addAssigneesToIssues(input: $input) {
            successCount
            githubErrors
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg issue_id "$issue_id" --arg user_id "$zh_user_id" \
        '{input: {issueIds: [$issue_id], assigneeIds: [$user_id]}}')

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local success_count
    success_count=$(echo "$response" | jq -r '.data.addAssigneesToIssues.successCount // 0')

    if [[ "$success_count" -eq 0 ]]; then
        local github_errors
        github_errors=$(echo "$response" | jq -r '.data.addAssigneesToIssues.githubErrors // "Unknown error"')
        error "Failed to assign ${username}: ${github_errors}"
    fi

    # Brief delay then re-fetch to get updated assignees list
    sleep 0.5
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")
    local new_assignees
    new_assignees=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].login] | join(", ")')

    echo ""
    success "Assigned ${username} to #${issue_num}: ${issue_title}"
    echo -e "  Assignees: ${GREEN}${new_assignees}${NC}"
}

cmd_unassign() {
    load_config

    local issue_num="${1:-}"
    local username="${2:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh unassign <issue_number> [username]

Examples:
  zh unassign 42 johndoe    # Remove johndoe from issue
  zh unassign 42            # Remove all assignees from issue"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"
    # Strip @ prefix if present (if username provided)
    [[ -n "$username" ]] && username="${username#@}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # Get the issue ID and current assignees
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            assignees {
                nodes {
                    id
                    login
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    # Determine which assignees to remove
    local assignee_ids_to_remove
    if [[ -n "$username" ]]; then
        # Remove specific user - get their ID from the issue's assignees
        assignee_ids_to_remove=$(echo "$issue_response" | jq -r --arg user "$username" \
            '[.data.issueByInfo.assignees.nodes[] | select(.login == $user) | .id]')

        if [[ "$assignee_ids_to_remove" == "[]" ]]; then
            error "User '${username}' is not assigned to issue #${issue_num}"
        fi

        info "Removing ${username} from issue #${issue_num}..."
    else
        # Remove all assignees
        assignee_ids_to_remove=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].id]')

        if [[ "$assignee_ids_to_remove" == "[]" ]]; then
            error "Issue #${issue_num} has no assignees"
        fi

        info "Removing all assignees from issue #${issue_num}..."
    fi

    local mutation='
    mutation($input: RemoveAssigneesFromIssuesInput!) {
        removeAssigneesFromIssues(input: $input) {
            successCount
            githubErrors
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg issue_id "$issue_id" --argjson assignee_ids "$assignee_ids_to_remove" \
        '{input: {issueIds: [$issue_id], assigneeIds: $assignee_ids}}')

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local success_count
    success_count=$(echo "$response" | jq -r '.data.removeAssigneesFromIssues.successCount // 0')

    if [[ "$success_count" -eq 0 ]]; then
        local github_errors
        github_errors=$(echo "$response" | jq -r '.data.removeAssigneesFromIssues.githubErrors // "Unknown error"')
        error "Failed to remove assignee(s): ${github_errors}"
    fi

    # Brief delay then re-fetch to get updated assignees list
    sleep 0.5
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")
    local remaining_assignees
    remaining_assignees=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].login] | join(", ") | if . == "" then "none" else . end')

    echo ""
    if [[ -n "$username" ]]; then
        success "Removed ${username} from #${issue_num}: ${issue_title}"
    else
        success "Removed all assignees from #${issue_num}: ${issue_title}"
    fi
    echo -e "  Assignees: ${CYAN}${remaining_assignees}${NC}"
}

cmd_comment() {
    load_config

    local issue_num=""
    local body=""
    local body_file=""
    local from_stdin=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--file)
                body_file="$2"
                shift 2
                ;;
            --stdin)
                from_stdin=true
                shift
                ;;
            -m|--message)
                body="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$issue_num" ]]; then
                    issue_num="$1"
                elif [[ -z "$body" ]]; then
                    body="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh comment <issue_number> [message] [options]

Add a comment to an issue.

Options:
  -m, --message <text>  Comment text (inline)
  -f, --file <path>     Read comment from file
  --stdin               Read comment from stdin

Examples:
  zh comment 42 \"This is fixed in PR #123\"
  zh comment 42 -m \"Quick update: still investigating\"
  zh comment 42 -f ./detailed-notes.md
  echo \"Automated comment\" | zh comment 42 --stdin"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    # Read body from file if specified
    if [[ -n "$body_file" ]]; then
        if [[ ! -f "$body_file" ]]; then
            error "File not found: $body_file"
        fi
        body=$(cat "$body_file")
    fi

    # Read body from stdin if specified
    if [[ "$from_stdin" == true ]]; then
        body=$(cat)
    fi

    if [[ -z "$body" ]]; then
        error "Comment body is required. Use -m, -f, --stdin, or provide text as argument."
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Adding comment to issue #${issue_num}..."

    # Use GitHub CLI to add comments (comments are a GitHub feature, synced to ZenHub)
    if ! echo "$body" | gh issue comment "$issue_num" --repo "$owner_repo" --body-file - 2>/dev/null; then
        error "Failed to add comment. Issue #${issue_num} may not exist."
    fi

    echo ""
    success "Added comment to #${issue_num}"
    # Show preview of comment (first 100 chars)
    local preview
    preview=$(echo "$body" | head -c 100)
    if [[ ${#body} -gt 100 ]]; then
        preview="${preview}..."
    fi
    echo -e "  Comment: ${preview}"
}

cmd_attach() {
    local issue_num="${1:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh attach <issue_number>

Opens the issue in your browser so you can drag-and-drop attachments.

Note: GitHub's API does not support uploading attachments programmatically.
      File attachments must be added through the web interface.

Example: zh attach 42"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local url="https://github.com/${owner_repo}/issues/${issue_num}"

    echo ""
    info "Opening issue #${issue_num} in browser for attachment upload..."
    echo ""
    echo -e "  ${YELLOW}Note:${NC} GitHub's API does not support file uploads to issues."
    echo -e "  Drag and drop files into the comment box in your browser."
    echo ""

    # Open in browser (works on macOS and Linux)
    if command -v open &> /dev/null; then
        open "$url"
    elif command -v xdg-open &> /dev/null; then
        xdg-open "$url"
    else
        echo -e "  URL: ${CYAN}${url}${NC}"
        echo "  (Could not auto-open browser)"
    fi
}

cmd_close() {
    load_config

    local issue_num="${1:-}"
    local comment="${2:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh close <issue_number> [comment]

Close an issue (moves it to Closed pipeline in ZenHub).

Examples:
  zh close 42
  zh close 42 \"Completed in PR #99\""
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    # Get issue title first for confirmation message
    local issue_title
    issue_title=$(gh issue view "$issue_num" --repo "$owner_repo" --json title --jq '.title' 2>/dev/null)

    if [[ -z "$issue_title" ]]; then
        error "Issue #${issue_num} not found"
    fi

    info "Closing issue #${issue_num}..."

    # Close the issue via GitHub CLI (syncs to ZenHub automatically)
    if [[ -n "$comment" ]]; then
        # Add comment and close
        gh issue close "$issue_num" --repo "$owner_repo" --comment "$comment" 2>/dev/null
    else
        gh issue close "$issue_num" --repo "$owner_repo" 2>/dev/null
    fi

    if [[ $? -eq 0 ]]; then
        echo ""
        success "Closed #${issue_num}: ${issue_title}"
        if [[ -n "$comment" ]]; then
            echo -e "  Comment: ${comment}"
        fi
        echo -e "  ${CYAN}Note:${NC} Issue moved to Closed pipeline in ZenHub"
    else
        error "Failed to close issue #${issue_num}"
    fi
}

cmd_reopen() {
    load_config

    local issue_num="${1:-}"

    if [[ -z "$issue_num" ]]; then
