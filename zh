cmd_block() {
    load_config

    local blocked_num="${1:-}"
    local blocking_num="${2:-}"

    if [[ -z "$blocked_num" ]] || [[ -z "$blocking_num" ]]; then
        error "Usage: zh block <blocked_issue> <blocking_issue>

Sets up a dependency: blocked_issue is blocked BY blocking_issue

Example: zh block 123 456
         (Issue #123 is blocked by issue #456 - can't work on 123 until 456 is done)"
    fi

    # Strip # prefix if present
    blocked_num="${blocked_num#\#}"
    blocking_num="${blocking_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    info "Setting #${blocked_num} as blocked by #${blocking_num}..."

    # Get both issue IDs
    local query='
    query($repoId: ID!, $num1: Int!, $num2: Int!) {
        blocked: issueByInfo(repositoryId: $repoId, issueNumber: $num1) {
            id
            title
        }
        blocking: issueByInfo(repositoryId: $repoId, issueNumber: $num2) {
            id
            title
        }
    }'

    local variables
    variables=$(jq -n --arg repo_id "$repo_id" --argjson num1 "$blocked_num" --argjson num2 "$blocking_num" \
        '{repoId: $repo_id, num1: $num1, num2: $num2}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local blocked_id blocked_title blocking_id blocking_title
    blocked_id=$(echo "$response" | jq -r '.data.blocked.id // empty')
    blocked_title=$(echo "$response" | jq -r '.data.blocked.title')
    blocking_id=$(echo "$response" | jq -r '.data.blocking.id // empty')
    blocking_title=$(echo "$response" | jq -r '.data.blocking.title')

    if [[ -z "$blocked_id" ]]; then
        error "Issue #${blocked_num} not found"
    fi
    if [[ -z "$blocking_id" ]]; then
        error "Issue #${blocking_num} not found"
    fi

    # Create the blockage
    local mutation='
    mutation($input: CreateBlockageInput!) {
        createBlockage(input: $input) {
            blockage {
                id
            }
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg blocked_id "$blocked_id" --arg blocking_id "$blocking_id" \
        '{input: {blocked: {id: $blocked_id, type: "ISSUE"}, blocking: {id: $blocking_id, type: "ISSUE"}}}')

    local result
    result=$(zh_graphql "$mutation" "$mutation_vars")

    local blockage_id
    blockage_id=$(echo "$result" | jq -r '.data.createBlockage.blockage.id // empty')

    if [[ -z "$blockage_id" ]]; then
        error "Failed to create blockage"
    fi

    echo ""
    success "Created dependency"
    echo -e "  #${blocked_num} (${blocked_title})"
    echo -e "  ${YELLOW}is blocked by${NC}"
    echo -e "  #${blocking_num} (${blocking_title})"
}

# NOTE: The ZenHub GraphQL API does not have a deleteBlockage mutation.
# This command uses the deprecated REST API which requires a separate token.
# The REST API is scheduled for deprecation - request GraphQL support at:
# https://community.zenhub.com/
cmd_unblock() {
    load_config

    local blocked_num="${1:-}"
    local blocking_num="${2:-}"

    if [[ -z "$blocked_num" ]] || [[ -z "$blocking_num" ]]; then
        error "Usage: zh unblock <blocked_issue> <blocking_issue>

Removes a dependency: blocked_issue is no longer blocked by blocking_issue

Example: zh unblock 123 456
         (Issue #123 is no longer blocked by issue #456)

NOTE: This command requires a REST API token (different from the GraphQL token).
      Generate one at: https://app.zenhub.com/dashboard/tokens
      Add to config as: ZH_REST_TOKEN=your_token_here"
    fi

    # Strip # prefix if present
    blocked_num="${blocked_num#\#}"
    blocking_num="${blocking_num#\#}"

    # Check for REST API token
    local rest_token="${ZH_REST_TOKEN:-}"
    if [[ -z "$rest_token" ]] && [[ -f "$CONFIG_FILE" ]]; then
        rest_token=$(grep -E '^ZH_REST_TOKEN=' "$CONFIG_FILE" 2>/dev/null | cut -d= -f2)
    fi

    if [[ -z "$rest_token" ]]; then
        error "REST API token required for unblock command.

The ZenHub GraphQL API does not support removing dependencies.
This command uses the deprecated REST API which requires a separate token.

To set up:
1. Generate a token at: https://app.zenhub.com/dashboard/tokens
2. Add to ~/.config/zh/config:
   ZH_REST_TOKEN=your_token_here

NOTE: Consider requesting GraphQL support for this feature at:
      https://community.zenhub.com/"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    # Get GitHub repo ID (REST API uses GitHub IDs, not ZenHub IDs)
    local gh_repo_id
    gh_repo_id=$(resolve_gh_repo_id "$owner_repo") || \
        error "Could not get GitHub repo ID for: $owner_repo (check the repo path and 'gh auth status')"

    info "Removing dependency: #${blocked_num} blocked by #${blocking_num}..."

    # REST API DELETE endpoint - uses JSON body with blocking/blocked objects
    # Note: endpoint is /p1/dependencies (not /p1/repositories/:id/dependencies)
    local response
    local http_code
    http_code=$(curl -s -o /tmp/zh_unblock_response.json -w "%{http_code}" \
        -X DELETE \
        "https://api.zenhub.com/p1/dependencies" \
        -H "X-Authentication-Token: ${rest_token}" \
        -H "Content-Type: application/json" \
        -d "{\"blocking\":{\"repo_id\":${gh_repo_id},\"issue_number\":${blocking_num}},\"blocked\":{\"repo_id\":${gh_repo_id},\"issue_number\":${blocked_num}}}")

    response=$(cat /tmp/zh_unblock_response.json 2>/dev/null)
    rm -f /tmp/zh_unblock_response.json

    if [[ "$http_code" == "204" ]] || [[ "$http_code" == "200" ]]; then
        echo ""
        success "Removed dependency"
        echo -e "  #${blocked_num} is no longer blocked by #${blocking_num}"
    elif [[ "$http_code" == "401" ]]; then
        error "Authentication failed. Check your ZH_REST_TOKEN.
Generate a new token at: https://app.zenhub.com/dashboard/tokens"
    elif [[ "$http_code" == "404" ]]; then
        error "Dependency not found between #${blocked_num} and #${blocking_num}"
    else
        error "Failed to remove dependency (HTTP ${http_code}): ${response}"
    fi
}

cmd_priority() {
    load_config

    local issue_num="${1:-}"
    local priority_action="${2:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh priority <issue_number> [<name>|clear]

Priorities are workspace-defined (not a fixed high/medium/low set). The name is
matched case-insensitively against the workspace's configured priorities.
Discover them with 'zh priorities'.

Examples:
  zh priority 42 \"High priority\"   # Set a configured priority by name
  zh priority 42 clear              # Remove priority
  zh priority 42                    # Show current priority"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get the issue and its pipeline issue ID
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!, $workspaceId: ID!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            pipelineIssue(workspaceId: $workspaceId) {
                id
                priority {
                    id
                    name
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" --arg workspace_id "$workspace_id" \
        '{repoId: $repo_id, issueNumber: $issue_num, workspaceId: $workspace_id}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_title pipeline_issue_id current_priority
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title // empty')
    pipeline_issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssue.id // empty')
    current_priority=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssue.priority.name // "None"')

    if [[ -z "$issue_title" ]]; then
        error "Issue #${issue_num} not found"
    fi

    if [[ -z "$pipeline_issue_id" ]]; then
        error "Issue #${issue_num} is not in any pipeline"
    fi

    # If no action specified, just show current priority
    if [[ -z "$priority_action" ]]; then
        echo ""
        echo -e "${BOLD}#${issue_num}${NC} ${issue_title}"
        echo -e "  Priority: ${CYAN}${current_priority}${NC}"
        echo ""
        return
    fi

    # Resolve the priority name to an id (G1). Priorities are workspace-defined,
    # so we match the given name case-insensitively against the configured set
    # rather than special-casing "high" and grabbing nodes[0] (the old bug that
    # made "medium"/"low" fire a mutation with an empty id and fail opaquely).
    local priority_id=""
    local is_clear="false"
    if [[ "$priority_action" == "clear" ]] || [[ "$priority_action" == "none" ]] || [[ "$priority_action" == "remove" ]]; then
        is_clear="true"
    else
        local priorities_json
        priorities_json=$(zh_fetch_priorities "$workspace_id")

        priority_id=$(zh_priority_id_from "$priorities_json" "$priority_action")

        if [[ -z "$priority_id" ]]; then
            local available
            available=$(echo "$priorities_json" | jq -r 'if length == 0 then "(none configured)" else ([.[].name] | join(", ")) end')
            error "No priority named '${priority_action}' in this workspace. Available: ${available}. Add it in ZenHub workspace settings if you want to use it (discover with 'zh priorities')."
        fi
    fi

    info "Setting priority for issue #${issue_num}..."

    # Set priority
    local mutation='
    mutation($input: SetPriorityOnPipelineIssuesInput!) {
        setPriorityOnPipelineIssues(input: $input) {
            pipelineIssues {
                id
                priority {
                    name
                }
            }
        }
    }'

    local mutation_vars
    if [[ "$is_clear" == "true" ]]; then
        mutation_vars=$(jq -n --arg pipeline_issue_id "$pipeline_issue_id" \
            '{input: {pipelineIssueIds: [$pipeline_issue_id], priorityId: null}}')
    else
        mutation_vars=$(jq -n --arg pipeline_issue_id "$pipeline_issue_id" --arg priority_id "$priority_id" \
            '{input: {pipelineIssueIds: [$pipeline_issue_id], priorityId: $priority_id}}')
    fi

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local new_priority
    new_priority=$(echo "$response" | jq -r '.data.setPriorityOnPipelineIssues.pipelineIssues[0].priority.name // "None"')

    echo ""
    success "Updated priority for #${issue_num}: ${issue_title}"
    echo -e "  ${CYAN}${current_priority}${NC} -> ${GREEN}${new_priority}${NC}"
}

# G1 companion: list the workspace's configured priorities (name + color).
