    zh epic show 12345
    zh epic create "Auth Service" -d "Build authentication API" -l backend,auth
    zh epic update 12345 -t "Renamed" -d "New body"
    zh epic add 12345 369 370
    zh epic remove 12345 369
    zh epic close 12345
    zh epic reopen 12345

NOTES:
    Epic numbers are the trailing numeric portion of ZenHub's internal IDs
    (stable, workspace-scoped). They are shown by 'zh epic list'.
EOF
            ;;
        *)
            error "Unknown epic subcommand: ${sub}

Run 'zh epic help' for usage information."
            ;;
    esac
}

# =============================================================================
# Main
# =============================================================================

main() {
    # Global flag parsing (peel off `-r` / `--repo` and `-w` /
    # `--workspace` before the subcommand). Config-file defaults are
    # already in the environment via load_config when the subcommand
    # body runs, so we seed the override vars from them here for a
    # uniform consumption point.
    #
    # Precedence (highest first):
    #   1. command-line flag (-r / -w)
    #   2. ZH_REPO / ZH_WORKSPACE env var (also set by load_config from
    #      the config file)
    #   3. git remote / first-workspace inference (in get_repo_info /
    #      get_workspace_id)
    #
    # Note: load_config hasn't run yet at this point — subcommand bodies
    # call it themselves — so ZH_REPO / ZH_WORKSPACE here only reflect
    # the SHELL env, not the config file. The config-file path comes
    # into play later: load_config sources the file, exposing ZH_REPO
    # and ZH_WORKSPACE; get_repo_info / get_workspace_id then read them
    # if ZH_REPO_OVERRIDE / ZH_WORKSPACE_NAME aren't set. So the flag
    # always wins; env wins over config; config wins over inference.
    ZH_REPO_OVERRIDE="${ZH_REPO_OVERRIDE:-}"
    ZH_WORKSPACE_NAME="${ZH_WORKSPACE_NAME:-}"

    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--repo)
                if [[ -z "${2:-}" ]]; then
                    error "Option $1 requires an owner/repo value"
                fi
                ZH_REPO_OVERRIDE="$2"
                shift 2
                ;;
            -w|--workspace)
                if [[ -z "${2:-}" ]]; then
                    error "Option $1 requires a workspace name"
                fi
                ZH_WORKSPACE_NAME="$2"
                shift 2
                ;;
            --)
                shift
                args+=("$@")
                break
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done
    # Export so subshells / piped invocations also see them
    export ZH_REPO_OVERRIDE ZH_WORKSPACE_NAME
    set -- "${args[@]}"

    local command="${1:-help}"
    shift || true

    case "$command" in
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "zh version ${VERSION}"
            ;;
        issue|i|show)
            cmd_issue "$@"
            ;;
        mine|my)
            cmd_mine "$@"
            ;;
        board|b|overview)
            cmd_board "$@"
            ;;
        pipeline|pipe|col)
            cmd_pipeline "$@"
            ;;
        pipelines|pipes|p)
            cmd_pipelines "$@"
            ;;
        workspaces|ws)
            cmd_workspaces "$@"
            ;;
        move|mv|m)
            cmd_move "$@"
            ;;
        reorder|order|pos)
            cmd_reorder "$@"
            ;;
        estimate|est|points)
            cmd_estimate "$@"
            ;;
        assign)
            cmd_assign "$@"
            ;;
        unassign)
            cmd_unassign "$@"
            ;;
        create|new)
            cmd_create "$@"
            ;;
        comment|c)
            cmd_comment "$@"
            ;;
        attach)
            cmd_attach "$@"
            ;;
        close)
            cmd_close "$@"
            ;;
        reopen)
            cmd_reopen "$@"
            ;;
        types)
            cmd_types "$@"
            ;;
        labels)
            cmd_labels "$@"
            ;;
        users)
            cmd_users "$@"
            ;;
        block|blocked-by|depends)
            cmd_block "$@"
            ;;
        unblock)
            cmd_unblock "$@"
            ;;
        priority|prio)
            cmd_priority "$@"
            ;;
        epic|epics)
            cmd_epic "$@"
            ;;
        subissue|subissues|sub|child|children)
            cmd_subissue "$@"
            ;;
        sprints|sp)
            cmd_sprints "$@"
            ;;
        sprint)
            # `zh sprint` with no args defaults to the active sprint.
            if [[ $# -eq 0 ]]; then
                cmd_sprint_current
            else
                local first="$1"
                shift
                case "$first" in
                    current|active)
                        cmd_sprint_current "$@"
                        ;;
                    add)
                        cmd_sprint_add "$@"
                        ;;
                    remove|rm)
                        cmd_sprint_remove "$@"
                        ;;
                    *)
                        cmd_sprint "$first" "$@"
                        ;;
                esac
            fi
            ;;
        sa)
            # Top-level alias for `zh sprint add` (per @jeremiahrose's PR #2)
            cmd_sprint_add "$@"
            ;;
        sr)
            # Top-level alias for `zh sprint remove`
            cmd_sprint_remove "$@"
            ;;
        *)
            error "Unknown command: $command

Run 'zh help' for usage information."
            ;;
    esac
}

main "$@"
