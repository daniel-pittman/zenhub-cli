#!/bin/bash
#
# zh - ZenHub CLI Tool
#
# A command-line interface for ZenHub API operations.
# Wraps the ZenHub GraphQL API to manage issues, pipelines, and workspaces.
#
# Repository: https://github.com/daniel-pittman/zenhub-cli
# License: MIT
#

set -euo pipefail

# Read version from VERSION file (same directory as script, resolving symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VERSION=$(cat "${SCRIPT_DIR}/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "unknown")

# =============================================================================
# Configuration
# =============================================================================

CONFIG_DIR="${HOME}/.config/zh"
CONFIG_FILE="${CONFIG_DIR}/config"
ZENHUB_API="https://api.zenhub.com/public/graphql"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# =============================================================================
# Helper Functions
# =============================================================================

error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}Warning:${NC} $1" >&2
}

info() {
    echo -e "${BLUE}Info:${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

# Load configuration
load_config() {
    # Check for config file
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi

    # Check for local .env file
    if [[ -f ".env" ]]; then
        # shellcheck source=/dev/null
        source ".env"
    fi

    # Validate required config
    if [[ -z "${ZH_TOKEN:-}" ]]; then
        error "ZH_TOKEN not set. Create ${CONFIG_FILE} with:
  ZH_TOKEN=your_zenhub_api_token

Get your token at: https://app.zenhub.com/settings/tokens"
    fi
}

# Make a GraphQL request to ZenHub API
zh_graphql() {
    local query="$1"
    local variables="${2:-{\}}"

    # Build request body using jq to ensure proper JSON formatting
    local body
    body=$(jq -n --arg q "$query" --argjson v "$variables" '{query: $q, variables: $v}')

    local response
    response=$(curl -s -X POST "$ZENHUB_API" \
        -H "Authorization: Bearer ${ZH_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "$body")

    # Check for errors
    if echo "$response" | jq -e '.errors' > /dev/null 2>&1; then
        local error_msg
        error_msg=$(echo "$response" | jq -r '.errors[0].message // "Unknown error"')
        error "ZenHub API error: $error_msg"
    fi

    echo "$response"
}

# Get GitHub repo info from current directory
get_repo_info() {
    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null || echo "")

    if [[ -z "$remote_url" ]]; then
        error "Not in a git repository with a GitHub remote.

This command must be run from within a git repository that:
  1. Has a GitHub remote configured (origin)
  2. Is connected to a ZenHub workspace

To fix:
  - cd into your project directory
  - Ensure 'git remote -v' shows a GitHub URL"
    fi

    # Parse owner/repo from various URL formats
    local repo_path
    if [[ "$remote_url" =~ github\.com[:/]([^/]+)/([^/.]+) ]]; then
        echo "${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    else
        error "Could not parse GitHub repository from remote URL: $remote_url"
    fi
}

# Get ZenHub repository ID from owner/repo (uses gh CLI to get GitHub ID first)
get_repo_id() {
    local owner_repo="$1"

    # First get the GitHub repo ID using gh CLI
    local gh_id
    gh_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>/dev/null)

    if [[ -z "$gh_id" ]]; then
        error "Could not get GitHub repo ID for: $owner_repo (is gh CLI authenticated?)"
    fi

    # Now query ZenHub with the GitHub ID
    local query='
    query($ghIds: [Int!]!) {
        repositoriesByGhId(ghIds: $ghIds) {
            id
            ghId
            name
        }
    }'

    local variables
    variables=$(jq -n --argjson gh_id "$gh_id" '{ghIds: [$gh_id]}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local repo_id
    repo_id=$(echo "$response" | jq -r '.data.repositoriesByGhId[0].id // empty')

    if [[ -z "$repo_id" ]]; then
        error "Repository not found in ZenHub: $owner_repo (GitHub ID: $gh_id)"
    fi

    echo "$repo_id"
}

# Get workspace ID for a repository (using GitHub ID)
get_workspace_id() {
    local owner_repo="$1"

    # Get GitHub repo ID
    local gh_id
    gh_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>/dev/null)

    if [[ -z "$gh_id" ]]; then
        error "Could not get GitHub repo ID for: $owner_repo"
    fi

    local query='
    query($ghIds: [Int!]!) {
        repositoriesByGhId(ghIds: $ghIds) {
            id
            name
            workspacesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --argjson gh_id "$gh_id" '{ghIds: [$gh_id]}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local workspace_id
    local workspace_nodes
    workspace_nodes=$(echo "$response" | jq -c '.data.repositoriesByGhId[0].workspacesConnection.nodes')

    local node_count
    node_count=$(echo "$workspace_nodes" | jq 'length')

    if [[ "$node_count" -eq 0 ]]; then
        error "No workspace found for this repository"
    fi

    if [[ -n "${ZH_WORKSPACE_NAME:-}" ]]; then
        # Find workspace by name (case-insensitive)
        workspace_id=$(echo "$workspace_nodes" | jq -r --arg name "$ZH_WORKSPACE_NAME" \
            '[.[] | select((.name | ascii_downcase) == ($name | ascii_downcase))] | .[0].id // empty')

        if [[ -z "$workspace_id" ]]; then
            echo -e "${RED}Error:${NC} Workspace '${ZH_WORKSPACE_NAME}' not found." >&2
            echo "" >&2
            echo "Available workspaces:" >&2
            echo "$workspace_nodes" | jq -r '.[] | "  - \(.name)"' >&2
            exit 1
        fi
    else
        # Default to first workspace
        workspace_id=$(echo "$workspace_nodes" | jq -r '.[0].id // empty')
    fi

    echo "$workspace_id"
}

# Build ZenHub URL for an issue
# Format: https://app.zenhub.com/workspaces/<workspace-id>/issues/gh/<owner>/<repo>/<issue-number>
build_zenhub_url() {
    local workspace_id="$1"
    local owner_repo="$2"
    local issue_num="$3"

    echo "https://app.zenhub.com/workspaces/${workspace_id}/issues/gh/${owner_repo}/${issue_num}"
}

