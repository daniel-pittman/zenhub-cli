cmd_create() {
    load_config

    local title=""
    local body=""
    local body_file=""
    local issue_type=""
    local labels=""
    local assignee=""
    local pipeline=""
    local estimate=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--type)
                issue_type="$2"
                shift 2
                ;;
            -l|--label|--labels)
                labels="$2"
                shift 2
                ;;
            -a|--assign|--assignee)
                assignee="$2"
                shift 2
                ;;
            -p|--pipeline)
                pipeline="$2"
                shift 2
                ;;
            -e|--estimate)
                estimate="$2"
                shift 2
                ;;
            -b|--body)
                body="$2"
                shift 2
                ;;
            -f|--file|--body-file)
                body_file="$2"
                shift 2
                ;;
            --stdin)
                body=$(cat)
                shift
                ;;
            *)
                if [[ -z "$title" ]]; then
                    title="$1"
                fi
                shift
                ;;
        esac
    done

    # Read body from file if specified
    if [[ -n "$body_file" ]]; then
        if [[ -f "$body_file" ]]; then
            body=$(cat "$body_file")
        else
            error "Body file not found: $body_file"
        fi
    fi

    if [[ -z "$title" ]]; then
        error "Usage: zh create <title> [options]

Options:
  -t, --type <type>       Issue type (Task, Bug, Feature, etc.)
  -l, --labels <labels>   Comma-separated labels
  -a, --assignee <user>   GitHub username to assign
  -p, --pipeline <name>   Pipeline to place issue in
  -e, --estimate <pts>    Story points estimate
  -b, --body <text>       Issue body/description (short)
  -f, --file <path>       Read body from file (for longer descriptions)
  --stdin                 Read body from stdin

Examples:
  zh create \"Fix login bug\" -t Bug -l \"priority:high\"
  zh create \"Add dark mode\" -t Feature -a daniel-pittman -e 5
  zh create \"Research OAuth options\" -t Spike -p \"TO DO\""
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    info "Creating issue: ${title}..."

    # Build the create mutation variables
    local create_vars
    create_vars=$(jq -n --arg repo_id "$repo_id" --arg title "$title" \
        '{input: {repositoryId: $repo_id, title: $title}}')

    # Add body if provided
    if [[ -n "$body" ]]; then
        create_vars=$(echo "$create_vars" | jq --arg body "$body" '.input.body = $body')
    fi

    # Add labels if provided (as array of label names)
    if [[ -n "$labels" ]]; then
        local labels_array
        labels_array=$(echo "$labels" | jq -R 'split(",") | map(gsub("^\\s+|\\s+$"; ""))')
        create_vars=$(echo "$create_vars" | jq --argjson labels "$labels_array" '.input.labels = $labels')
    fi

    # Add assignee if provided
    if [[ -n "$assignee" ]]; then
        assignee="${assignee#@}"
        create_vars=$(echo "$create_vars" | jq --arg assignee "$assignee" '.input.assignees = [$assignee]')
    fi

    # Add issue type if provided
    if [[ -n "$issue_type" ]]; then
        # Get GitHub repo ID for issue types query
        local gh_id
        gh_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>/dev/null)

        # Look up issue type ID
        local types_query='
        query($ghIds: [Int!]!) {
            repositoriesByGhId(ghIds: $ghIds) {
                githubIssueTypes {
                    nodes {
                        id
                        name
                    }
                }
            }
        }'

        local types_vars
        types_vars=$(jq -n --argjson gh_id "$gh_id" '{ghIds: [$gh_id]}')

        local types_response
        types_response=$(zh_graphql "$types_query" "$types_vars")

        local type_id
        type_id=$(echo "$types_response" | jq -r --arg name "$issue_type" \
            '.data.repositoriesByGhId[0].githubIssueTypes.nodes[] | select(.name | ascii_downcase == ($name | ascii_downcase)) | .id')

        if [[ -n "$type_id" ]]; then
            create_vars=$(echo "$create_vars" | jq --arg type_id "$type_id" '.input.issueTypeId = $type_id')
        else
            warn "Issue type '${issue_type}' not found, creating without type"
        fi
    fi

    local mutation='
    mutation($input: CreateIssueInput!) {
        createIssue(input: $input) {
            issue {
                id
                number
                title
                htmlUrl
            }
        }
    }'

    local response
    response=$(zh_graphql "$mutation" "$create_vars")

    local new_issue_id new_issue_num new_issue_url
    new_issue_id=$(echo "$response" | jq -r '.data.createIssue.issue.id')
    new_issue_num=$(echo "$response" | jq -r '.data.createIssue.issue.number')
    new_issue_url=$(echo "$response" | jq -r '.data.createIssue.issue.htmlUrl')

    echo ""
    success "Created issue #${new_issue_num}: ${title}"
    echo -e "  URL: ${CYAN}${new_issue_url}${NC}"

    # Set estimate if provided
    if [[ -n "$estimate" ]]; then
        local est_mutation='
        mutation($input: SetEstimateInput!) {
            setEstimate(input: $input) {
                issue { id }
            }
        }'

        local est_vars
        est_vars=$(jq -n --arg issue_id "$new_issue_id" --argjson value "$estimate" \
            '{input: {issueId: $issue_id, value: $value}}')

        zh_graphql "$est_mutation" "$est_vars" > /dev/null
        echo -e "  Estimate: ${GREEN}${estimate}${NC} points"
    fi

    # Move to pipeline if provided
    if [[ -n "$pipeline" ]]; then
        local workspace_id
        workspace_id=$(get_workspace_id "$owner_repo")

        # Get pipeline ID
        local pipelines_query='
        query($workspaceId: ID!) {
            workspace(id: $workspaceId) {
                pipelinesConnection {
                    nodes {
                        id
                        name
                    }
                }
            }
        }'

        local pipelines_vars
        pipelines_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

        local pipelines_response
        pipelines_response=$(zh_graphql "$pipelines_query" "$pipelines_vars")

        local pipeline_id
        pipeline_id=$(echo "$pipelines_response" | jq -r --arg name "$pipeline" \
            '.data.workspace.pipelinesConnection.nodes[] | select((.name | gsub("^\\s+|\\s+$"; "") | ascii_downcase) == ($name | gsub("^\\s+|\\s+$"; "") | ascii_downcase)) | .id')

        if [[ -n "$pipeline_id" ]]; then
            local move_mutation='
            mutation($input: MoveIssueInput!) {
                moveIssue(input: $input) {
                    issue { id }
                }
            }'

            local move_vars
            move_vars=$(jq -n --arg issue_id "$new_issue_id" --arg pipeline_id "$pipeline_id" \
                '{input: {issueId: $issue_id, pipelineId: $pipeline_id, position: 0}}')

            zh_graphql "$move_mutation" "$move_vars" > /dev/null
            echo -e "  Pipeline: ${GREEN}${pipeline}${NC}"
        else
            warn "Pipeline '${pipeline}' not found"
        fi
    fi
}

