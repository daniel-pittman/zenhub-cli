cmd_set_type() {
    load_config

    local issue_num="${1:-}"
    local type_name="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$type_name" ]]; then
        error "Usage: zh set-type <issue_number> <type_name>

Set or change the issue type.

Examples:
  zh set-type 42 Epic
  zh set-type 42 Bug
  zh set-type 42 clear    # Remove issue type"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # Get the issue ID
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            issueType {
                name
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title old_type
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')
    old_type=$(echo "$issue_response" | jq -r '.data.issueByInfo.issueType.name // "none"')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    if [[ "$type_name" == "clear" ]] || [[ "$type_name" == "remove" ]] || [[ "$type_name" == "none" ]]; then
        # Clear the issue type
        info "Clearing issue type for #${issue_num}..."

        local mutation='
        mutation($input: UpdateIssueInput!) {
            updateIssue(input: $input) {
                issue {
                    id
                    issueType {
                        name
                    }
                }
            }
        }'

        local mutation_vars
        mutation_vars=$(jq -n --arg issue_id "$issue_id" \
            '{input: {id: $issue_id, patch: {issueTypeId: null}}}')

        zh_graphql "$mutation" "$mutation_vars" > /dev/null

        echo ""
        success "Cleared issue type for #${issue_num}: ${issue_title}"
        echo -e "  ${CYAN}${old_type}${NC} → ${GREEN}none${NC}"
    else
        # Look up issue type ID
        local gh_id
        gh_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>/dev/null)

        local types_query='
        query($ghIds: [Int!]!) {
            repositoriesByGhId(ghIds: $ghIds) {
                githubIssueTypes {
                    nodes {
                        id
                        name
                    }
                }
            }
        }'

        local types_vars
        types_vars=$(jq -n --argjson gh_id "$gh_id" '{ghIds: [$gh_id]}')

        local types_response
        types_response=$(zh_graphql "$types_query" "$types_vars")

        local type_id
        type_id=$(echo "$types_response" | jq -r --arg name "$type_name" \
            '.data.repositoriesByGhId[0].githubIssueTypes.nodes[] | select(.name | ascii_downcase == ($name | ascii_downcase)) | .id')

        if [[ -z "$type_id" ]]; then
            echo -e "${RED}Error:${NC} Issue type '${type_name}' not found." >&2
            echo ""
            echo "Available types:"
            echo "$types_response" | jq -r '.data.repositoriesByGhId[0].githubIssueTypes.nodes[] | "  - \(.name)"'
            exit 1
        fi

        info "Setting issue type for #${issue_num}..."

        local mutation='
        mutation($input: UpdateIssueInput!) {
            updateIssue(input: $input) {
                issue {
                    id
                    issueType {
                        name
                    }
                }
            }
        }'

        local mutation_vars
        mutation_vars=$(jq -n --arg issue_id "$issue_id" --arg type_id "$type_id" \
            '{input: {id: $issue_id, patch: {issueTypeId: $type_id}}}')

        local result
        result=$(zh_graphql "$mutation" "$mutation_vars")

        local new_type
        new_type=$(echo "$result" | jq -r '.data.updateIssue.issue.issueType.name // "none"')

        echo ""
        success "Updated issue type for #${issue_num}: ${issue_title}"
        echo -e "  ${CYAN}${old_type}${NC} → ${GREEN}${new_type}${NC}"
    fi
}

