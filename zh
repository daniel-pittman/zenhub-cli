        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    # Get sprint ID
    local sprints_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            activeSprint {
                id
                name
            }
            sprints(first: 50, filters: {}) {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local sprints_vars
    sprints_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local sprints_response
    sprints_response=$(zh_graphql "$sprints_query" "$sprints_vars")

    local sprint_id sprint_actual_name
    if [[ "$sprint_name" == "current" ]] || [[ "$sprint_name" == "active" ]]; then
        sprint_id=$(echo "$sprints_response" | jq -r '.data.workspace.activeSprint.id // empty')
        sprint_actual_name=$(echo "$sprints_response" | jq -r '.data.workspace.activeSprint.name')
        if [[ -z "$sprint_id" ]]; then
            error "No active sprint found"
        fi
    else
        sprint_id=$(echo "$sprints_response" | jq -r --arg name "$sprint_name" \
            '.data.workspace.sprints.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .id' | head -1)
        sprint_actual_name=$(echo "$sprints_response" | jq -r --arg name "$sprint_name" \
            '.data.workspace.sprints.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .name' | head -1)

        if [[ -z "$sprint_id" ]]; then
            echo -e "${RED}Error:${NC} Sprint '${sprint_name}' not found." >&2
            echo ""
            echo "Available sprints:"
            echo "$sprints_response" | jq -r '.data.workspace.sprints.nodes[] | "  - \(.name)"'
            exit 1
        fi
    fi

    # Remove issue from sprint
    local mutation='
    mutation($issueIds: [ID!]!, $sprintIds: [ID!]!) {
        removeIssuesFromSprints(input: {
            issueIds: $issueIds,
            sprintIds: $sprintIds
        }) {
            clientMutationId
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg issue_id "$issue_id" --arg sprint_id "$sprint_id" \
        '{issueIds: [$issue_id], sprintIds: [$sprint_id]}')

    zh_graphql "$mutation" "$mutation_vars" > /dev/null

    echo ""
    success "Removed #${issue_num} (${issue_title}) from sprint '${sprint_actual_name}'"
}

cmd_priority() {
    load_config

    local issue_num="${1:-}"
    local priority_action="${2:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh priority <issue_number> [high|clear]

Examples:
  zh priority 679 high   # Set high priority
  zh priority 679 clear  # Remove priority
  zh priority 679        # Show current priority"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get the issue and its pipeline issue ID
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!, $workspaceId: ID!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            pipelineIssue(workspaceId: $workspaceId) {
                id
                priority {
                    id
                    name
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" --arg workspace_id "$workspace_id" \
        '{repoId: $repo_id, issueNumber: $issue_num, workspaceId: $workspace_id}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_title pipeline_issue_id current_priority
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title // empty')
    pipeline_issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssue.id // empty')
    current_priority=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssue.priority.name // "None"')

    if [[ -z "$issue_title" ]]; then
        error "Issue #${issue_num} not found"
    fi

    if [[ -z "$pipeline_issue_id" ]]; then
        error "Issue #${issue_num} is not in any pipeline"
    fi

    # If no action specified, just show current priority
    if [[ -z "$priority_action" ]]; then
        echo ""
        echo -e "${BOLD}#${issue_num}${NC} ${issue_title}"
        echo -e "  Priority: ${CYAN}${current_priority}${NC}"
        echo ""
        return
    fi

    # Get priority ID (if setting to high)
    local priority_id=""
    if [[ "$priority_action" == "high" ]]; then
        # Get the high priority ID from workspace
        local priorities_query='
        query($workspaceId: ID!) {
            workspace(id: $workspaceId) {
                prioritiesConnection {
                    nodes {
                        id
                        name
                    }
                }
            }
        }'

        local priorities_vars
        priorities_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

        local priorities_response
        priorities_response=$(zh_graphql "$priorities_query" "$priorities_vars")

        priority_id=$(echo "$priorities_response" | jq -r '.data.workspace.prioritiesConnection.nodes[0].id // empty')

        if [[ -z "$priority_id" ]]; then
            error "No priority levels configured in this workspace"
        fi
    fi

    info "Setting priority for issue #${issue_num}..."

    # Set priority
    local mutation='
    mutation($input: SetPriorityOnPipelineIssuesInput!) {
        setPriorityOnPipelineIssues(input: $input) {
            pipelineIssues {
                id
                priority {
                    name
                }
            }
        }
    }'

    local mutation_vars
    if [[ "$priority_action" == "clear" ]] || [[ "$priority_action" == "none" ]] || [[ "$priority_action" == "remove" ]]; then
        mutation_vars=$(jq -n --arg pipeline_issue_id "$pipeline_issue_id" \
            '{input: {pipelineIssueIds: [$pipeline_issue_id], priorityId: null}}')
    else
        mutation_vars=$(jq -n --arg pipeline_issue_id "$pipeline_issue_id" --arg priority_id "$priority_id" \
            '{input: {pipelineIssueIds: [$pipeline_issue_id], priorityId: $priority_id}}')
    fi

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local new_priority
    new_priority=$(echo "$response" | jq -r '.data.setPriorityOnPipelineIssues.pipelineIssues[0].priority.name // "None"')

    echo ""
    success "Updated priority for #${issue_num}: ${issue_title}"
    echo -e "  ${CYAN}${current_priority}${NC} → ${GREEN}${new_priority}${NC}"
}

# =============================================================================
# Main
# =============================================================================

main() {
    # Parse global flags before command
    ZH_WORKSPACE_NAME="${ZH_WORKSPACE:-}"

    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -w|--workspace)
                if [[ -z "${2:-}" ]]; then
                    error "Option $1 requires a workspace name"
                fi
                ZH_WORKSPACE_NAME="$2"
                shift 2
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done

    set -- "${args[@]}"

    local command="${1:-help}"
    shift || true

    case "$command" in
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "zh version ${VERSION}"
            ;;
        issue|i|show)
            cmd_issue "$@"
            ;;
        mine|my)
            cmd_mine "$@"
            ;;
        board|b|overview)
            cmd_board "$@"
            ;;
        pipeline|pipe|col)
            cmd_pipeline "$@"
            ;;
        pipelines|pipes|p)
            cmd_pipelines "$@"
            ;;
        workspaces|ws)
            cmd_workspaces "$@"
            ;;
        move|mv|m)
            cmd_move "$@"
            ;;
        reorder|order|pos)
            cmd_reorder "$@"
            ;;
        estimate|est|points)
            cmd_estimate "$@"
            ;;
        assign)
            cmd_assign "$@"
            ;;
        unassign)
            cmd_unassign "$@"
            ;;
        create|new)
            cmd_create "$@"
            ;;
        comment|c)
            cmd_comment "$@"
            ;;
        attach)
            cmd_attach "$@"
            ;;
        close)
            cmd_close "$@"
            ;;
        reopen)
            cmd_reopen "$@"
            ;;
        types)
            cmd_types "$@"
            ;;
        labels)
            cmd_labels "$@"
            ;;
        users)
            cmd_users "$@"
            ;;
        sprints|sp)
            cmd_sprints "$@"
            ;;
        sprint)
            cmd_sprint "$@"
            ;;
        sprint-add|sa)
            cmd_sprint_add "$@"
            ;;
        sprint-remove|sr)
            cmd_sprint_remove "$@"
            ;;
        set-type|type)
            cmd_set_type "$@"
            ;;
        set-parent|add-parent)
            cmd_set_parent "$@"
            ;;
        remove-parent)
            cmd_remove_parent "$@"
            ;;
        children|sub-issues|subs)
            cmd_children "$@"
            ;;
        block|blocked-by|depends)
            cmd_block "$@"
            ;;
        unblock)
            cmd_unblock "$@"
            ;;
        priority|prio)
            cmd_priority "$@"
            ;;
        *)
            error "Unknown command: $command

Run 'zh help' for usage information."
            ;;
    esac
}

main "$@"
