cmd_workspaces() {
    load_config

    local owner_repo
    owner_repo=$(get_repo_info)
    info "Getting workspaces for ${owner_repo}..."

    # Get GitHub repo ID
    local gh_id
    gh_id=$(resolve_gh_repo_id "$owner_repo") || \
        error "Could not get GitHub repo ID for: $owner_repo (check the repo path and 'gh auth status')"

    # Walk every page of workspacesConnection so the listing is complete
    # for repos connected to >50 workspaces. Same walker the resolver
    # uses, so what you see here is what the rest of the CLI sees.
    local workspace_nodes
    workspace_nodes=$(zh_workspaces_fetch_all "$gh_id")

    # Resolve the active workspace per the same precedence get_workspace_id
    # uses, so the listing marks the one the rest of the CLI would target.
    local active_name="${ZH_WORKSPACE_NAME:-${ZH_WORKSPACE:-}}"

    echo ""
    echo -e "${BOLD}Workspaces:${NC}"
    if [[ -n "$active_name" ]]; then
        echo -e "  ${CYAN}(targeting:${NC} ${active_name}${CYAN})${NC}"
    else
        echo -e "  ${CYAN}(targeting: first returned by API)${NC}"
    fi
    echo ""

    echo "$workspace_nodes" | jq -r --arg active "$active_name" '.[] |
        (if ($active != "" and (.name | ascii_downcase) == ($active | ascii_downcase)) then "● " else "  " end) +
        "\(.name)\n    ID: \(.id)\n"'
}

cmd_pipelines() {
    load_config

    local owner_repo
    if [[ -n "${1:-}" ]]; then
        owner_repo="$1"
    else
        owner_repo=$(get_repo_info)
    fi

    info "Getting pipelines for ${owner_repo}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            id
            name
            pipelinesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local workspace_name
    workspace_name=$(echo "$response" | jq -r '.data.workspace.name')

    echo ""
    echo -e "${BOLD}Workspace:${NC} $workspace_name"
    echo -e "${BOLD}Pipelines:${NC}"
    echo ""

    echo "$response" | jq -r '.data.workspace.pipelinesConnection.nodes[] | "  \(.name)"'

    echo ""
    echo -e "${CYAN}Tip:${NC} Use 'zh move <issue#> \"<pipeline name>\"' to move an issue"
}

cmd_move() {
    load_config

    local issue_num="${1:-}"
    local pipeline_name="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$pipeline_name" ]]; then
        error "Usage: zh move <issue_number> <pipeline_name>
Example: zh move 42 \"In Review\""
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Moving issue #${issue_num} to '${pipeline_name}'..."

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get pipeline ID by name
    local pipelines_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            pipelinesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local pipelines_vars
    pipelines_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local pipelines_response
    pipelines_response=$(zh_graphql "$pipelines_query" "$pipelines_vars")

    # Find pipeline by name (case-insensitive, trim whitespace)
    local pipeline_id
    pipeline_id=$(echo "$pipelines_response" | jq -r --arg name "$pipeline_name" \
        '.data.workspace.pipelinesConnection.nodes[] | select((.name | gsub("^\\s+|\\s+$"; "") | ascii_downcase) == ($name | gsub("^\\s+|\\s+$"; "") | ascii_downcase)) | .id')

    if [[ -z "$pipeline_id" ]]; then
        echo -e "${RED}Error:${NC} Pipeline '${pipeline_name}' not found." >&2
        echo ""
        echo "Available pipelines:"
        echo "$pipelines_response" | jq -r '.data.workspace.pipelinesConnection.nodes[] | "  - \(.name)"'
        exit 1
    fi

    # Get the issue ID from ZenHub
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            number
            title
            pipelineIssues {
                nodes {
                    pipeline {
                        name
                    }
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found in ZenHub"
    fi

    local issue_title
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')

    local current_pipeline
    current_pipeline=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssues.nodes[0].pipeline.name // "Unknown"')

    # Move the issue
    local move_mutation='
    mutation($input: MoveIssueInput!) {
        moveIssue(input: $input) {
            issue {
                id
                pipelineIssues {
                    nodes {
                        pipeline {
                            name
                        }
                    }
                }
            }
        }
    }'

    local move_vars
    move_vars=$(jq -n \
        --arg issue_id "$issue_id" \
        --arg pipeline_id "$pipeline_id" \
        '{input: {issueId: $issue_id, pipelineId: $pipeline_id, position: 0}}')

    local move_response
    move_response=$(zh_graphql "$move_mutation" "$move_vars")

    local new_pipeline
    new_pipeline=$(echo "$move_response" | jq -r '.data.moveIssue.issue.pipelineIssues.nodes[0].pipeline.name // empty')

    if [[ -n "$new_pipeline" ]]; then
        echo ""
        success "Moved issue #${issue_num}: ${issue_title}"
        echo -e "  ${CYAN}${current_pipeline}${NC} → ${GREEN}${new_pipeline}${NC}"
    else
        error "Failed to move issue"
    fi
}

cmd_issue() {
    load_config

    local issue_num="${1:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh issue <issue_number>
Example: zh issue 42"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local query='
    query($repoId: ID!, $issueNumber: Int!, $workspaceId: ID!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            number
            title
            body
            state
            htmlUrl
            estimate {
                value
            }
            issueType {
                __typename
                ... on GithubIssueType { name level disposition }
                ... on ZenhubIssueType { name level disposition }
            }
            assignees {
                nodes {
                    login
                    name
                }
            }
            labels {
                nodes {
                    name
                    color
                }
            }
            pipelineIssue(workspaceId: $workspaceId) {
                pipeline {
                    name
                }
                priority {
                    name
                }
            }
            blockingIssues {
                nodes {
                    number
                    title
                }
            }
            blockedIssues {
                nodes {
                    number
                    title
                }
            }
            parentIssue {
                number
                title
            }
            githubChildIssues(first: 1) {
                totalCount
            }
            createdAt
            updatedAt
        }
    }'

    local variables
    variables=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" --arg workspace_id "$workspace_id" \
        '{repoId: $repo_id, issueNumber: $issue_num, workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local issue
    issue=$(echo "$response" | jq '.data.issueByInfo')

    if [[ "$issue" == "null" ]]; then
        error "Issue #${issue_num} not found"
    fi

    local title state pipeline priority estimate assignees labels gh_url zh_url blocking_issues blocked_issues parent_num parent_title child_count type_name type_level
    title=$(echo "$issue" | jq -r '.title')
    state=$(echo "$issue" | jq -r '.state')
    # v1.9.1 round-3 finding #5: read pipeline and priority via the
    # workspace-scoped pipelineIssue field. The pre-fix `pipelineIssues
    # { nodes[0] }` shape was ambiguous for issues that appear in
    # multiple workspaces (it returned API-defined order, which could
    # disagree with the workspace the user targeted via `-w`). The
    # priority mutation path (cmd_priority, cmd_create's post-create
    # priority step) already used the scoped form; now the read does
    # too, so write and read agree.
    pipeline=$(echo "$issue" | jq -r '.pipelineIssue.pipeline.name // "None"')
    # v1.9.1 item #7 (G4): surface the workspace-defined priority alongside
    # state/pipeline/estimate. Priority lives on the pipelineIssue, so it
    # pulls from the same node as `pipeline`; a missing priority renders
    # as "None" so the line is always present (mirrors `Pipeline` and
    # `Estimate`).
    priority=$(echo "$issue" | jq -r '.pipelineIssue.priority.name // "None"')
    estimate=$(echo "$issue" | jq -r '.estimate.value // "—"')
    type_name=$(echo "$issue" | jq -r '.issueType.name // empty')
    type_level=$(echo "$issue" | jq -r '.issueType.level // empty')
    assignees=$(echo "$issue" | jq -r '[.assignees.nodes[].login] | join(", ") | if . == "" then "Unassigned" else . end')
    labels=$(echo "$issue" | jq -r '[.labels.nodes[].name] | join(", ") | if . == "" then "None" else . end')
    gh_url=$(echo "$issue" | jq -r '.htmlUrl')
    zh_url=$(build_zenhub_url "$workspace_id" "$owner_repo" "$issue_num")
    blocking_issues=$(echo "$issue" | jq -r '[.blockingIssues.nodes[] | "#\(.number)"] | join(", ")')
    blocked_issues=$(echo "$issue" | jq -r '[.blockedIssues.nodes[] | "#\(.number)"] | join(", ")')
    parent_num=$(echo "$issue" | jq -r '.parentIssue.number // empty')
    parent_title=$(echo "$issue" | jq -r '.parentIssue.title // ""')
    child_count=$(echo "$issue" | jq -r '.githubChildIssues.totalCount // 0')

    echo ""
    echo -e "${BOLD}#${issue_num}${NC} ${title}"
    echo ""
    echo -e "  ${CYAN}State:${NC}     ${state}"
    if [[ -n "$type_name" ]]; then
        echo -e "  ${CYAN}Type:${NC}      ${type_name} (level ${type_level})"
    fi
    echo -e "  ${CYAN}Pipeline:${NC}  ${pipeline}"
    echo -e "  ${CYAN}Priority:${NC}  ${priority}"
    echo -e "  ${CYAN}Estimate:${NC}  ${estimate}"
    echo -e "  ${CYAN}Assignees:${NC} ${assignees}"
    echo -e "  ${CYAN}Labels:${NC}    ${labels}"
    if [[ -n "$blocking_issues" ]]; then
        echo -e "  ${YELLOW}Blocked by:${NC} ${blocking_issues}"
    fi
    if [[ -n "$blocked_issues" ]]; then
        echo -e "  ${YELLOW}Blocking:${NC}  ${blocked_issues}"
    fi
    if [[ -n "$parent_num" ]]; then
        echo -e "  ${CYAN}Parent:${NC}    #${parent_num} ${parent_title}"
    fi
    if [[ "$child_count" -gt 0 ]]; then
        # Noun-neutral pointer plus a noun-specific one when we can: the
        # issue's actual type drives the second hint, so 'zh project show'
        # gets pointed at 'zh project show' rather than the hardcoded 'zh
        # epic show' the v1.9.0 first cut used (review finding round-3 #9).
        # v1.9.1 item #11: route the display noun through
        # zh_display_noun_for_type so Sub-task renders as the canonical
        # `subtask` rather than the hyphenated form. v1.9.1 round-3 #2:
        # only emit the typed redirect when the issue's actual type has
        # a planning-noun dispatcher arm. Bug / Feature / Task have no
        # dedicated arm, so the noun-specific hint is suppressed for
        # those and the noun-neutral subissue-list hint stands alone.
        local type_lower=""
        if [[ -n "$type_name" ]]; then
            type_lower=$(to_lower "$type_name")
        fi
        case "$type_lower" in
            initiative|project|epic|sub-task|subtask)
                local children_display_noun
                children_display_noun=$(zh_display_noun_for_type "$type_name")
                echo -e "  ${CYAN}Children:${NC}  ${child_count} (see 'zh subissue list ${issue_num}' or 'zh ${children_display_noun} show ${issue_num}')"
                ;;
            *)
                echo -e "  ${CYAN}Children:${NC}  ${child_count} (see 'zh subissue list ${issue_num}')"
                ;;
        esac
    fi
    echo -e "  ${CYAN}ZenHub:${NC}    ${zh_url}"
    echo -e "  ${CYAN}GitHub:${NC}    ${gh_url}"
    echo ""
}

cmd_mine() {
    load_config

    local owner_repo
    owner_repo=$(get_repo_info)

    local target_user=""
    local show_urls=true

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-urls)
                show_urls=false
                shift
                ;;
            -*)
                shift
                ;;
            *)
                if [[ -z "$target_user" ]]; then
                    target_user="$1"
                fi
                shift
                ;;
        esac
    done

    # If no user specified, use current GitHub user
    if [[ -z "$target_user" ]]; then
        target_user=$(gh api user --jq '.login' 2>/dev/null)
        if [[ -z "$target_user" ]]; then
            error "Could not get GitHub username (is gh CLI authenticated?)"
        fi
    else
        # Strip @ prefix if present
        target_user="${target_user#@}"
    fi

    info "Finding issues assigned to ${target_user}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get pipeline IDs first
    local pipelines_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            pipelinesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local pipelines_vars
    pipelines_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local pipelines_response
    pipelines_response=$(zh_graphql "$pipelines_query" "$pipelines_vars")

    local pipelines
    pipelines=$(echo "$pipelines_response" | jq -c '.data.workspace.pipelinesConnection.nodes[]')

    # Collect all issues assigned to user across pipelines
    local all_issues="[]"

    while IFS= read -r pipeline; do
        local pipeline_id pipeline_name
        pipeline_id=$(echo "$pipeline" | jq -r '.id')
        pipeline_name=$(echo "$pipeline" | jq -r '.name')

        # Search issues in this pipeline filtered by assignee
        local query='
        query($pipelineId: ID!, $workspaceId: ID!, $filters: IssueSearchFiltersInput!) {
            searchIssuesByPipeline(
                pipelineId: $pipelineId
                filters: $filters
                first: 50
            ) {
                nodes {
                    number
                    title
                    zenhubUrl(workspaceId: $workspaceId)
                    estimate {
                        value
                    }
                    assignees {
                        nodes {
                            login
                        }
                    }
                    repository {
                        ownerName
                        name
                    }
                }
            }
        }'

        local variables
        variables=$(jq -n --arg pipeline_id "$pipeline_id" --arg workspace_id "$workspace_id" --arg user "$target_user" \
            '{pipelineId: $pipeline_id, workspaceId: $workspace_id, filters: {assignees: {in: [$user]}}}')

        local response
        response=$(zh_graphql "$query" "$variables" 2>/dev/null) || continue

        # Add pipeline name to each issue and merge
        local issues_with_pipeline
        issues_with_pipeline=$(echo "$response" | jq --arg pname "$pipeline_name" \
            '[.data.searchIssuesByPipeline.nodes[] | . + {pipeline: $pname}]')

        all_issues=$(echo "$all_issues" "$issues_with_pipeline" | jq -s 'add')
    done <<< "$pipelines"

    local count
    count=$(echo "$all_issues" | jq 'length')

    echo ""
    echo -e "${BOLD}Issues assigned to ${target_user} (${count}):${NC}"
    echo ""

    if [[ "$count" -eq 0 ]]; then
        echo "  No issues assigned"
    else
        if [[ "$show_urls" == "true" ]]; then
            # Show with URLs and repo info (one issue per block)
            echo "$all_issues" | jq -r '.[] |
                "  #\(.number) │ \(.repository.ownerName)/\(.repository.name) │ \(.pipeline)\n    \(.title)\n    → \(.zenhubUrl)\n"'
        else
            # Compact view without URLs
            echo "$all_issues" | jq -r '.[] |
                "\(.repository.ownerName)/\(.repository.name)" as $repo |
                "  #\(.number | tostring | (" " * (5 - length)) + .) │ \($repo | if length > 20 then .[:17] + "..." else . + (" " * (20 - length)) end) │ \(.pipeline | if length > 15 then .[:12] + "..." else . + (" " * (15 - length)) end) │ \(.title | if length > 35 then .[:32] + "..." else . end)"'
        fi
    fi
}

cmd_board() {
    load_config

    local include_closed=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a)
                include_closed=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting board overview for ${owner_repo}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local query
    if [[ "$include_closed" == "true" ]]; then
        query='
        query($workspaceId: ID!) {
            workspace(id: $workspaceId) {
                name
                pipelinesConnection {
                    nodes {
                        id
                        name
                        issues {
                            totalCount
                        }
                    }
                }
            }
        }'
    else
        query='
        query($workspaceId: ID!) {
            workspace(id: $workspaceId) {
                name
                pipelinesConnection {
                    nodes {
                        id
                        name
                        issues(state: OPEN) {
                            totalCount
                        }
                    }
                }
            }
        }'
    fi

    local variables
    variables=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local workspace_name
    workspace_name=$(echo "$response" | jq -r '.data.workspace.name')

    local total
    total=$(echo "$response" | jq '[.data.workspace.pipelinesConnection.nodes[].issues.totalCount] | add')

    echo ""
    if [[ "$include_closed" == "true" ]]; then
        echo -e "${BOLD}Board: ${workspace_name}${NC} (${total} total issues)"
    else
        echo -e "${BOLD}Board: ${workspace_name}${NC} (${total} open issues)"
    fi
    echo ""

    # Print pipelines with counts as a simple bar chart
    echo "$response" | jq -r '.data.workspace.pipelinesConnection.nodes[] |
        "\(.name)\t\(.issues.totalCount)"' | while IFS=$'\t' read -r name count; do
        # Pad the name
        printf "  %-25s %3d " "$name" "$count"
        # Draw a simple bar
        local bar=""
        for ((i=0; i<count && i<30; i++)); do
            bar+="█"
        done
        if [[ $count -gt 30 ]]; then
            bar+="…"
        fi
        echo -e "${GREEN}${bar}${NC}"
    done

    echo ""
}

cmd_pipeline() {
    load_config

    local pipeline_name=""
    local include_closed=false
    local show_urls=true

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a)
                include_closed=true
                shift
                ;;
            --no-urls)
                show_urls=false
                shift
                ;;
            *)
                if [[ -z "$pipeline_name" ]]; then
                    pipeline_name="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$pipeline_name" ]]; then
        error "Usage: zh pipeline <pipeline_name> [--all] [--no-urls]
Example: zh pipeline \"In Progress\"
         zh pipeline todo --all       # Include closed issues
         zh pipeline todo --no-urls   # Hide URLs"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting issues in '${pipeline_name}'..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # First get the pipeline ID
    local pipelines_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            pipelinesConnection {
                nodes {
                    id
                    name
                }
            }
        }
    }'

    local pipelines_vars
    pipelines_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local pipelines_response
    pipelines_response=$(zh_graphql "$pipelines_query" "$pipelines_vars")

    # Find pipeline by name (case-insensitive, trim whitespace)
    local pipeline_id pipeline_actual_name
    pipeline_id=$(echo "$pipelines_response" | jq -r --arg name "$pipeline_name" \
        '.data.workspace.pipelinesConnection.nodes[] | select((.name | gsub("^\\s+|\\s+$"; "") | ascii_downcase) == ($name | gsub("^\\s+|\\s+$"; "") | ascii_downcase)) | .id')
    pipeline_actual_name=$(echo "$pipelines_response" | jq -r --arg name "$pipeline_name" \
        '.data.workspace.pipelinesConnection.nodes[] | select((.name | gsub("^\\s+|\\s+$"; "") | ascii_downcase) == ($name | gsub("^\\s+|\\s+$"; "") | ascii_downcase)) | .name')

    if [[ -z "$pipeline_id" ]]; then
        echo -e "${RED}Error:${NC} Pipeline '${pipeline_name}' not found." >&2
        echo ""
        echo "Available pipelines:"
        echo "$pipelines_response" | jq -r '.data.workspace.pipelinesConnection.nodes[] | "  - \(.name)"'
        exit 1
    fi

    # Get issues in this pipeline
    local query='
    query($pipelineId: ID!, $workspaceId: ID!, $filters: IssueSearchFiltersInput!) {
        searchIssuesByPipeline(
            pipelineId: $pipelineId
            filters: $filters
            first: 50
        ) {
            nodes {
                number
                title
                state
                zenhubUrl(workspaceId: $workspaceId)
                estimate {
                    value
                }
                assignees {
                    nodes {
                        login
                    }
                }
                repository {
                    ownerName
                    name
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg pipeline_id "$pipeline_id" --arg workspace_id "$workspace_id" \
        '{pipelineId: $pipeline_id, workspaceId: $workspace_id, filters: {}}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local issues
    if [[ "$include_closed" == "true" ]]; then
        issues=$(echo "$response" | jq '.data.searchIssuesByPipeline.nodes')
    else
        issues=$(echo "$response" | jq '[.data.searchIssuesByPipeline.nodes[] | select(.state != "CLOSED")]')
    fi

    local count
    count=$(echo "$issues" | jq 'length')

    local total_count
    total_count=$(echo "$response" | jq '.data.searchIssuesByPipeline.nodes | length')

    local closed_count=$((total_count - count))

    echo ""
    if [[ "$include_closed" == "true" ]]; then
        echo -e "${BOLD}Pipeline: ${pipeline_actual_name}${NC} (${count} issues)"
    else
        if [[ $closed_count -gt 0 ]]; then
            echo -e "${BOLD}Pipeline: ${pipeline_actual_name}${NC} (${count} open, ${closed_count} closed hidden)"
        else
            echo -e "${BOLD}Pipeline: ${pipeline_actual_name}${NC} (${count} issues)"
        fi
    fi
    echo ""

    if [[ "$count" -eq 0 ]]; then
        echo "  No issues in this pipeline"
    else
        if [[ "$show_urls" == "true" ]]; then
            # Show with URLs and repo info
            echo "$issues" | jq -r '.[] |
                "\(.state)" as $state |
                "  #\(.number) │ \(.repository.ownerName)/\(.repository.name) │ \((.estimate.value // "—") | tostring) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end)\n    \(if $state == "CLOSED" then "✓ " else "" end)\(.title)\n    → \(.zenhubUrl)\n"'
        else
            # Compact view without URLs
            echo "$issues" | jq -r '.[] |
                "\(.state)" as $state |
                "  #\(.number | tostring | (" " * (5 - length)) + .) │ \((.estimate.value // "—") | tostring | (" " * (3 - length)) + .) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end | if length > 12 then .[:9] + "..." else . end | . + (" " * (12 - length))) │ \(if $state == "CLOSED" then "✓ " else "  " end)\(.title | if length > 43 then .[:40] + "..." else . end)"'
        fi
    fi
    echo ""
}

cmd_reorder() {
    load_config

    local issue_num="${1:-}"
    local position="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$position" ]]; then
        error "Usage: zh reorder <issue_number> <position>
       zh reorder <issue_number> top
       zh reorder <issue_number> bottom

Examples:
  zh reorder 42 0      # Move to top of pipeline
  zh reorder 42 top    # Move to top
  zh reorder 42 5      # Move to position 5
  zh reorder 42 bottom # Move to bottom"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get the issue's current pipeline
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            number
            title
            pipelineIssues {
                nodes {
                    pipeline {
                        id
                        name
                        issues {
                            totalCount
                        }
                    }
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title pipeline_id pipeline_name total_count
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')
    pipeline_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssues.nodes[0].pipeline.id // empty')
    pipeline_name=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssues.nodes[0].pipeline.name // "Unknown"')
    total_count=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssues.nodes[0].pipeline.issues.totalCount // 0')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found in ZenHub"
    fi

    if [[ -z "$pipeline_id" ]]; then
        error "Issue #${issue_num} is not in any pipeline"
    fi

    # Handle special position keywords
    local pos_int
    case "$position" in
        top|first|0)
            pos_int=0
            ;;
        bottom|last)
            pos_int=$((total_count - 1))
            ;;
        *)
            if [[ "$position" =~ ^[0-9]+$ ]]; then
                pos_int=$position
            else
                error "Invalid position: $position (use a number, 'top', or 'bottom')"
            fi
            ;;
    esac

    info "Moving issue #${issue_num} to position ${pos_int} in '${pipeline_name}'..."

    # Move the issue (to same pipeline but different position)
    local move_mutation='
    mutation($input: MoveIssueInput!) {
        moveIssue(input: $input) {
            issue {
                id
            }
        }
    }'

    local move_vars
    move_vars=$(jq -n \
        --arg issue_id "$issue_id" \
        --arg pipeline_id "$pipeline_id" \
        --argjson position "$pos_int" \
        '{input: {issueId: $issue_id, pipelineId: $pipeline_id, position: $position}}')

    zh_graphql "$move_mutation" "$move_vars" > /dev/null

    echo ""
    success "Reordered issue #${issue_num}: ${issue_title}"
    echo -e "  Now at position ${CYAN}${pos_int}${NC} in ${GREEN}${pipeline_name}${NC}"
}

cmd_estimate() {
    load_config

    local issue_num="${1:-}"
    local points="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$points" ]]; then
        error "Usage: zh estimate <issue_number> <points>
Example: zh estimate 42 3
         zh estimate 42 0.5
         zh estimate 42 clear  # Remove estimate"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # Get the issue ID
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            estimate {
                value
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title old_estimate
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')
    old_estimate=$(echo "$issue_response" | jq -r '.data.issueByInfo.estimate.value // "none"')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    # Handle clear/remove
    local estimate_value
    if [[ "$points" == "clear" ]] || [[ "$points" == "remove" ]] || [[ "$points" == "none" ]]; then
        estimate_value="null"
    else
        if ! [[ "$points" =~ ^[0-9]*\.?[0-9]+$ ]]; then
            error "Invalid estimate: $points (use a number or 'clear')"
        fi
        estimate_value="$points"
    fi

    info "Setting estimate for issue #${issue_num}..."

    local mutation='
    mutation($input: SetEstimateInput!) {
        setEstimate(input: $input) {
            issue {
                id
                estimate {
                    value
                }
            }
        }
    }'

    local mutation_vars
    if [[ "$estimate_value" == "null" ]]; then
        mutation_vars=$(jq -n --arg issue_id "$issue_id" \
            '{input: {issueId: $issue_id, value: null}}')
    else
        mutation_vars=$(jq -n --arg issue_id "$issue_id" --argjson value "$estimate_value" \
            '{input: {issueId: $issue_id, value: $value}}')
    fi

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local new_estimate
    new_estimate=$(echo "$response" | jq -r '.data.setEstimate.issue.estimate.value // "none"')

    echo ""
    success "Updated estimate for #${issue_num}: ${issue_title}"
    echo -e "  ${CYAN}${old_estimate}${NC} → ${GREEN}${new_estimate}${NC} points"
}

cmd_assign() {
    load_config

    local issue_num="${1:-}"
    shift || true

    # Accept one or more usernames (symmetric with unassign). Strip @ prefixes.
    local -a usernames=()
    local arg
    for arg in "$@"; do
        usernames+=("${arg#@}")
    done

    if [[ -z "$issue_num" ]] || [[ ${#usernames[@]} -eq 0 ]]; then
        error "Usage: zh assign <issue_number> <github_username> [github_username ...]
Examples:
  zh assign 42 acme-user
  zh assign 42 @acme-user
  zh assign 42 alice bob          # assign multiple users"
    fi

