cmd_block() {
    load_config

    local blocked_num="${1:-}"
    local blocking_num="${2:-}"

    if [[ -z "$blocked_num" ]] || [[ -z "$blocking_num" ]]; then
        error "Usage: zh block <blocked_issue> <blocking_issue>

Sets up a dependency: blocked_issue is blocked BY blocking_issue

Example: zh block 123 456
         (Issue #123 is blocked by issue #456 - can't work on 123 until 456 is done)"
    fi

    # Strip # prefix if present
    blocked_num="${blocked_num#\#}"
    blocking_num="${blocking_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    info "Setting #${blocked_num} as blocked by #${blocking_num}..."

    # Get both issue IDs
    local query='
    query($repoId: ID!, $num1: Int!, $num2: Int!) {
        blocked: issueByInfo(repositoryId: $repoId, issueNumber: $num1) {
            id
            title
        }
        blocking: issueByInfo(repositoryId: $repoId, issueNumber: $num2) {
            id
            title
        }
    }'

    local variables
    variables=$(jq -n --arg repo_id "$repo_id" --argjson num1 "$blocked_num" --argjson num2 "$blocking_num" \
        '{repoId: $repo_id, num1: $num1, num2: $num2}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local blocked_id blocked_title blocking_id blocking_title
    blocked_id=$(echo "$response" | jq -r '.data.blocked.id // empty')
    blocked_title=$(echo "$response" | jq -r '.data.blocked.title')
    blocking_id=$(echo "$response" | jq -r '.data.blocking.id // empty')
    blocking_title=$(echo "$response" | jq -r '.data.blocking.title')

    if [[ -z "$blocked_id" ]]; then
        error "Issue #${blocked_num} not found"
    fi
    if [[ -z "$blocking_id" ]]; then
        error "Issue #${blocking_num} not found"
    fi

    # Create the blockage
    local mutation='
    mutation($input: CreateBlockageInput!) {
        createBlockage(input: $input) {
            blockage {
                id
            }
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg blocked_id "$blocked_id" --arg blocking_id "$blocking_id" \
        '{input: {blocked: {id: $blocked_id, type: "ISSUE"}, blocking: {id: $blocking_id, type: "ISSUE"}}}')

    local result
    result=$(zh_graphql "$mutation" "$mutation_vars")

    local blockage_id
    blockage_id=$(echo "$result" | jq -r '.data.createBlockage.blockage.id // empty')

    if [[ -z "$blockage_id" ]]; then
        error "Failed to create blockage"
    fi

    echo ""
    success "Created dependency"
    echo -e "  #${blocked_num} (${blocked_title})"
    echo -e "  ${YELLOW}is blocked by${NC}"
    echo -e "  #${blocking_num} (${blocking_title})"
}

# NOTE: The ZenHub GraphQL API does not have a deleteBlockage mutation.
# This command uses the deprecated REST API which requires a separate token.
# The REST API is scheduled for deprecation - request GraphQL support at:
# https://community.zenhub.com/
cmd_unblock() {
    load_config

    local blocked_num="${1:-}"
    local blocking_num="${2:-}"

    if [[ -z "$blocked_num" ]] || [[ -z "$blocking_num" ]]; then
        error "Usage: zh unblock <blocked_issue> <blocking_issue>

Removes a dependency: blocked_issue is no longer blocked by blocking_issue

Example: zh unblock 123 456
         (Issue #123 is no longer blocked by issue #456)

NOTE: This command requires a REST API token (different from the GraphQL token).
      Generate one at: https://app.zenhub.com/dashboard/tokens
      Add to config as: ZH_REST_TOKEN=your_token_here"
    fi

    # Strip # prefix if present
    blocked_num="${blocked_num#\#}"
    blocking_num="${blocking_num#\#}"

    # Check for REST API token
    local rest_token="${ZH_REST_TOKEN:-}"
    if [[ -z "$rest_token" ]] && [[ -f "$CONFIG_FILE" ]]; then
        rest_token=$(grep -E '^ZH_REST_TOKEN=' "$CONFIG_FILE" 2>/dev/null | cut -d= -f2)
    fi

    if [[ -z "$rest_token" ]]; then
        error "REST API token required for unblock command.

The ZenHub GraphQL API does not support removing dependencies.
This command uses the deprecated REST API which requires a separate token.

To set up:
1. Generate a token at: https://app.zenhub.com/dashboard/tokens
2. Add to ~/.config/zh/config:
   ZH_REST_TOKEN=your_token_here

NOTE: Consider requesting GraphQL support for this feature at:
      https://community.zenhub.com/"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    # Get GitHub repo ID (REST API uses GitHub IDs, not ZenHub IDs)
    local gh_repo_id
    gh_repo_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>/dev/null)

    if [[ -z "$gh_repo_id" ]]; then
        error "Could not get GitHub repo ID for: $owner_repo"
    fi

    info "Removing dependency: #${blocked_num} blocked by #${blocking_num}..."

    # REST API DELETE endpoint - uses JSON body with blocking/blocked objects
    # Note: endpoint is /p1/dependencies (not /p1/repositories/:id/dependencies)
    local response
    local http_code
    http_code=$(curl -s -o /tmp/zh_unblock_response.json -w "%{http_code}" \
        -X DELETE \
        "https://api.zenhub.com/p1/dependencies" \
        -H "X-Authentication-Token: ${rest_token}" \
        -H "Content-Type: application/json" \
        -d "{\"blocking\":{\"repo_id\":${gh_repo_id},\"issue_number\":${blocking_num}},\"blocked\":{\"repo_id\":${gh_repo_id},\"issue_number\":${blocked_num}}}")

    response=$(cat /tmp/zh_unblock_response.json 2>/dev/null)
    rm -f /tmp/zh_unblock_response.json

    if [[ "$http_code" == "204" ]] || [[ "$http_code" == "200" ]]; then
        echo ""
        success "Removed dependency"
        echo -e "  #${blocked_num} is no longer blocked by #${blocking_num}"
    elif [[ "$http_code" == "401" ]]; then
        error "Authentication failed. Check your ZH_REST_TOKEN.
Generate a new token at: https://app.zenhub.com/dashboard/tokens"
    elif [[ "$http_code" == "404" ]]; then
        error "Dependency not found between #${blocked_num} and #${blocking_num}"
    else
        error "Failed to remove dependency (HTTP ${http_code}): ${response}"
    fi
}

cmd_priority() {
    load_config

    local issue_num="${1:-}"
    local priority_action="${2:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh priority <issue_number> [high|clear]

Examples:
  zh priority 42 high   # Set high priority
  zh priority 42 clear  # Remove priority
  zh priority 42        # Show current priority"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get the issue and its pipeline issue ID
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!, $workspaceId: ID!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            pipelineIssue(workspaceId: $workspaceId) {
                id
                priority {
                    id
                    name
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" --arg workspace_id "$workspace_id" \
        '{repoId: $repo_id, issueNumber: $issue_num, workspaceId: $workspace_id}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_title pipeline_issue_id current_priority
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title // empty')
    pipeline_issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssue.id // empty')
    current_priority=$(echo "$issue_response" | jq -r '.data.issueByInfo.pipelineIssue.priority.name // "None"')

    if [[ -z "$issue_title" ]]; then
        error "Issue #${issue_num} not found"
    fi

    if [[ -z "$pipeline_issue_id" ]]; then
        error "Issue #${issue_num} is not in any pipeline"
    fi

    # If no action specified, just show current priority
    if [[ -z "$priority_action" ]]; then
        echo ""
        echo -e "${BOLD}#${issue_num}${NC} ${issue_title}"
        echo -e "  Priority: ${CYAN}${current_priority}${NC}"
        echo ""
        return
    fi

    # Get priority ID (if setting to high)
    local priority_id=""
    if [[ "$priority_action" == "high" ]]; then
        # Get the high priority ID from workspace
        local priorities_query='
        query($workspaceId: ID!) {
            workspace(id: $workspaceId) {
                prioritiesConnection {
                    nodes {
                        id
                        name
                    }
                }
            }
        }'

        local priorities_vars
        priorities_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

        local priorities_response
        priorities_response=$(zh_graphql "$priorities_query" "$priorities_vars")

        priority_id=$(echo "$priorities_response" | jq -r '.data.workspace.prioritiesConnection.nodes[0].id // empty')

        if [[ -z "$priority_id" ]]; then
            error "No priority levels configured in this workspace"
        fi
    fi

    info "Setting priority for issue #${issue_num}..."

    # Set priority
    local mutation='
    mutation($input: SetPriorityOnPipelineIssuesInput!) {
        setPriorityOnPipelineIssues(input: $input) {
            pipelineIssues {
                id
                priority {
                    name
                }
            }
        }
    }'

    local mutation_vars
    if [[ "$priority_action" == "clear" ]] || [[ "$priority_action" == "none" ]] || [[ "$priority_action" == "remove" ]]; then
        mutation_vars=$(jq -n --arg pipeline_issue_id "$pipeline_issue_id" \
            '{input: {pipelineIssueIds: [$pipeline_issue_id], priorityId: null}}')
    else
        mutation_vars=$(jq -n --arg pipeline_issue_id "$pipeline_issue_id" --arg priority_id "$priority_id" \
            '{input: {pipelineIssueIds: [$pipeline_issue_id], priorityId: $priority_id}}')
    fi

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local new_priority
    new_priority=$(echo "$response" | jq -r '.data.setPriorityOnPipelineIssues.pipelineIssues[0].priority.name // "None"')

    echo ""
    success "Updated priority for #${issue_num}: ${issue_title}"
    echo -e "  ${CYAN}${current_priority}${NC} → ${GREEN}${new_priority}${NC}"
}

# =============================================================================
# Epic Commands
# =============================================================================
#
# ZenHub native epics (distinct from legacy "epic" issues). These live on the
# workspace, not on a repository, and have an opaque GraphQL ID of the form
# "gid://raptor/ZenhubEpic/<numeric>". We expose the trailing numeric portion
# as the "epic#" the user types — it is stable and ZenHub-assigned. We re-encode
# it into the full GID before sending API requests.

# =============================================================================
# Sprint commands (v1.6.0)
#
# Inspired by the design proposed in PR #2 by @jeremiahrose. v1.6.0 ships
# read-only sprint visibility (list / show / current); sprint membership
# mutations (sprint-add / sprint-remove) are deferred to a follow-up.
# =============================================================================

# Pagination cap for sprint walks (50 pages × 50 nodes = 2500 sprints,
# vastly more than any realistic workspace). Belt-and-suspenders against
# a server-side cursor bug.
ZH_SPRINT_PAGINATION_CAP=50

# Walk every page of `workspace.sprints` and emit one combined JSON
# document on stdout. Output shape matches a single-page response so
# downstream jq filters don't need to know the listing was paginated.
#
#   { workspace_name, active_sprint_id, nodes: [...] }
#
# `state_filter` is optional; pass "OPEN" to filter to open sprints,
# anything else to fetch all.
zh_sprints_fetch_all() {
    local workspace_id="$1"
    local state_filter="${2:-}"

    local query
    if [[ "$state_filter" == "OPEN" ]]; then
        query='
        query($workspaceId: ID!, $after: String) {
            workspace(id: $workspaceId) {
                name
                activeSprint { id }
                sprints(first: 50, after: $after, filters: { state: { eq: OPEN } }) {
                    pageInfo { hasNextPage endCursor }
                    nodes {
                        id
                        name
                        state
                        startAt
                        endAt
                        completedPoints
                        totalPoints
                        closedIssuesCount
                    }
                }
            }
        }'
    else
        query='
        query($workspaceId: ID!, $after: String) {
            workspace(id: $workspaceId) {
                name
                activeSprint { id }
                sprints(first: 50, after: $after) {
                    pageInfo { hasNextPage endCursor }
                    nodes {
                        id
                        name
                        state
                        startAt
                        endAt
                        completedPoints
                        totalPoints
                        closedIssuesCount
                    }
                }
            }
        }'
    fi

    local cursor="null"
    local last_cursor=""
    local iterations=0
    local all_nodes="[]"
    local workspace_name=""
    local active_sprint_id=""
    local first_page=true

    while :; do
        iterations=$((iterations + 1))
        if [[ "$iterations" -gt "$ZH_SPRINT_PAGINATION_CAP" ]]; then
            warn "Sprint pagination iteration cap (${ZH_SPRINT_PAGINATION_CAP}) reached"
            break
        fi

        local variables
        variables=$(jq -n --arg workspace_id "$workspace_id" --argjson after "$cursor" \
            '{workspaceId: $workspace_id, after: $after}')

        local response
        response=$(zh_graphql "$query" "$variables")

        if [[ "$first_page" == "true" ]]; then
            workspace_name=$(echo "$response" | jq -r '.data.workspace.name // ""')
            active_sprint_id=$(echo "$response" | jq -r '.data.workspace.activeSprint.id // empty')
            first_page=false
        fi

        local page_nodes
        page_nodes=$(echo "$response" | jq -c '.data.workspace.sprints.nodes // []')
        all_nodes=$(jq -n --argjson a "$all_nodes" --argjson b "$page_nodes" '$a + $b')

        local has_next end_cursor
        has_next=$(echo "$response" | jq -r '.data.workspace.sprints.pageInfo.hasNextPage // false')
        end_cursor=$(echo "$response" | jq -r '.data.workspace.sprints.pageInfo.endCursor // ""')

        if [[ "$has_next" != "true" ]]; then
            break
        fi
        if [[ -z "$end_cursor" || "$end_cursor" == "$last_cursor" ]]; then
            warn "Sprint pagination cursor not advancing — bailing"
            break
        fi
        last_cursor="$end_cursor"
        cursor=$(jq -n --arg c "$end_cursor" '$c')
    done

    jq -n \
        --arg workspace_name "$workspace_name" \
        --arg active_sprint_id "$active_sprint_id" \
        --argjson nodes "$all_nodes" \
        '{workspace_name: $workspace_name, active_sprint_id: $active_sprint_id, nodes: $nodes}'
}

cmd_sprints() {
    load_config

    local owner_repo
    owner_repo=$(get_repo_info)

    local show_all=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a)
                show_all=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    info "Getting sprints..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local sprints_json
    if [[ "$show_all" == "true" ]]; then
        sprints_json=$(zh_sprints_fetch_all "$workspace_id" "")
    else
        sprints_json=$(zh_sprints_fetch_all "$workspace_id" "OPEN")
    fi

    local workspace_name active_sprint_id count
    workspace_name=$(echo "$sprints_json" | jq -r '.workspace_name')
    active_sprint_id=$(echo "$sprints_json" | jq -r '.active_sprint_id // empty')
    count=$(echo "$sprints_json" | jq '.nodes | length')

    echo ""
    if [[ "$show_all" == "true" ]]; then
        echo -e "${BOLD}Sprints in ${workspace_name}${NC} (${count} total)"
    else
        echo -e "${BOLD}Sprints in ${workspace_name}${NC} (${count} open)"
    fi
    echo ""

    if [[ "$count" -eq 0 ]]; then
        echo "  No sprints found"
    else
        echo "$sprints_json" | jq -r --arg active_id "$active_sprint_id" '.nodes[] |
            "\(.id)" as $id |
            "\(.startAt[:10] // "?")" as $start |
            "\(.endAt[:10] // "?")" as $end |
            "  \(if $id == $active_id then "● " else "  " end)\(.name)\n    \(.state) │ \($start) → \($end) │ \(.completedPoints // 0)/\(.totalPoints // 0) pts │ \(.closedIssuesCount) closed\n"'
    fi

    echo -e "${CYAN}Tip:${NC} Use 'zh sprint <name>' to view issues in a sprint"
    if [[ "$show_all" != "true" ]]; then
        echo -e "${CYAN}Tip:${NC} Use --all to include closed sprints"
    fi
    echo ""
}

# Walk every page of a sprint's `sprintIssues` connection and emit a
# combined JSON document. Shape matches a single-page response so
# downstream jq filters don't need to know it was paginated.
#
#   { nodes: [ { issue: {...} }, ... ] }
zh_sprint_issues_fetch_all() {
    local sprint_id="$1"

    local query='
    query($sprintId: ID!, $after: String) {
        node(id: $sprintId) {
            ... on Sprint {
                sprintIssues(first: 100, after: $after) {
                    pageInfo { hasNextPage endCursor }
                    nodes {
                        issue {
                            number
                            title
                            state
                            htmlUrl
                            estimate { value }
                            assignees { nodes { login } }
                            repository { ownerName name }
                            pipelineIssues { nodes { pipeline { name } } }
                        }
                    }
                }
            }
        }
    }'

    local cursor="null"
    local last_cursor=""
    local iterations=0
    local all_nodes="[]"

    while :; do
        iterations=$((iterations + 1))
        if [[ "$iterations" -gt 200 ]]; then
            warn "Sprint-issues pagination iteration cap (200) reached"
            break
        fi

        local variables
        variables=$(jq -n --arg sprint_id "$sprint_id" --argjson after "$cursor" \
            '{sprintId: $sprint_id, after: $after}')

        local response
        response=$(zh_graphql "$query" "$variables")

        local page_nodes
        page_nodes=$(echo "$response" | jq -c '.data.node.sprintIssues.nodes // []')
        all_nodes=$(jq -n --argjson a "$all_nodes" --argjson b "$page_nodes" '$a + $b')

        local has_next end_cursor
        has_next=$(echo "$response" | jq -r '.data.node.sprintIssues.pageInfo.hasNextPage // false')
        end_cursor=$(echo "$response" | jq -r '.data.node.sprintIssues.pageInfo.endCursor // ""')

        if [[ "$has_next" != "true" ]]; then
            break
        fi
        if [[ -z "$end_cursor" || "$end_cursor" == "$last_cursor" ]]; then
            warn "Sprint-issues pagination cursor not advancing — bailing"
            break
        fi
        last_cursor="$end_cursor"
        cursor=$(jq -n --arg c "$end_cursor" '$c')
    done

    jq -n --argjson nodes "$all_nodes" '{nodes: $nodes}'
}

cmd_sprint() {
    load_config

    local sprint_name=""
    local show_urls=true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-urls)
                show_urls=false
                shift
                ;;
            *)
                if [[ -z "$sprint_name" ]]; then
                    sprint_name="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$sprint_name" ]]; then
        error "Usage: zh sprint <name> [--no-urls]

View issues in a sprint.

Examples:
  zh sprint \"Sprint 5\"
  zh sprint current          # View active sprint
  zh sprint current --no-urls"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting sprint details..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Resolve sprint id by name (case-insensitive) or current/active.
    # Walk every page of sprints so a workspace with >50 sprints can
    # still resolve older names (review finding #5).
    local sprints_json
    sprints_json=$(zh_sprints_fetch_all "$workspace_id" "")

    local sprint_id
    if [[ "$sprint_name" == "current" ]] || [[ "$sprint_name" == "active" ]]; then
        sprint_id=$(echo "$sprints_json" | jq -r '.active_sprint_id // empty')
        if [[ -z "$sprint_id" ]]; then
            error "No active sprint found"
        fi
        sprint_name=$(echo "$sprints_json" | jq -r --arg id "$sprint_id" '.nodes[] | select(.id == $id) | .name' | head -1)
    else
        sprint_id=$(echo "$sprints_json" | jq -r --arg name "$sprint_name" \
            '.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .id' | head -1)

        if [[ -z "$sprint_id" ]]; then
            echo -e "${RED}Error:${NC} Sprint '${sprint_name}' not found." >&2
            echo "" >&2
            echo "Available sprints:" >&2
            echo "$sprints_json" | jq -r '.nodes[] | "  - \(.name) (\(.state))"' >&2
            exit 1
        fi
    fi

    # Fetch sprint header (single page) + paginated sprintIssues.
    local detail_query='
    query($sprintId: ID!) {
        node(id: $sprintId) {
            ... on Sprint {
                id
                name
                description
                state
                startAt
                endAt
                completedPoints
                totalPoints
                closedIssuesCount
            }
        }
    }'

    local detail_vars
    detail_vars=$(jq -n --arg sprint_id "$sprint_id" '{sprintId: $sprint_id}')

    local detail_response
    detail_response=$(zh_graphql "$detail_query" "$detail_vars")

    local issues_json
    issues_json=$(zh_sprint_issues_fetch_all "$sprint_id")

    local sprint_state start_at end_at completed_pts total_pts closed_count description
    sprint_state=$(echo "$detail_response" | jq -r '.data.node.state // "UNKNOWN"')
    start_at=$(echo "$detail_response" | jq -r '.data.node.startAt[:10] // "?"')
    end_at=$(echo "$detail_response" | jq -r '.data.node.endAt[:10] // "?"')
    completed_pts=$(echo "$detail_response" | jq -r '.data.node.completedPoints // 0')
    total_pts=$(echo "$detail_response" | jq -r '.data.node.totalPoints // 0')
    closed_count=$(echo "$detail_response" | jq -r '.data.node.closedIssuesCount // 0')
    description=$(echo "$detail_response" | jq -r '.data.node.description // empty')

    local issue_count
    issue_count=$(echo "$issues_json" | jq '.nodes | length')

    echo ""
    # `printf '%s\n'` instead of `echo -e` so backslash sequences in the
    # sprint name (user-controlled) aren't interpreted. Review #12.
    printf "${BOLD}Sprint: %s${NC}\n" "$sprint_name"
    echo ""
    echo -e "  ${CYAN}State:${NC}     ${sprint_state}"
    echo -e "  ${CYAN}Period:${NC}    ${start_at} → ${end_at}"
    echo -e "  ${CYAN}Points:${NC}    ${completed_pts}/${total_pts} completed"
    echo -e "  ${CYAN}Closed:${NC}    ${closed_count} issues"
    if [[ -n "$description" ]]; then
        # Same printf treatment for the description — it's user-typed
        # in ZenHub and may contain backslash sequences (review #12).
        printf "  ${CYAN}Description:${NC} %s\n" "$description"
    fi
    echo ""
    echo -e "${BOLD}Issues (${issue_count}):${NC}"
    echo ""

    if [[ "$issue_count" -eq 0 ]]; then
        echo "  No issues in this sprint"
    else
        if [[ "$show_urls" == "true" ]]; then
            echo "$issues_json" | jq -r '.nodes[].issue |
                "\(.state)" as $state |
                "  #\(.number) │ \(.repository.ownerName)/\(.repository.name) │ \((.estimate.value // "—") | tostring) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end) │ \(.pipelineIssues.nodes[0].pipeline.name // "—")\n    \(if $state == "CLOSED" then "✓ " else "" end)\(.title)\n    → \(.htmlUrl)\n"'
        else
            echo "$issues_json" | jq -r '.nodes[].issue |
                "\(.state)" as $state |
                "  #\(.number)  \((.estimate.value // "—") | tostring) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end) │ \(if $state == "CLOSED" then "✓ " else "  " end)\(.title)"'
        fi
    fi
    echo ""
}

cmd_sprint_current() {
    cmd_sprint "current" "$@"
}

# Internal: resolve a sprint name (or current/active) to its GraphQL id.
# Emits "<id>\t<name>" on stdout on success; calls `error` on failure
# (which exits non-zero). Walks every page of sprints so a workspace
# with >50 sprints can still resolve older names.
zh_resolve_sprint_id() {
    local workspace_id="$1"
    local sprint_name="$2"

    local sprints_json
    sprints_json=$(zh_sprints_fetch_all "$workspace_id" "")

    local sprint_id sprint_actual_name
    if [[ "$sprint_name" == "current" || "$sprint_name" == "active" ]]; then
        sprint_id=$(echo "$sprints_json" | jq -r '.active_sprint_id // empty')
        if [[ -z "$sprint_id" ]]; then
            error "No active sprint found"
        fi
        sprint_actual_name=$(echo "$sprints_json" | jq -r --arg id "$sprint_id" \
            '.nodes[] | select(.id == $id) | .name' | head -1)
    else
        sprint_id=$(echo "$sprints_json" | jq -r --arg name "$sprint_name" \
            '.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .id' | head -1)
        sprint_actual_name=$(echo "$sprints_json" | jq -r --arg name "$sprint_name" \
            '.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .name' | head -1)

        if [[ -z "$sprint_id" ]]; then
            echo -e "${RED}Error:${NC} Sprint '${sprint_name}' not found." >&2
            echo "" >&2
            echo "Available sprints:" >&2
            echo "$sprints_json" | jq -r '.nodes[] | "  - \(.name) (\(.state))"' >&2
            exit 1
        fi
    fi

    printf '%s\t%s\n' "$sprint_id" "$sprint_actual_name"
}

# Resolve every issue number (in the cwd's repo) to its GraphQL id.
# Emits one line per issue on stdout: "<id>\t<number>\t<title>".
# Errors out (non-zero exit) listing every not-found number rather than
# stopping at the first one — same accumulator pattern as
# cmd_subissue_remove's pre-flight.
zh_resolve_issue_ids_for_sprint() {
    local repo_id="$1"
    shift
    local nums=("$@")

    local query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
        }
    }'

    local results=""
    local missing=""
    local num stripped issue_response issue_id issue_title
    for num in "${nums[@]}"; do
        stripped="${num#\#}"
        if ! [[ "$stripped" =~ ^[0-9]+$ ]]; then
            error "Invalid issue number: ${num}"
        fi

        local variables
        variables=$(jq -n --arg repo_id "$repo_id" --argjson n "$stripped" \
            '{repoId: $repo_id, issueNumber: $n}')

        issue_response=$(zh_graphql "$query" "$variables")
        issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
        issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title // ""')

        if [[ -z "$issue_id" ]]; then
            missing="${missing} #${stripped}"
        else
            # Tab-separated to keep the title intact even if it has
            # spaces.
            results+="${issue_id}	${stripped}	${issue_title}"$'\n'
        fi
    done

    if [[ -n "$missing" ]]; then
        error "Issue(s) not found in this repository:${missing}"
    fi

    printf '%s' "$results"
}

cmd_sprint_add() {
    load_config

    local sprint_name="${1:-}"
    shift || true

    if [[ -z "$sprint_name" ]] || [[ $# -eq 0 ]]; then
        error "Usage: zh sprint add <sprint_name> <issue#> [<issue#> ...]

Add one or more issues to a sprint.

Examples:
  zh sprint add \"Sprint 5\" 42
  zh sprint add current 42 43 44       # Add to active sprint
  zh sprint add active 42              # 'active' is an alias for current"
    fi

    # Dedup the input numbers (preserving first-occurrence order) so a
    # repeated arg can't inflate the success count when the API
    # returns one link per unique issue. Mirrors the Python boundary
    # dedup in add_issues_to_sprint. Uses a plain-array contains-check
    # rather than an associative array so it stays portable to the
    # bash 3.2 that ships on macOS.
    local -a inputs=()
    local raw_num stripped_arg seen_num
    for raw_num in "$@"; do
        stripped_arg="${raw_num#\#}"
        local already_seen=false
        for seen_num in "${inputs[@]}"; do
            if [[ "$seen_num" == "$stripped_arg" ]]; then
                already_seen=true
                break
            fi
        done
        if [[ "$already_seen" != "true" ]]; then
            inputs+=("$stripped_arg")
        fi
    done
    set -- "${inputs[@]}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    info "Resolving sprint '${sprint_name}'..."
    local sprint_resolved sprint_id sprint_actual_name
    sprint_resolved=$(zh_resolve_sprint_id "$workspace_id" "$sprint_name")
    sprint_id=$(echo "$sprint_resolved" | cut -f1)
    sprint_actual_name=$(echo "$sprint_resolved" | cut -f2)

    info "Resolving ${#} issue(s)..."
    local issues_resolved
    issues_resolved=$(zh_resolve_issue_ids_for_sprint "$repo_id" "$@")

    # Build JSON array of issue ids from the tab-separated result.
    local issue_ids_json
    issue_ids_json=$(echo "$issues_resolved" | awk -F'\t' 'NF >= 1 {print $1}' | jq -R . | jq -s .)

    # Fire the mutation. Ask for sprintIssues back so we can detect
    # partial failures (the API doesn't return failedIssues for this
    # mutation — anything not in the response inferred-failed).
    # Project repository on each link so we can filter by repo before
    # crediting numbers — sibling repos can share issue numbers in a
    # multi-repo workspace.
    local mutation='
    mutation($input: AddIssuesToSprintsInput!) {
        addIssuesToSprints(input: $input) {
            sprintIssues {
                issue {
                    number
                    repository { ownerName name }
                }
                sprint { id }
            }
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg sprint_id "$sprint_id" --argjson issue_ids "$issue_ids_json" \
        '{input: {sprintIds: [$sprint_id], issueIds: $issue_ids}}')

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    # Detect which input numbers came back as links. Filter by sprint id
    # AND by repo so a sibling repo's same-numbered issue can't credit
    # as our success in a multi-repo workspace.
    local owner_lc repo_lc
    owner_lc="${owner_repo%%/*}"
    repo_lc="${owner_repo##*/}"

    local returned_nums_csv
    returned_nums_csv=$(echo "$response" | jq -r \
        --arg sid "$sprint_id" \
        --arg owner "$owner_lc" \
        --arg repo "$repo_lc" \
        '[
           .data.addIssuesToSprints.sprintIssues[]
           | select(.sprint.id == $sid)
           | select(
               (.issue.repository.ownerName | ascii_downcase) == ($owner | ascii_downcase)
               and (.issue.repository.name | ascii_downcase) == ($repo | ascii_downcase)
             )
           | .issue.number
         ] | map(tostring) | join(",")')

    local input_nums_csv
    input_nums_csv=$(echo "$issues_resolved" | awk -F'\t' 'NF >= 2 {print $2}' | paste -sd, -)

    # Split inputs into succeeded / failed by membership.
    local succeeded failed
    succeeded=$(jq -nr --arg inputs "$input_nums_csv" --arg returned "$returned_nums_csv" \
        '($inputs | split(",")) as $in | ($returned | split(",")) as $out |
         [$in[] | select(. as $n | $out | any(. == $n))] | join(",")')
    failed=$(jq -nr --arg inputs "$input_nums_csv" --arg returned "$returned_nums_csv" \
        '($inputs | split(",")) as $in | ($returned | split(",")) as $out |
         [$in[] | select(. as $n | $out | all(. != $n))] | join(",")')

    local total_input
    total_input=$(echo "$input_nums_csv" | awk -F',' '{print NF}')
    local success_count
    success_count=$(echo "$succeeded" | awk -F',' '{if ($0 == "") {print 0} else {print NF}}')
    local failed_count
    failed_count=$(echo "$failed" | awk -F',' '{if ($0 == "") {print 0} else {print NF}}')

    echo ""
    if [[ "$success_count" -gt 0 ]]; then
        success "Added ${success_count}/${total_input} issue(s) to sprint '${sprint_actual_name}': ${succeeded//,/, }"
    fi
    if [[ "$failed_count" -gt 0 ]]; then
        warn "${failed_count} not linked (already in sprint, archived, or rejected by API): ${failed//,/, }"
    fi

    # Exit non-zero on partial / fail so scripted callers notice.
    if [[ "$failed_count" -gt 0 ]] || [[ "$success_count" -eq 0 ]]; then
        exit 1
    fi
}

cmd_sprint_remove() {
    load_config

    local sprint_name="${1:-}"
    shift || true

    if [[ -z "$sprint_name" ]] || [[ $# -eq 0 ]]; then
        error "Usage: zh sprint remove <sprint_name> <issue#> [<issue#> ...]

Remove one or more issues from a sprint.

Examples:
  zh sprint remove \"Sprint 5\" 42
  zh sprint remove current 42 43       # Remove from active sprint
  zh sprint rm active 42               # 'rm' is an alias for remove"
    fi

    # Dedup input numbers (first-occurrence order) so a repeated arg
    # can't be over-counted. Mirrors the Python boundary dedup in
    # remove_issues_from_sprint. Plain-array contains-check for
    # bash 3.2 portability (no associative arrays).
    local -a inputs=()
    local raw_num stripped_arg seen_num
    for raw_num in "$@"; do
        stripped_arg="${raw_num#\#}"
        local already_seen=false
        for seen_num in "${inputs[@]}"; do
            if [[ "$seen_num" == "$stripped_arg" ]]; then
                already_seen=true
                break
            fi
        done
        if [[ "$already_seen" != "true" ]]; then
            inputs+=("$stripped_arg")
        fi
    done
    set -- "${inputs[@]}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    info "Resolving sprint '${sprint_name}'..."
    local sprint_resolved sprint_id sprint_actual_name
    sprint_resolved=$(zh_resolve_sprint_id "$workspace_id" "$sprint_name")
    sprint_id=$(echo "$sprint_resolved" | cut -f1)
    sprint_actual_name=$(echo "$sprint_resolved" | cut -f2)

    info "Resolving ${#} issue(s)..."
    local issues_resolved
    issues_resolved=$(zh_resolve_issue_ids_for_sprint "$repo_id" "$@")

    local issue_ids_json
    issue_ids_json=$(echo "$issues_resolved" | awk -F'\t' 'NF >= 1 {print $1}' | jq -R . | jq -s .)

    # The mutation returns the sprint's post-state. Anything STILL
    # attached after the call is inferred-failed. We ask for the full
    # post-state via a paginated walk, since the response cap of 100
    # would otherwise mis-classify removed-but-on-page-2 issues as
    # still-attached.
    local mutation='
    mutation($input: RemoveIssuesFromSprintsInput!) {
        removeIssuesFromSprints(input: $input) {
            sprints { id }
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg sprint_id "$sprint_id" --argjson issue_ids "$issue_ids_json" \
        '{input: {sprintIds: [$sprint_id], issueIds: $issue_ids}}')

    zh_graphql "$mutation" "$mutation_vars" > /dev/null

    # Post-state walk to determine which inputs are still in the sprint.
    # zh_sprint_issues_fetch_all already projects repository per issue,
    # so we can filter by repo here — sibling repos can share issue
    # numbers in a multi-repo workspace and we must not mis-classify
    # our removal as failed because some other repo's same-numbered
    # issue is still in the sprint.
    local post_state
    post_state=$(zh_sprint_issues_fetch_all "$sprint_id")

    local owner_lc repo_lc
    owner_lc="${owner_repo%%/*}"
    repo_lc="${owner_repo##*/}"

    local still_attached_nums_csv
    still_attached_nums_csv=$(echo "$post_state" | jq -r \
        --arg owner "$owner_lc" \
        --arg repo "$repo_lc" \
        '[
           .nodes[]
           | select(
               (.issue.repository.ownerName | ascii_downcase) == ($owner | ascii_downcase)
               and (.issue.repository.name | ascii_downcase) == ($repo | ascii_downcase)
             )
           | .issue.number
         ] | map(tostring) | join(",")')

    local input_nums_csv
    input_nums_csv=$(echo "$issues_resolved" | awk -F'\t' 'NF >= 2 {print $2}' | paste -sd, -)

    local succeeded failed
    succeeded=$(jq -nr --arg inputs "$input_nums_csv" --arg attached "$still_attached_nums_csv" \
        '($inputs | split(",")) as $in | ($attached | split(",")) as $att |
         [$in[] | select(. as $n | $att | all(. != $n))] | join(",")')
    failed=$(jq -nr --arg inputs "$input_nums_csv" --arg attached "$still_attached_nums_csv" \
        '($inputs | split(",")) as $in | ($attached | split(",")) as $att |
         [$in[] | select(. as $n | $att | any(. == $n))] | join(",")')

    local total_input
    total_input=$(echo "$input_nums_csv" | awk -F',' '{print NF}')
    local success_count
    success_count=$(echo "$succeeded" | awk -F',' '{if ($0 == "") {print 0} else {print NF}}')
    local failed_count
    failed_count=$(echo "$failed" | awk -F',' '{if ($0 == "") {print 0} else {print NF}}')

    echo ""
    if [[ "$success_count" -gt 0 ]]; then
        success "Removed ${success_count}/${total_input} issue(s) from sprint '${sprint_actual_name}': ${succeeded//,/, }"
    fi
    if [[ "$failed_count" -gt 0 ]]; then
        warn "${failed_count} still in sprint (API rejected the removal): ${failed//,/, }"
    fi

    if [[ "$failed_count" -gt 0 ]] || [[ "$success_count" -eq 0 ]]; then
        exit 1
    fi
}

# Encode a numeric epic ID into its GraphQL global-ID form.
zh_epic_encode_id() {
    local epic_num="$1"
    printf 'gid://raptor/ZenhubEpic/%s' "$epic_num" | base64 | tr -d '\n'
}

# Decode a ZenHub epic GID back to its numeric form (for display).
zh_epic_decode_id() {
    local gid="$1"
    local decoded
    decoded=$(printf '%s' "$gid" | base64 -d 2>/dev/null || true)
    # decoded looks like: gid://raptor/ZenhubEpic/123459
    echo "${decoded##*/}"
}

# Build a best-effort ZenHub URL for an epic.
zh_epic_build_url() {
    local workspace_id="$1"
    local epic_num="$2"
    echo "https://app.zenhub.com/workspaces/${workspace_id}/zenhub-epics/${epic_num}"
}

# Verify an epic exists and return its full GID; errors out if not found.
# We bypass zh_graphql's strict error handling here because looking up a
# non-existent epic legitimately returns a NOT_FOUND error from the API, and
# we want to surface a friendly "Epic #N not found" message rather than the
# raw GraphQL error text.
zh_epic_resolve() {
    local epic_num="$1"
    epic_num="${epic_num#\#}"

    if ! [[ "$epic_num" =~ ^[0-9]+$ ]]; then
        error "Invalid epic number: ${epic_num} (must be numeric)"
    fi

    local gid
    gid=$(zh_epic_encode_id "$epic_num")

    local query='query($id: ID!) { node(id: $id) { ... on ZenhubEpic { id } } }'
    local variables
    variables=$(jq -n --arg id "$gid" '{id: $id}')

    local body
    body=$(jq -n --arg q "$query" --argjson v "$variables" '{query: $q, variables: $v}')

    local response
    response=$(curl -s -X POST "$ZENHUB_API" \
        -H "Authorization: Bearer ${ZH_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "$body")

    local resolved
    resolved=$(echo "$response" | jq -r '.data.node.id // empty')

    if [[ -z "$resolved" ]]; then
        # Distinguish "not found" from other errors (auth, network, etc.)
        local err_code
        err_code=$(echo "$response" | jq -r '.errors[0].extensions.code // empty')
        if [[ "$err_code" == "NOT_FOUND" ]]; then
            error "Epic #${epic_num} not found in this workspace"
        fi

        local err_msg
        err_msg=$(echo "$response" | jq -r '.errors[0].message // "Unknown error"')
        error "ZenHub API error resolving epic #${epic_num}: ${err_msg}"
    fi

    echo "$resolved"
}

cmd_epic_list() {
    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting epics for ${owner_repo}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            name
            zenhubEpics(first: 100) {
                totalCount
                nodes {
                    id
                    title
                    state
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local workspace_name total
    workspace_name=$(echo "$response" | jq -r '.data.workspace.name // "Unknown"')
    total=$(echo "$response" | jq -r '.data.workspace.zenhubEpics.totalCount // 0')

    echo ""
    echo -e "${BOLD}Epics in ${workspace_name}${NC} (${total} total)"
    echo ""

    if [[ "$total" -eq 0 ]]; then
        echo "  No epics in this workspace"
        echo ""
        return
    fi

    # Decode each epic's GID to a numeric number; print "num | state | title"
    echo "$response" | jq -r '.data.workspace.zenhubEpics.nodes[] |
        "\(.id)\t\(.state)\t\(.title)"' | \
        while IFS=$'\t' read -r gid state title; do
            local epic_num
            epic_num=$(zh_epic_decode_id "$gid")
            local state_color="$GREEN"
            if [[ "$state" == "CLOSED" ]]; then
                state_color="$YELLOW"
            fi
            printf "  ${BOLD}#%s${NC}  ${state_color}%-6s${NC}  %s\n" "$epic_num" "$state" "$title"
        done

    echo ""
    echo -e "${CYAN}Tip:${NC} Use 'zh epic show <epic#>' to see an epic and its child issues"
}

cmd_epic_show() {
    local epic_num="${1:-}"

    if [[ -z "$epic_num" ]]; then
        error "Usage: zh epic show <epic#>
Example: zh epic show 12345"
    fi

    epic_num="${epic_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Verify the epic exists and resolve to GID
    local epic_gid
    epic_gid=$(zh_epic_resolve "$epic_num")

    local query='
    query($id: ID!, $workspaceId: ID!) {
        node(id: $id) {
            ... on ZenhubEpic {
                id
                title
                state
                body
                createdAt
                updatedAt
                childIssues(workspaceId: $workspaceId, first: 100) {
                    totalCount
                    nodes {
                        number
                        title
                        state
                        assignees {
                            nodes { login }
                        }
                        pipelineIssue(workspaceId: $workspaceId) {
                            pipeline { name }
                        }
                        repository {
                            ownerName
                            name
                        }
                    }
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg id "$epic_gid" --arg workspace_id "$workspace_id" \
        '{id: $id, workspaceId: $workspace_id}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local epic
    epic=$(echo "$response" | jq '.data.node')

    if [[ "$epic" == "null" ]]; then
        error "Epic #${epic_num} not found"
    fi

    local title state body child_count zh_url
    title=$(echo "$epic" | jq -r '.title')
    state=$(echo "$epic" | jq -r '.state')
    body=$(echo "$epic" | jq -r '.body // ""')
    child_count=$(echo "$epic" | jq -r '.childIssues.totalCount // 0')
    zh_url=$(zh_epic_build_url "$workspace_id" "$epic_num")

    local state_color="$GREEN"
    if [[ "$state" == "CLOSED" ]]; then
        state_color="$YELLOW"
    fi

    echo ""
    echo -e "${BOLD}Epic #${epic_num}${NC} ${title}"
    echo ""
    echo -e "  ${CYAN}State:${NC}    ${state_color}${state}${NC}"
    echo -e "  ${CYAN}Children:${NC} ${child_count}"
    echo -e "  ${CYAN}ZenHub:${NC}   ${zh_url}"
    echo ""

    if [[ -n "$body" ]] && [[ "$body" != "null" ]]; then
        echo -e "${BOLD}Body:${NC}"
        echo ""
        echo "$body" | sed 's/^/  /'
        echo ""
    fi

    echo -e "${BOLD}Child issues (${child_count}):${NC}"
    echo ""

    if [[ "$child_count" -eq 0 ]]; then
        echo "  No child issues"
        echo ""
        return
    fi

    echo "$epic" | jq -r '.childIssues.nodes[] |
        "\(.number)\t\(.state)\t\(.pipelineIssue.pipeline.name // "—")\t\([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end)\t\(.title)"' | \
        while IFS=$'\t' read -r num istate pipeline assignees ititle; do
            local marker="  "
            local color="$NC"
            if [[ "$istate" == "CLOSED" ]]; then
                marker="✓ "
                color="$YELLOW"
            fi
            printf "  ${BOLD}#%-5s${NC} │ %-20s │ %-15s │ ${color}%s%s${NC}\n" \
                "$num" "${pipeline:0:20}" "${assignees:0:15}" "$marker" "$ititle"
        done

    echo ""
}

cmd_epic_create() {
    local title=""
    local body=""
    local labels=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--description|-b|--body)
                body="$2"
                shift 2
                ;;
            -l|--label|--labels)
                labels="$2"
                shift 2
                ;;
            *)
                if [[ -z "$title" ]]; then
                    title="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$title" ]]; then
        error "Usage: zh epic create \"<title>\" [-d <description>] [-l label1,label2]
Example: zh epic create \"Auth Service\" -d \"Build authentication API\" -l backend,auth"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Creating epic: ${title}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Get zenhubOrganization ID from the workspace. We deliberately do NOT pass
    # zenhubRepositoryId — that field expects a ZenHub-internal repo ID (distinct
    # from the GitHub-mirrored repo ID we have access to), and the field is
    # optional. Without it, the epic is workspace-scoped, which matches what
    # the ZenHub UI does for native epics.
    local org_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            zenhubOrganization { id }
        }
    }'

    local org_vars
    org_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local org_response
    org_response=$(zh_graphql "$org_query" "$org_vars")

    local org_id
    org_id=$(echo "$org_response" | jq -r '.data.workspace.zenhubOrganization.id // empty')

    if [[ -z "$org_id" ]]; then
        error "Could not determine ZenHub organization for workspace"
    fi

    # Build the epic-input payload
    local epic_input
    if [[ -n "$body" ]]; then
        epic_input=$(jq -n --arg title "$title" --arg body "$body" \
            '{title: $title, body: $body}')
    else
        epic_input=$(jq -n --arg title "$title" '{title: $title}')
    fi

    local create_vars
    create_vars=$(jq -n \
        --arg org_id "$org_id" \
        --argjson epic "$epic_input" \
        '{input: {zenhubOrganizationId: $org_id, zenhubEpic: $epic}}')

    local mutation='
    mutation($input: CreateZenhubEpicInput!) {
        createZenhubEpic(input: $input) {
            zenhubEpic {
                id
                title
                state
            }
        }
    }'

    local response
    response=$(zh_graphql "$mutation" "$create_vars")

    local new_gid
    new_gid=$(echo "$response" | jq -r '.data.createZenhubEpic.zenhubEpic.id // empty')

    if [[ -z "$new_gid" ]]; then
        error "Failed to create epic"
    fi

    local new_num
    new_num=$(zh_epic_decode_id "$new_gid")

    local new_url
    new_url=$(zh_epic_build_url "$workspace_id" "$new_num")

    echo ""
    success "Created epic #${new_num}: ${title}"
    echo -e "  ${CYAN}URL:${NC} ${new_url}"

    # Apply labels (best-effort) — uses LabelInfoInput {name, color}
    if [[ -n "$labels" ]]; then
        local labels_array
        labels_array=$(echo "$labels" | jq -R \
            'split(",") | map(gsub("^\\s+|\\s+$"; "")) | map({name: ., color: "cccccc"})')

        local label_vars
        label_vars=$(jq -n --arg gid "$new_gid" --argjson infos "$labels_array" \
            '{input: {zenhubEpicIds: [$gid], labelInfos: $infos}}')

        local label_mutation='
        mutation($input: AddZenhubLabelsToZenhubEpicsInput!) {
            addZenhubLabelsToZenhubEpics(input: $input) {
                zenhubEpics { id }
            }
        }'

        if zh_graphql "$label_mutation" "$label_vars" > /dev/null 2>&1; then
            echo -e "  ${CYAN}Labels:${NC} ${labels}"
        else
            warn "Failed to apply labels: ${labels}"
        fi
    fi
}

# Shared helper: resolve a list of issue numbers to ZenHub issue IDs.
# Echoes a JSON array of IDs (one per resolved issue) on stdout; errors out
# if any issue is missing.
zh_resolve_issue_ids() {
    local repo_id="$1"
    shift
    local issue_nums=("$@")

    local ids="[]"
    for num in "${issue_nums[@]}"; do
        local stripped="${num#\#}"
        if ! [[ "$stripped" =~ ^[0-9]+$ ]]; then
            error "Invalid issue number: ${num}"
        fi

        local query='
        query($repoId: ID!, $issueNumber: Int!) {
            issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
                id
            }
        }'

        local variables
        variables=$(jq -n --arg repo_id "$repo_id" --argjson n "$stripped" \
            '{repoId: $repo_id, issueNumber: $n}')

        local response
        response=$(zh_graphql "$query" "$variables")

        local issue_id
        issue_id=$(echo "$response" | jq -r '.data.issueByInfo.id // empty')

        if [[ -z "$issue_id" ]]; then
            error "Issue #${stripped} not found in this repository"
        fi

        ids=$(echo "$ids" | jq --arg id "$issue_id" '. + [$id]')
    done

    echo "$ids"
}

cmd_epic_add() {
    local epic_num="${1:-}"
    shift || true

    if [[ -z "$epic_num" ]] || [[ $# -eq 0 ]]; then
        error "Usage: zh epic add <epic#> <issue#> [<issue#> ...]
Example: zh epic add 12345 369 370"
    fi

    local issue_nums=("$@")

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

