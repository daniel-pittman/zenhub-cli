# =============================================================================
# Issue-type set verb (G8) + planning-hierarchy nouns (G3)
# =============================================================================
#
# v1.9.0: the planning nouns (initiative/project/epic/subtask) are thin sugar
# over the issue-type + sub-issue model. There is no separate ZenhubEpic object
# anymore: an "epic" is just an Issue whose issue-type is Epic. The generic
# mechanism (cmd_hierarchy_*) is driven entirely by a type NAME resolved through
# assignableIssueTypes, so adding or removing a level later is a one-line alias
# change with no new GraphQL.

# zh type <issue#> <type-name>: change an existing issue's type (G8).
# Wraps changeIssueTypeOfIssues, which accepts the unified issueTypeId for both
# GithubIssueType and ZenhubIssueType.
cmd_set_type() {
    load_config

    local issue_num="${1:-}"
    local type_name="${2:-}"

    if [[ -z "$issue_num" ]] || [[ -z "$type_name" ]]; then
        error "Usage: zh type <issue#> <type-name>

Change an existing issue's type. Discover type names with 'zh types'.

Examples:
  zh type 42 Epic       # Promote #42 to an Epic
  zh type 42 Feature    # Set #42 back to a board-level Feature"
    fi

    issue_num="${issue_num#\#}"
    if ! [[ "$issue_num" =~ ^[0-9]+$ ]]; then
        error "Invalid issue number: ${issue_num}"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local types_json
    types_json=$(zh_fetch_issue_types "$owner_repo" "$workspace_id")

    local type_id
    type_id=$(zh_issue_type_id_from "$types_json" "$type_name")
    if [[ -z "$type_id" ]]; then
        local available
        available=$(zh_issue_type_names_from "$types_json")
        error "Issue type '${type_name}' not found in this workspace. Available: ${available:-(none)}. Discover with 'zh types'."
    fi

    local issue_id
    issue_id=$(zh_resolve_issue_id "$repo_id" "$issue_num")

    info "Setting type of #${issue_num} to ${type_name}..."

    local mutation='
    mutation($input: ChangeIssueTypeOfIssuesInput!) {
        changeIssueTypeOfIssues(input: $input) {
            successCount
            failedIssues { number }
            githubErrors
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg id "$issue_id" --arg tid "$type_id" \
        '{input: {issueIds: [$id], issueTypeId: $tid}}')

    # v1.9.2 round-7 finding #5: fail-soft envelope mirroring the
    # cmd_create round-6 #1 / #2 / #5 pattern. Pre-fix this was a
    # bare assignment `response=$(zh_graphql ...)`. Under `set -euo
    # pipefail`, when zh_graphql `error`s and exits 1 on a `.errors`
    # response, the subshell exits 1, the outer assignment carries
    # the status, and cmd_set_type aborts before reaching the
    # partial-applied gate below. With the capture-and-branch
    # pattern the partial-detection path stays reachable; an empty
    # response is treated as a hard failure so the caller sees a
    # clear cmd_set_type-level diagnostic instead of a bash silent
    # abort.
    #
    # v1.9.2 round-1 (PR #27) finding #1: capture stderr separately
    # so the error message includes the root-cause hint (e.g.
    # "Invalid token", "rate-limited"). The first version of this
    # envelope in v1.9.2 dropped stderr to /dev/null, which left the
    # operator with the generic "check token / network / rate
    # limits" line and no actionable diagnostic. Mirrors the
    # cmd_create round-7 #12 pattern. The `mktemp || /dev/null`
    # fallback (round-1 finding #2) keeps the envelope working on
    # systems where TMPDIR is unwritable.
    local response="" response_err=""
    local _resp_err_file
    _resp_err_file=$(mktemp -t zh_settype.XXXXXX 2>/dev/null) || _resp_err_file=/dev/null
    response=$(zh_graphql "$mutation" "$mutation_vars" 2>"$_resp_err_file") || response=""
    if [[ "$_resp_err_file" != "/dev/null" ]]; then
        response_err=$(zh_cause_hint "$_resp_err_file")
        # v1.9.2 round-4 (PR #27) finding #10: under set -euo pipefail
        # a bare `rm -f` that fails (read-only TMPDIR mid-test, file
        # removed by a sibling process) aborts cmd_set_type AFTER
        # the mutation has run, losing both the partial-applied warn
        # and the exit-2 signal the MCP wrapper depends on. Match
        # the cmd_create envelope pattern.
        rm -f "$_resp_err_file" 2>/dev/null || true
    fi
    if [[ -z "$response" ]]; then
        if [[ -n "$response_err" ]]; then
            error "Failed to set type of #${issue_num} (cause: ${response_err}). Verify with 'zh issue ${issue_num}' before retrying."
        else
            error "Failed to set type of #${issue_num}: ZenHub API call returned no usable response (check token / network / rate limits, then verify with 'zh issue ${issue_num}' before retrying)."
        fi
    fi

    local success_count failed_count gh_errors gh_errors_len
    success_count=$(echo "$response" | jq -r '.data.changeIssueTypeOfIssues.successCount // 0')
    failed_count=$(echo "$response" | jq -r '(.data.changeIssueTypeOfIssues.failedIssues // []) | length')
    gh_errors=$(echo "$response" | jq -c '.data.changeIssueTypeOfIssues.githubErrors // {}')
    gh_errors_len=$(echo "$gh_errors" | jq 'if type == "object" or type == "array" then length else 1 end')

    # v1.9.1 item #3: a partial-failure shape (successCount=1 alongside a
    # populated githubErrors / failedIssues) used to print "Set type" as
    # if the change had landed cleanly. Honor the failure signals so the
    # operator learns the type did not actually change.
    if [[ "$success_count" -lt 1 ]]; then
        error "Failed to set type of #${issue_num}: $(echo "$response" | jq -c '.data.changeIssueTypeOfIssues // .errors')"
    fi
    if [[ "$failed_count" -gt 0 ]] || [[ "$gh_errors_len" -gt 0 ]]; then
        # Round-2 finding #5: successCount >= 1 is a precondition of
        # reaching this branch (the gate above returns on < 1), so the
        # type change DID land on the ZenHub side. The mutation also
        # reported a follow-on issue (a GitHub-side error or an entry in
        # failedIssues). Wording this as "Failed to set type" would
        # mislead the operator into retrying a change that already
        # applied; phrase it as a partial-applied warning that points
        # them at zh issue for verification.
        #
        # Round-6 finding #4: switch from `error` (echo + exit 1) to
        # `warn` + `exit 2` to match the documented exit-code
        # convention (exit 2 = divergence-only partial, scripted
        # callers re-verify before retry). Mirrors cmd_subissue_add
        # and cmd_sprint_remove. The MCP set_issue_type wrapper reads
        # the exit code to set partial_applied=True so an agent does
        # not retry a change that landed.
        warn "Partially applied: type change on #${issue_num} landed on ZenHub (successCount=${success_count}), but the mutation reported follow-on errors (failedIssues=$(echo "$response" | jq -c '.data.changeIssueTypeOfIssues.failedIssues // []'), githubErrors=${gh_errors}). Verify with 'zh issue ${issue_num}' before retrying."
        exit 2
    fi

    echo ""
    success "Set type of #${issue_num} to ${type_name}"
}

# -----------------------------------------------------------------------------
# Generic planning-hierarchy noun engine (G3 + 5-level model)
# -----------------------------------------------------------------------------
#
# Every planning noun (initiative/project/epic/subtask) is the SAME machinery
# parameterised by an issue-type NAME. The noun dispatchers below each call
# cmd_hierarchy_dispatch with their type name; nothing about the level is
# hardcoded, so the set of nouns can grow or shrink with the workspace's
# configured types. The subcommand surface mirrors the old epic verbs:
#
#   <noun> create "Title" [-d body] [-l labels] [-p pipeline] [--json|-q]
#   <noun> list
#   <noun> show <issue#>
#   <noun> add <parent#> <child#> [<child#> ...]      (addSubIssues)
#   <noun> remove <parent#> <child#> [...]            (removeSubIssues)
#   <noun> update <issue#> [-t title] [-d body]
#   <noun> close <issue#> [comment]
#   <noun> reopen <issue#>
#
# create is `zh create -t <TYPE>` sugar; add/remove are `zh subissue` sugar;
# update/close/reopen are normal issue ops on a real issue. This is why the
# headline finding (ZenhubEpic was a dead API) collapses to "epics are just
# issues now": all the hierarchy mechanism already existed for sub-issues.

# v1.9.1 item #11: map a ZenHub issue-type name to the canonical command
# noun used in the CLI (`subtask` for type "Sub-task", lowercased name
# otherwise). This is the single source of truth for any output line that
# wants to print "use zh <noun> ..." without baking in the to_lower path.
# Keep in sync with the cmd_<noun> aliases at the bottom of the planning
# section.
zh_display_noun_for_type() {
    local type_name="$1"
    local lower
    lower=$(to_lower "$type_name")
    case "$lower" in
        sub-task)
            echo "subtask"
            ;;
        *)
            echo "$lower"
            ;;
    esac
}

# Resolve a noun's type name to a canonical, configured type name (preserving
# the workspace's casing) and confirm it is assignable. Errors with the
# available list if the type is not enabled in this workspace.
zh_hierarchy_require_type() {
    local owner_repo="$1"
    local workspace_id="$2"
    local type_name="$3"

    local types_json
    types_json=$(zh_fetch_issue_types "$owner_repo" "$workspace_id")

    local canonical
    canonical=$(echo "$types_json" | jq -r --arg name "$type_name" \
        'map(select((.name | ascii_downcase) == ($name | ascii_downcase))) | .[0].name // empty')

    if [[ -z "$canonical" ]]; then
        local available
        available=$(zh_issue_type_names_from "$types_json")
        error "Issue type '${type_name}' is not assignable in this workspace. Available: ${available:-(none)}. Enable it in ZenHub workspace settings, then retry."
    fi

    echo "$canonical"
}

# <noun> create: create an issue with the noun's issue type. Delegates to
# cmd_create so --json/-q, labels, pipeline, body-file, and assignee all work
# identically to plain `zh create`.
cmd_hierarchy_create() {
    local type_name="$1"
    shift || true
    # v1.9.1 item #11: display noun is passed in explicitly so Sub-task
    # renders as `subtask` in Tips/Usage without breaking the
    # ZenhubIssueType name match.
    local display_noun="$1"
    shift || true

    if [[ $# -eq 0 ]]; then
        error "Usage: zh ${display_noun} create \"<title>\" [-d <body>] [-l labels] [-p pipeline] [--json|-q]"
    fi

    # Pass everything through to cmd_create with the type prepended. cmd_create
    # owns arg parsing (including --json/-q and the -d/-b body flags via -b).
    # We translate the planning-noun's -d/--description to cmd_create's -b.
    #
    # v1.9.1 round-4 finding #3: apply the same `--flag=value`
    # normalization cmd_create uses, so `--description=Body` and
    # `--type=Bug` go through our case arms (the `-d` rewrite and the
    # `-t` conflict-detection error) instead of falling through to the
    # `*)` arm and being silently forwarded to cmd_create as opaque
    # tokens that lose the user's intent.
    #
    # Round-5 finding #2: mirror the cmd_create round-4 #4 empty-value
    # rejection. Without it, `zh epic create "X" --description=` (an
    # unset shell variable expanded to nothing) splits to
    # `--description ""` BEFORE cmd_create sees the token, so
    # cmd_create's own empty-value guard never fires and the planning
    # noun creates an empty-body issue. Reject here for symmetry.
    local -a passthrough=()
    local _h_title_seen="false"
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == --*=* ]]; then
            local _hnorm_flag="${1%%=*}"
            local _hnorm_val="${1#*=}"
            # v1.9.2 round-7 finding #6: two-stage disambiguation
            # mirroring cmd_create's round-6 #8 fix. Without this,
            # cmd_hierarchy_create unconditionally split EVERY
            # `--foo=bar` token, including a literal title like
            # `"--rotate=enabled fails on retry"`. The split halves
            # then forwarded opaquely to cmd_create via passthrough,
            # where the title was already gone — cmd_create's own
            # disambiguation never saw the original `--*=*` token.
            #
            # Only normalize when (a) the prefix is a flag this verb
            # or cmd_create actually accepts, OR (b) a positional
            # (title) has already been captured. The known list
            # mirrors the union of cmd_hierarchy_create's case arms
            # and cmd_create's known long flags.
            local _h_is_known="false"
            local _h_is_boolean="false"
            case "$_hnorm_flag" in
                -d|--description|--label|--labels|--pipeline|--assign|--assignee|--estimate|--body|--file|--body-file|--parent|--priority|--type)
                    _h_is_known="true"
                    ;;
                --json|--quiet|--stdin)
                    _h_is_known="true"
                    _h_is_boolean="true"
                    ;;
            esac
            if [[ "$_h_title_seen" == "true" || "$_h_is_known" == "true" ]]; then
                if [[ "$_h_is_boolean" == "true" ]]; then
                    error "Option ${_hnorm_flag} is a boolean flag and does not accept a value (received '${1}')"
                fi
                if [[ -z "$_hnorm_val" ]]; then
                    error "Option ${_hnorm_flag} requires a value (received empty string from '${1}')"
                fi
                set -- "$_hnorm_flag" "$_hnorm_val" "${@:2}"
            fi
        fi
        case "$1" in
            -d|--description)
                # Arity guard: a bare `-d` at end-of-args would otherwise
                # dereference unbound $2 and die with a raw bash error under
                # `set -u` (review finding #5). Mirror cmd_update_issue's
                # check.
                if [[ $# -lt 2 ]]; then
                    error "Option ${1} requires a value"
                fi
                passthrough+=("-b" "$2")
                shift 2
                ;;
            -t|--type)
                # The noun IS the type. Accepting a user-supplied -t and
                # appending our own at the tail would silently drop the
                # user's value (cmd_create's parser is last-wins), so
                # `zh epic create "X" -t Bug` would create an Epic with
                # the user's intent lost. Reject up-front. Review finding
                # round-3 #2.
                error "-t conflicts with the noun type ${type_name}. Do not pass -t to 'zh ${display_noun} create'; use 'zh create -t <type>' for an explicit type or 'zh type <issue#> <name>' to retype after create."
                ;;
            -l|--label|--labels|-p|--pipeline|-a|--assign|--assignee|-e|--estimate|-b|--body|-f|--file|--body-file|--parent|--priority)
                # v1.9.2 round-3 (PR #27) finding #3: consume value-
                # taking flags + their value as a 2-token unit so the
                # value never reaches `*)` and flips _h_title_seen.
                # Pre-fix, `zh epic create -l urgent "--rotate=foo"`
                # passed `-l` through *) (it's -* prefixed, no flip),
                # then `urgent` (the value, NOT -* prefixed) flipped
                # the flag, and the next iteration's `--rotate=foo`
                # got split as a flag because the title was "seen".
                # cmd_create then captured `--rotate` as the title
                # and silently dropped the user's text — the exact
                # round-7 #6 failure mode this arm closes.
                if [[ $# -lt 2 ]]; then
                    error "Option ${1} requires a value"
                fi
                passthrough+=("$1" "$2")
                shift 2
                ;;
            -q|--json|--quiet|--stdin)
                # v1.9.2 round-3 (PR #27) finding #3: similarly,
                # explicit boolean-flag arm so the next token never
                # gets mis-classified as the boolean's "value" and
                # then flipped to title.
                passthrough+=("$1")
                shift
                ;;
            *)
                # v1.9.2 round-7 finding #6: track whether a title (the
                # first positional) has been captured. Subsequent
                # `--*=*` tokens are unambiguously flags and can be
                # split safely; before the first positional, only
                # known flags are split so a literal `--rotate=...`
                # title is preserved.
                if [[ "$_h_title_seen" == "false" && "$1" != -* ]]; then
                    _h_title_seen="true"
                fi
                passthrough+=("$1")
                shift
                ;;
        esac
    done

    cmd_create "${passthrough[@]}" -t "$type_name"
}

# <noun> list: list workspace issues of the noun's issue type.
cmd_hierarchy_list() {
    local type_name="$1"
    # v1.9.1 item #11: display noun (e.g. `subtask` for type "Sub-task").
    local display_noun="$2"

    load_config

    local owner_repo
    owner_repo=$(get_repo_info)

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local canonical
    canonical=$(zh_hierarchy_require_type "$owner_repo" "$workspace_id" "$type_name")

    info "Getting ${canonical} issues..."

    local query='
    query($workspaceId: ID!, $typeName: String!) {
        workspace(id: $workspaceId) {
            name
            issues(first: 100, filters: {issueIssueTypes: {in: [$typeName]}}) {
                totalCount
                nodes {
                    number
                    title
                    state
                    repository { ownerName name }
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg workspace_id "$workspace_id" --arg typeName "$canonical" \
        '{workspaceId: $workspace_id, typeName: $typeName}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local ws_name total
    ws_name=$(echo "$response" | jq -r '.data.workspace.name // "Unknown"')
    total=$(echo "$response" | jq -r '.data.workspace.issues.totalCount // 0')

    echo ""
    echo -e "${BOLD}${canonical} issues in ${ws_name}${NC} (${total} total)"
    echo ""

    if [[ "$total" -eq 0 ]]; then
        echo "  No ${canonical} issues in this workspace"
        echo ""
        return
    fi

    echo "$response" | jq -r '.data.workspace.issues.nodes[] |
        "\(.number)\t\(.state)\t\(.title)"' | \
        while IFS=$'\t' read -r num state title; do
            local state_color="$GREEN"
            if [[ "$state" == "CLOSED" ]]; then
                state_color="$YELLOW"
            fi
            printf "  ${BOLD}#%-5s${NC} ${state_color}%-6s${NC} %s\n" "$num" "$state" "$title"
        done
    echo ""

    # Coverage warning (review finding #7). The query caps at first: 100;
    # if totalCount exceeds the rendered set, say so explicitly rather than
    # silently truncating. Full pagination is a separate follow-up.
    local fetched
    fetched=$(echo "$response" | jq -r '.data.workspace.issues.nodes | length')
    if [[ "$total" -gt "$fetched" ]]; then
        warn "Showing first ${fetched} of ${total} ${canonical} issues (the query caps at 100; remaining are not displayed)."
    fi

    echo -e "${CYAN}Tip:${NC} 'zh ${display_noun} show <issue#>' shows an issue and its sub-issues."
}

# v1.9.1 item #9 (round-2 finding #2): planning-noun update/close/reopen
# need the same type-mismatch warning that show now emits. The argument
# parsers of those verbs (cmd_update_issue / cmd_close / cmd_reopen)
# accept the issue number in any position relative to their flags, so we
# scan the WHOLE positional vector for the first numeric token rather
# than breaking at the first `-*` (the prior implementation missed
# `zh epic update -t "Foo" 42` where the issue number lives after a
# flag). False positives are bounded: a flag's argument that happens to
# be all digits would also be picked, but the warn is advisory and the
# verb still proceeds.
#
# `verb` is the invoking verb (show / update / close / reopen) so the
# warn line can redirect to the right command, not always to `show`
# (round-2 finding #4).
zh_hierarchy_warn_for_noun() {
    local expected_type="$1"
    local verb="$2"
    shift 2 || true

    # Round-3 finding #6 / round-6 finding #9: pick the issue-number
    # positional out of a possibly flag-laden argv. Earlier rounds used
    # a fixed flag-arity skip list which silently bypassed new flags
    # added to any verb routed through this helper. Switch to a
    # two-pass strategy keyed off `-*` tokens, which future-proofs
    # against new flags (e.g. a future `-c|--comment` on cmd_close /
    # cmd_reopen) without an explicit update here:
    #   pass 1 (trailing): scan everything after the LAST `-*` for
    #     the first numeric token. Covers the canonical
    #     `verb -t "Foo" 42` form.
    #   pass 2 (leading):  if no numeric was found in pass 1, scan
    #     everything before the FIRST `-*`. Covers the canonical
    #     `verb 42 -t "Foo"` form. Run only as a fallback so a
    #     numeric flag value (`-t 42 100`) is never picked.
    local first_flag_pos=-1
    local last_flag_pos=-1
    local idx=-1
    local arg stripped
    for arg in "$@"; do
        idx=$((idx + 1))
        if [[ "$arg" == -* ]]; then
            if [[ "$first_flag_pos" -eq -1 ]]; then
                first_flag_pos=$idx
            fi
            last_flag_pos=$idx
        fi
    done

    # Pass 1: trailing positionals (everything after the last `-*`).
    local found_num=""
    idx=-1
    for arg in "$@"; do
        idx=$((idx + 1))
        if [[ "$idx" -le "$last_flag_pos" ]]; then continue; fi
        stripped="${arg#\#}"
        if [[ "$stripped" =~ ^[0-9]+$ ]]; then
            found_num="$stripped"
            break
        fi
    done

    # Pass 2 (fallback): leading positionals (everything before the
    # first `-*`). Covers `zh epic close 42 -t "Foo"` style invocations
    # where the issue number precedes all flags.
    if [[ -z "$found_num" ]] && [[ "$first_flag_pos" -gt 0 ]]; then
        idx=-1
        for arg in "$@"; do
            idx=$((idx + 1))
            if [[ "$idx" -ge "$first_flag_pos" ]]; then break; fi
            stripped="${arg#\#}"
            if [[ "$stripped" =~ ^[0-9]+$ ]]; then
                found_num="$stripped"
                break
            fi
        done
    fi

    if [[ -z "$found_num" ]]; then
        return 0
    fi

    load_config
    # Round-3 finding #1: extend the fail-soft envelope to the
    # OUTER round-trips. get_repo_info and get_repo_id both call
    # zh_graphql, which `error`s and exits 1 on `.errors`. The
    # round-2 envelope only protected the inner call inside
    # zh_hierarchy_warn_type_mismatch; a transient ZenHub
    # outage on these outer lookups still killed cmd_close /
    # cmd_reopen / cmd_update_issue. Wrap them the same way.
    local owner_repo="" repo_id=""
    owner_repo=$(get_repo_info 2>/dev/null) || return 0
    if [[ -z "$owner_repo" ]]; then return 0; fi
    repo_id=$(get_repo_id "$owner_repo" 2>/dev/null) || return 0
    if [[ -z "$repo_id" ]]; then return 0; fi
    zh_hierarchy_warn_type_mismatch "$expected_type" "$found_num" "$repo_id" "$verb"
    return 0
}

# v1.9.1 items #2 and #9: emit a warning when the issue's actual type does
# not match the noun the user invoked. Returns 0 either way; never errors.
# Used by show/update/close/reopen so all four planning-noun verbs share
# the same mismatch surface. The query is intentionally minimal
# (issueType.name only) so we add at most one tiny round-trip per call.
#
# Round-2 finding #1: fail SOFT on any zh_graphql failure. The helper
# runs ahead of cmd_close / cmd_reopen / cmd_update_issue, and those
# verbs do not require a healthy ZenHub API (cmd_close is `gh issue
# close`). A transient ZenHub outage must NOT block the close. We
# swallow the network call's stderr and return 0 if it failed.
zh_hierarchy_warn_type_mismatch() {
    local expected_type="$1"
    local issue_num="$2"
    local repo_id="$3"
    local verb="${4:-show}"

    local query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            issueType {
                __typename
                ... on GithubIssueType { name }
                ... on ZenhubIssueType { name }
            }
        }
    }'
    local variables
    variables=$(jq -n --arg repo_id "$repo_id" --argjson n "$issue_num" \
        '{repoId: $repo_id, issueNumber: $n}')

    # Fail-soft envelope: zh_graphql `error`s and exits 1 on any .errors
    # in the response. Under `set -euo pipefail` that would kill the
    # caller. We capture into `response`, suppress stderr, and if the
    # call failed for ANY reason (network, auth, parse, .errors) we
    # silently return without warning. The user invoked close / reopen /
    # update / show; not warning is the right failure mode.
    local response=""
    response=$(zh_graphql "$query" "$variables" 2>/dev/null) || return 0

    local actual_type
    actual_type=$(echo "$response" | jq -r '.data.issueByInfo.issueType.name // empty')

    # An untyped issue is not a mismatch worth warning about: the user
    # either has not set a type or the type field is unavailable. The
    # planning-noun create path is the place to enforce a type; here we
    # just surface real mismatches.
    if [[ -z "$actual_type" ]]; then
        return 0
    fi

    # Case-insensitive comparison so `zh epic show` against an issue
    # typed "epic" (the API returns the configured casing) does not
    # falsely warn.
    local expected_lower actual_lower
    expected_lower=$(to_lower "$expected_type")
    actual_lower=$(to_lower "$actual_type")
    if [[ "$expected_lower" == "$actual_lower" ]]; then
        return 0
    fi

    # Round-3 finding #2: only emit a noun-typed redirect when the
    # actual type is one the dispatcher recognizes (Initiative /
    # Project / Epic / Sub-task). Bug / Feature / Task / any other
    # board-level type has no dedicated dispatcher arm, so suggesting
    # `zh bug show 42` would just produce "Unknown command: bug". For
    # those types, route the user to the generic `zh issue` view (which
    # works for every type).
    local actual_lower_norm
    actual_lower_norm=$(to_lower "$actual_type")
    local actual_display redirect
    case "$actual_lower_norm" in
        initiative|project|epic|sub-task|subtask)
            actual_display=$(zh_display_noun_for_type "$actual_type")
            redirect="zh ${actual_display} ${verb} ${issue_num}"
            ;;
        *)
            # Round-6 finding #11: pick the top-level verb that
            # matches the user's intent. `close` and `reopen` exist as
            # generic top-level verbs and would actually do what the
            # user asked for a Bug / Feature / Task. For show / update
            # / unknown verbs there's no top-level destructive analog,
            # so fall back to the generic `zh issue` view.
            case "$verb" in
                close)
                    redirect="zh close ${issue_num}"
                    ;;
                reopen)
                    redirect="zh reopen ${issue_num}"
                    ;;
                update)
                    # v1.9.2 round-7 finding #14: `update` against a
                    # non-planning type (Bug/Feature/Task) cannot
                    # redirect to a read-only `zh issue N`. There is
                    # no top-level `zh update N` verb today. The
                    # right user action is either to leave the type
                    # alone (board-level types don't have an update
                    # path on this CLI) or to retype first. Suppress
                    # the redirect entirely for this case — the
                    # update already applied to the underlying issue
                    # so the operator only needs the typing mismatch
                    # noted, not a misleading "next time use 'zh
                    # issue 42'" instruction.
                    redirect=""
                    ;;
                *)
                    redirect="zh issue ${issue_num}"
                    ;;
            esac
            ;;
    esac
    # Round-4 finding #5: the "data still rendered" wording is only
    # right for `show`. For `close` / `reopen` / `update` the
    # destructive operation already executed (the warn fires before
    # the verb runs, but the verb runs unconditionally). Phrase the
    # warn so the operator does NOT re-run the redirect on a
    # mistakenly-already-closed issue.
    local trailing
    case "$verb" in
        show)
            trailing="The data still rendered, but the matching command is '${redirect}'."
            ;;
        *)
            if [[ -n "$redirect" ]]; then
                trailing="The ${verb} still applied to #${issue_num}; next time the matching command is '${redirect}'."
            else
                # v1.9.2 round-7 finding #14: no good redirect target
                # (e.g. update on a non-planning type). Acknowledge the
                # apply landed and stop there; do not invent a redirect.
                #
                # v1.9.2 round-2 (PR #27) finding #1: the round-1 fix
                # shipped a literal `<NounType>` token in the user-
                # visible message, expecting the operator to mentally
                # substitute. Copy-paste of the suggested command then
                # failed because `<NounType>` is not a valid type name.
                # Use $expected_type so the rendered command is
                # directly runnable.
                trailing="The ${verb} still applied to #${issue_num}. (No matching top-level command exists for ${actual_type}; retype with 'zh type ${issue_num} ${expected_type}' first if you want ${expected_type} semantics.)"
            fi
            ;;
    esac
    warn "Issue #${issue_num} is typed ${actual_type}, not ${expected_type}. ${trailing}"
}

# <noun> show: show an issue (with its issue-type) plus its child issues.
# Reads the canonical githubChildIssues connection (same one cmd_subissue_list
# and cmd_issue use); see the cmd_create header comment for why every reader
# in the codebase converged on it.
cmd_hierarchy_show() {
    local type_name="$1"
    # v1.9.1 item #11: display noun.
    local display_noun="$2"
    local issue_num="${3:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh ${display_noun} show <issue#>"
    fi

    issue_num="${issue_num#\#}"

    # Header: reuse cmd_issue for the full single-issue detail (type, level,
    # parent, etc.).
    cmd_issue "$issue_num"

    load_config
    local owner_repo repo_id workspace_id
    owner_repo=$(get_repo_info)
    repo_id=$(get_repo_id "$owner_repo")
    workspace_id=$(get_workspace_id "$owner_repo")

    # v1.9.1 item #2: warn when the issue's actual type does not match the
    # noun the user invoked (e.g. `zh epic show 42` against a Bug). The
    # render still proceeds (a hard error would lose access to the issue
    # body and children), but the warning surfaces the mismatch with a
    # ready-to-use redirect to the right noun's show verb.
    zh_hierarchy_warn_type_mismatch "$type_name" "$issue_num" "$repo_id" "show"

    # We fetch the issue body and the per-child pipeline so the new
    # `<noun> show` covers what the deleted cmd_epic_show used to render
    # (review note: information regression). Body shows on the parent
    # block; per-child pipeline is added to the children table column set.
    local query='
    query($repoId: ID!, $issueNumber: Int!, $workspaceId: ID!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            number
            body
            githubChildIssues(first: 100) {
                totalCount
                nodes {
                    number
                    title
                    state
                    assignees { nodes { login } }
                    pipelineIssue(workspaceId: $workspaceId) {
                        pipeline { name }
                    }
                    repository { ownerName name }
                }
            }
        }
    }'

    local variables
    variables=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" --arg ws "$workspace_id" \
        '{repoId: $repo_id, issueNumber: $issue_num, workspaceId: $ws}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local body
    body=$(echo "$response" | jq -r '.data.issueByInfo.body // ""')
    if [[ -n "$body" ]] && [[ "$body" != "null" ]]; then
        echo -e "${BOLD}Body:${NC}"
        echo ""
        # printf, not echo, so a body whose first line starts with -e /
        # -n / -E is not interpreted as a flag by the bash builtin and
        # rendered blank. Review finding round-3 #6.
        printf '%s\n' "$body" | sed 's/^/  /'
        echo ""
    fi

    local child_count
    child_count=$(echo "$response" | jq -r '.data.issueByInfo.githubChildIssues.totalCount // 0')

    echo -e "${BOLD}Children (${child_count}):${NC}"
    echo ""
    if [[ "$child_count" -eq 0 ]]; then
        echo "  No child issues"
        echo ""
        return
    fi

    echo "$response" | jq -r '.data.issueByInfo.githubChildIssues.nodes[] |
        "\(.number)\t\(.state)\t\(.pipelineIssue.pipeline.name // "-")\t\([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end)\t\(.title)"' | \
        while IFS=$'\t' read -r num istate pipeline assignees ititle; do
            local marker="  "
            local color="$NC"
            if [[ "$istate" == "CLOSED" ]]; then
                marker="✓ "
                color="$YELLOW"
            fi
            printf "  ${BOLD}#%-5s${NC} │ %-18s │ %-15s │ ${color}%s%s${NC}\n" \
                "$num" "${pipeline:0:18}" "${assignees:0:15}" "$marker" "$ititle"
        done
    echo ""

    # Coverage warning (review finding round-3 #7). The query caps at
    # first: 100; if the total exceeds the rendered set, say so
    # explicitly so a planner counting open children does not close an
    # epic prematurely. Symmetric with cmd_hierarchy_list's warn.
    local fetched
    fetched=$(echo "$response" | jq -r '.data.issueByInfo.githubChildIssues.nodes | length')
    if [[ "$child_count" -gt "$fetched" ]]; then
        warn "Showing first ${fetched} of ${child_count} children (the query caps at 100; remaining are not displayed). Use 'zh subissue list ${issue_num}' for the full set."
    fi
}

# Dispatch a planning-noun subcommand. Create/list/show are noun-specific;
# add/remove/update/close/reopen are thin pass-throughs to the existing issue
# and sub-issue verbs (an epic add IS a sub-issue add).
cmd_hierarchy_dispatch() {
    # load_config so every dispatched arm sees ZH_TOKEN from the config
    # file. Most arms (create/list/show/update/close/reopen) call
    # load_config themselves, but `add`/`remove` route directly to
    # cmd_subissue_add / cmd_subissue_remove which do not (only the
    # top-level cmd_subissue does). Without this, under `set -u` the
    # first zh_graphql call from those arms would die on an unbound
    # ZH_TOKEN instead of the friendly "ZH_TOKEN not set" error. Review
    # finding #4.
    load_config

    local type_name="$1"
    shift || true

    # v1.9.1 item #11: display noun is the second positional argument and
    # is separate from the ZenHub issue-type name (see the cmd_initiative/
    # project/epic/subtask aliases for why: "Sub-task" matches the
    # configured issue-type, but the user-facing command is `subtask`).
    local lower="$1"
    shift || true

    local sub="${1:-}"
    shift || true

    case "$sub" in
        create|new)
            cmd_hierarchy_create "$type_name" "$lower" "$@"
            ;;
        list|ls)
            # Reject stray positionals so a user reaching for
            # 'zh epic list 42' (expecting a sub-issue listing for #42)
            # gets a clear redirect instead of having the 42 silently
            # discarded. Review finding round-3 #10.
            if [[ $# -gt 0 ]]; then
                error "zh ${lower} list takes no arguments (got ${#} extra: $*). Did you mean 'zh subissue list <parent#>' to see the children of an issue, or 'zh ${lower} show <issue#>' to view a single ${type_name} issue?"
            fi
            cmd_hierarchy_list "$type_name" "$lower"
            ;;
        show|view)
            cmd_hierarchy_show "$type_name" "$lower" "$@"
            ;;
        add)
            # <noun> add <parent#> <child#> ... == sub-issue add
            cmd_subissue_add "$@"
            ;;
        remove|rm)
            cmd_subissue_remove "$@"
            ;;
        update|edit|modify)
            # v1.9.1 item #9: warn if the issue's actual type does not
            # match the noun. The user may still be deliberately editing
            # the title/body of a mistyped issue, so this is advisory
            # rather than blocking (mirrors the `show` arm). Round-2
            # finding #4: the verb name routes into the warn line's
            # redirect so the user is pointed at `zh <noun> update`
            # rather than always `zh <noun> show`.
            zh_hierarchy_warn_for_noun "$type_name" "update" "$@"
            cmd_update_issue "$@"
            ;;
        close)
            zh_hierarchy_warn_for_noun "$type_name" "close" "$@"
            cmd_close "$@"
            ;;
        reopen|open)
            zh_hierarchy_warn_for_noun "$type_name" "reopen" "$@"
            cmd_reopen "$@"
            ;;
        delete)
            # Friendly redirect: old `zh epic delete` is gone (epics are now
            # real issues, so deletion is the standard `zh delete <issue#>`).
            # A user reaching for the old verb with a still-valid issue
            # number should get an instruction, not a fall-through to the
            # generic "Unknown subcommand" message that could mislead.
            # Review finding #8.
            error "'zh ${lower} delete' is no longer a verb (${type_name} is a normal issue in the v1.9.0 model). Use 'zh delete <issue#>' instead (DANGER: irreversible; prefer 'zh ${lower} close <issue#>')."
            ;;
        ""|help|-h|--help)
            cat <<EOF
zh ${lower} - Manage ${type_name} issues (issue-type + sub-issue model)

USAGE:
    zh ${lower} <subcommand> [args]

SUBCOMMANDS:
    create "Title" [opts]          Create an issue with type ${type_name}
                                     -d, --description <text>
                                     -l, --labels <comma-separated>
                                     -p, --pipeline <name>
                                     --json | -q   (machine-readable output)
    list                           List issues of type ${type_name}
    show <issue#>                  Show an issue + its sub-issues
    add <parent#> <child#> [...]   Attach sub-issues (addSubIssues)
    remove <parent#> <child#> [...] Detach sub-issues
    update <issue#> [opts]         Edit title/body
                                     -t, --title <text>
                                     -d, --description <text>
    close <issue#> [comment]       Close the issue
    reopen <issue#>                Reopen the issue

NOTES:
    A ${type_name} is a normal GitHub issue whose ZenHub issue-type is
    ${type_name}. It has an ordinary #number and issue URL. Children are
    wired with Sub-Issues (the same mechanism as 'zh subissue').
EOF
            ;;
        *)
            error "Unknown ${lower} subcommand: ${sub}

Run 'zh ${lower} help' for usage information."
            ;;
    esac
}

# Edit an existing issue's title and/or body (used by <noun> update). Wraps
# updateIssue. Kept generic so every planning noun shares one implementation.
cmd_update_issue() {
    load_config

    local issue_num=""
    local title=""
    local body=""
    local title_set="false"
    local body_set="false"

    # Round-6 finding #3: accept `--title=Foo` and `--description=Bar`
    # GNU-style. Same normalization (and empty-value rejection) as
    # cmd_create and cmd_hierarchy_create. Without this, the equals
    # form falls into `*)` and gets captured as the issue number,
    # which then fails the numeric validation with the misleading
    # "Invalid issue number: --title=Foo".
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == --*=* ]]; then
            local _unorm_flag="${1%%=*}"
            local _unorm_val="${1#*=}"
            if [[ -z "$_unorm_val" ]]; then
                error "Option ${_unorm_flag} requires a value (received empty string from '${1}')"
            fi
            set -- "$_unorm_flag" "$_unorm_val" "${@:2}"
        fi
        case "$1" in
            -t|--title)
                if [[ $# -lt 2 ]]; then error "Option ${1} requires a value"; fi
                title="$2"; title_set="true"; shift 2
                ;;
            -d|--description|-b|--body)
                if [[ $# -lt 2 ]]; then error "Option ${1} requires a value"; fi
                body="$2"; body_set="true"; shift 2
                ;;
            *)
                if [[ -z "$issue_num" ]]; then issue_num="$1"; fi
                shift
                ;;
        esac
    done

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh <noun> update <issue#> [-t \"New Title\"] [-d \"New body\"]
At least one of -t (title) or -d (description) must be provided."
    fi
    if [[ "$title_set" != "true" && "$body_set" != "true" ]]; then
        error "Nothing to update: provide -t (title) and/or -d (description)."
    fi

    issue_num="${issue_num#\#}"
    if ! [[ "$issue_num" =~ ^[0-9]+$ ]]; then
        error "Invalid issue number: ${issue_num}"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local issue_id
    issue_id=$(zh_resolve_issue_id "$repo_id" "$issue_num")

    info "Updating #${issue_num}..."

    local input_json
    input_json=$(jq -n --arg id "$issue_id" '{issueId: $id}')
    if [[ "$title_set" == "true" ]]; then
        input_json=$(echo "$input_json" | jq --arg t "$title" '. + {title: $t}')
    fi
    if [[ "$body_set" == "true" ]]; then
        input_json=$(echo "$input_json" | jq --arg b "$body" '. + {body: $b}')
    fi

    local mutation_vars
    mutation_vars=$(jq -n --argjson input "$input_json" '{input: $input}')

    local mutation='
    mutation($input: UpdateIssueInput!) {
        updateIssue(input: $input) {
            issue { number title }
        }
    }'

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local resulting_title
    resulting_title=$(echo "$response" | jq -r '.data.updateIssue.issue.title // empty')
    if [[ -z "$resulting_title" ]]; then
        error "Failed to update #${issue_num}: $(echo "$response" | jq -r '.errors[0].message // "unknown error"')"
    fi

    echo ""
    success "Updated #${issue_num}: ${resulting_title}"
}

# Thin noun aliases. Each names a planning level; the engine does the work.
# The optional second argument is the command-display noun (used in Tips,
# Usage strings, redirects, help). It defaults to `to_lower(type_name)`,
# which is right for Initiative/Project/Epic. v1.9.1 item #11 splits it
# from the ZenHub issue-type name for Sub-task: the type stays "Sub-task"
# (matches the configured ZenhubIssueType), but the user-facing command is
# `subtask` everywhere (hyphenless), matching the canonical dispatcher
# verb. The hyphenated `sub-task` remains a permanent dispatcher alias for
# back-compat with anyone copy-pasting the pre-fix Tip text.
cmd_initiative() { cmd_hierarchy_dispatch "Initiative" "initiative" "$@"; }
cmd_project()    { cmd_hierarchy_dispatch "Project" "project" "$@"; }
cmd_epic()       { cmd_hierarchy_dispatch "Epic" "epic" "$@"; }
cmd_subtask()    { cmd_hierarchy_dispatch "Sub-task" "subtask" "$@"; }

# =============================================================================
# Sprint commands (v1.6.0)
#
# Inspired by the design proposed in PR #2 by @jeremiahrose. v1.6.0 ships
# read-only sprint visibility (list / show / current); sprint membership
# mutations (sprint-add / sprint-remove) are deferred to a follow-up.
# =============================================================================

# Pagination cap for sprint walks (50 pages × 50 nodes = 2500 sprints,
# vastly more than any realistic workspace). Belt-and-suspenders against
# a server-side cursor bug.
ZH_SPRINT_PAGINATION_CAP=50

# Walk every page of `workspace.sprints` and emit one combined JSON
# document on stdout. Output shape matches a single-page response so
# downstream jq filters don't need to know the listing was paginated.
#
#   { workspace_name, active_sprint_id, nodes: [...] }
#
# `state_filter` is optional; pass "OPEN" to filter to open sprints,
# anything else to fetch all.
zh_sprints_fetch_all() {
    local workspace_id="$1"
    local state_filter="${2:-}"

    local query
    if [[ "$state_filter" == "OPEN" ]]; then
        query='
        query($workspaceId: ID!, $after: String) {
            workspace(id: $workspaceId) {
                name
                activeSprint { id }
                sprints(first: 50, after: $after, filters: { state: { eq: OPEN } }) {
                    pageInfo { hasNextPage endCursor }
                    nodes {
                        id
                        name
                        state
                        startAt
                        endAt
                        completedPoints
                        totalPoints
                        closedIssuesCount
                    }
                }
            }
        }'
    else
        query='
        query($workspaceId: ID!, $after: String) {
            workspace(id: $workspaceId) {
                name
                activeSprint { id }
                sprints(first: 50, after: $after) {
                    pageInfo { hasNextPage endCursor }
                    nodes {
                        id
                        name
                        state
                        startAt
                        endAt
                        completedPoints
                        totalPoints
                        closedIssuesCount
                    }
                }
            }
        }'
    fi

    local cursor="null"
    local last_cursor=""
    local iterations=0
    local all_nodes="[]"
    local workspace_name=""
    local active_sprint_id=""
    local first_page=true
    # Round-6 #11: emit a `pagination_bailed` sentinel so callers
    # like zh_resolve_sprint_id can downgrade their "not found"
    # messaging when the walk was incomplete.
    local pagination_bailed=""

    while :; do
        iterations=$((iterations + 1))
        if [[ "$iterations" -gt "$ZH_SPRINT_PAGINATION_CAP" ]]; then
            warn "Sprint pagination iteration cap (${ZH_SPRINT_PAGINATION_CAP}) reached"
            pagination_bailed="iteration_cap"
            break
        fi

        local variables
        variables=$(jq -n --arg workspace_id "$workspace_id" --argjson after "$cursor" \
            '{workspaceId: $workspace_id, after: $after}')

        local response
        response=$(zh_graphql "$query" "$variables")

        # Defensive null-workspace detection. `data.workspace = null`
        # signals a deleted / ACL-revoked workspace, distinct from an
        # empty-but-real workspace (which returns a non-null Workspace
        # with `sprints.nodes = []`). Pre-fix the jq `// fallback`
        # forms below silently collapsed null → empty, indistinguishable
        # from real empty. Matches the SPEC of the Python `list_sprints`
        # walker.
        local workspace_kind
        workspace_kind=$(echo "$response" | jq -r '.data.workspace | type')
        if [[ "$workspace_kind" == "null" ]]; then
            error "Workspace '${workspace_id}' resolved to null (deleted, ACL-revoked, or otherwise inaccessible)"
        fi

        if [[ "$first_page" == "true" ]]; then
            workspace_name=$(echo "$response" | jq -r '.data.workspace.name // ""')
            active_sprint_id=$(echo "$response" | jq -r '.data.workspace.activeSprint.id // empty')
            first_page=false
        fi

        # `select(. != null)` skips null page entries (same SPEC the
        # Python walker enforces); the `// []` keeps the whole array
        # access null-safe.
        local page_nodes
        page_nodes=$(echo "$response" | jq -c '[(.data.workspace.sprints.nodes // [])[] | select(. != null)]')
        all_nodes=$(jq -n --argjson a "$all_nodes" --argjson b "$page_nodes" '$a + $b')

        local has_next end_cursor
        has_next=$(echo "$response" | jq -r '.data.workspace.sprints.pageInfo.hasNextPage // false')
        end_cursor=$(echo "$response" | jq -r '.data.workspace.sprints.pageInfo.endCursor // ""')

        if [[ "$has_next" != "true" ]]; then
            break
        fi
        if [[ -z "$end_cursor" || "$end_cursor" == "$last_cursor" ]]; then
            warn "Sprint pagination cursor not advancing — bailing"
            pagination_bailed="stuck_cursor"
            break
        fi
        last_cursor="$end_cursor"
        cursor=$(jq -n --arg c "$end_cursor" '$c')
    done

    jq -n \
        --arg workspace_name "$workspace_name" \
        --arg active_sprint_id "$active_sprint_id" \
        --argjson nodes "$all_nodes" \
        --arg pagination_bailed "$pagination_bailed" \
        '{workspace_name: $workspace_name, active_sprint_id: $active_sprint_id, nodes: $nodes, pagination_bailed: $pagination_bailed}'
}

cmd_sprints() {
    load_config

    local owner_repo
    owner_repo=$(get_repo_info)

    local show_all=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a)
                show_all=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    info "Getting sprints..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local sprints_json
    if [[ "$show_all" == "true" ]]; then
        sprints_json=$(zh_sprints_fetch_all "$workspace_id" "")
    else
        sprints_json=$(zh_sprints_fetch_all "$workspace_id" "OPEN")
    fi

    local workspace_name active_sprint_id count
    workspace_name=$(echo "$sprints_json" | jq -r '.workspace_name')
    active_sprint_id=$(echo "$sprints_json" | jq -r '.active_sprint_id // empty')
    count=$(echo "$sprints_json" | jq '.nodes | length')

    echo ""
    if [[ "$show_all" == "true" ]]; then
        echo -e "${BOLD}Sprints in ${workspace_name}${NC} (${count} total)"
    else
        echo -e "${BOLD}Sprints in ${workspace_name}${NC} (${count} open)"
    fi
    echo ""

    if [[ "$count" -eq 0 ]]; then
        echo "  No sprints found"
    else
        echo "$sprints_json" | jq -r --arg active_id "$active_sprint_id" '.nodes[] |
            "\(.id)" as $id |
            "\(.startAt[:10] // "?")" as $start |
            "\(.endAt[:10] // "?")" as $end |
            "  \(if $id == $active_id then "● " else "  " end)\(.name)\n    \(.state) │ \($start) → \($end) │ \(.completedPoints // 0)/\(.totalPoints // 0) pts │ \(.closedIssuesCount) closed\n"'
    fi

    echo -e "${CYAN}Tip:${NC} Use 'zh sprint <name>' to view issues in a sprint"
    if [[ "$show_all" != "true" ]]; then
        echo -e "${CYAN}Tip:${NC} Use --all to include closed sprints"
    fi
    echo ""
}

# Walk every page of a sprint's `sprintIssues` connection and emit a
# combined JSON document. Shape matches a single-page response so
# downstream jq filters don't need to know it was paginated.
#
#   { nodes: [ { issue: {...} }, ... ] }
zh_sprint_issues_fetch_all() {
    # Arguments:
    #   $1 — sprint_id
    #   $2 — soft_null flag (optional). Default "" calls `error` on a
    #        null-node response, which exits the process with a clear
    #        message. Passing "1" makes the walker SOFT-FAIL on null
    #        node: it stops walking and returns an empty-nodes JSON
    #        document with `null_node: true` so callers downstream of
    #        a mutation can present a "mutation may have landed; post-
    #        state could not be confirmed" message instead of
    #        crashing mid-recovery. (Round-4 finding #1.)
    #   $3 — owner_repo (optional). When supplied, `walked_nums` is
    #        repo-filtered: only issue numbers belonging to this
    #        owner/repo land in the emitted walked_nums array.
    #        Mirrors the Python round-6 #1 fix — without this filter,
    #        cross-repo same-number issues in a multi-repo sprint
    #        trivially satisfied "walked AND not still-attached" and
    #        inflated cmd_sprint_remove's confirmed-removal set.
    #        Default unset = no repo filtering (back-compat for
    #        cmd_sprint which doesn't need it). Round-6 #2.
    local sprint_id="$1"
    local soft_null="${2:-}"
    local owner_repo_filter="${3:-}"

    # Pagination-warning sentinel, similar to soft-null. Empty by
    # default; set when the walk bails on stuck cursor / iteration
    # cap so callers can downgrade their success messaging the same
    # way the Python `inspected_full=False` branch does.
    # (Round-4 finding #3.)
    local pagination_bailed=""

    local query='
    query($sprintId: ID!, $after: String) {
        node(id: $sprintId) {
            ... on Sprint {
                sprintIssues(first: 100, after: $after) {
                    pageInfo { hasNextPage endCursor }
                    nodes {
                        issue {
                            number
                            title
                            state
                            htmlUrl
                            estimate { value }
                            assignees { nodes { login } }
                            repository { ownerName name }
                            pipelineIssues { nodes { pipeline { name } } }
                        }
                    }
                }
            }
        }
    }'

    local cursor="null"
    local last_cursor=""
    local iterations=0
    local all_nodes="[]"
    local null_node="false"

    while :; do
        iterations=$((iterations + 1))
        if [[ "$iterations" -gt 200 ]]; then
            warn "Sprint-issues pagination iteration cap (200) reached"
            pagination_bailed="iteration_cap"
            break
        fi

        local variables
        variables=$(jq -n --arg sprint_id "$sprint_id" --argjson after "$cursor" \
            '{sprintId: $sprint_id, after: $after}')

        local response
        response=$(zh_graphql "$query" "$variables")

        # Detect null node before treating empty `nodes` as authoritative.
        # GraphQL returns `data.node = null` when the sprint is deleted,
        # ACL-revoked, or otherwise inaccessible. Pre-fix the walker
        # silently emitted an empty result, which downstream callers
        # treated as "real empty sprint" — masking the failure.
        #
        # When called from cmd_sprint_remove (mutation has already
        # fired), we soft-fail: emit a sentinel JSON the caller uses
        # to print a "post-state could not be confirmed" message
        # rather than crashing the whole process. (Round-4 #1.)
        local node_kind
        node_kind=$(echo "$response" | jq -r '.data.node | type')
        if [[ "$node_kind" == "null" ]]; then
            if [[ "$soft_null" == "1" ]]; then
                null_node="true"
                break
            fi
            error "Sprint '${sprint_id}' resolved to null (deleted, ACL-revoked, or otherwise inaccessible)"
        fi

        # `select(. != null)` strips null page entries before
        # aggregating. The Python walker now skips null wrappers
        # (round-4 #4); this is the bash mirror. Without it,
        # downstream `.nodes[].issue` would emit phantom `null`
        # lines for each null wrapper.
        local page_nodes
        page_nodes=$(echo "$response" | jq -c '[(.data.node.sprintIssues.nodes // [])[] | select(. != null)]')
        all_nodes=$(jq -n --argjson a "$all_nodes" --argjson b "$page_nodes" '$a + $b')

        local has_next end_cursor
        has_next=$(echo "$response" | jq -r '.data.node.sprintIssues.pageInfo.hasNextPage // false')
        end_cursor=$(echo "$response" | jq -r '.data.node.sprintIssues.pageInfo.endCursor // ""')

        if [[ "$has_next" != "true" ]]; then
            break
        fi
        if [[ -z "$end_cursor" || "$end_cursor" == "$last_cursor" ]]; then
            warn "Sprint-issues pagination cursor not advancing — bailing"
            pagination_bailed="stuck_cursor"
            break
        fi
        last_cursor="$end_cursor"
        cursor=$(jq -n --arg c "$end_cursor" '$c')
    done

    # Output: a JSON object the caller can downcast into nodes +
    # `pagination_bailed` reason + `null_node` flag + `walked_nums`.
    # The default caller (`cmd_sprint`, read-only) uses just nodes.
    # The mutation caller (`cmd_sprint_remove`) inspects the others
    # to decide whether to claim a confirmed success.
    #
    # `walked_nums` is the list of issue numbers the walker iterated.
    # Load-bearing for the round-5 #1/#2 succeeded-inflation fix:
    # cmd_sprint_remove uses `inputs ∩ walked_nums - still_attached`
    # for `succeeded` instead of `inputs - still_attached`, so an
    # input the walker never reached can't be falsely classified as
    # removed.
    #
    # Round-6 #2: when an owner_repo filter is supplied, restrict
    # walked_nums to issues in that repo. A cross-repo same-number
    # issue is "walked" but its absence from still_attached (which
    # IS repo-filtered) doesn't mean OUR same-numbered issue was
    # removed — they're different issues. Restricting walked_nums
    # to our repo keeps the set comparable to still_attached.
    local walked_nums
    if [[ -n "$owner_repo_filter" ]]; then
        local owner_lc="${owner_repo_filter%%/*}"
        local repo_lc="${owner_repo_filter##*/}"
        walked_nums=$(echo "$all_nodes" | jq -c \
            --arg owner "$owner_lc" \
            --arg repo "$repo_lc" \
            '[.[]
              | select(
                  ((.issue.repository.ownerName // "") | ascii_downcase) == ($owner | ascii_downcase)
                  and ((.issue.repository.name // "") | ascii_downcase) == ($repo | ascii_downcase)
                )
              | .issue.number
              | select(. != null)]')
    else
        walked_nums=$(echo "$all_nodes" | jq -c '[.[] | .issue.number | select(. != null)]')
    fi

    jq -n \
        --argjson nodes "$all_nodes" \
        --arg pagination_bailed "$pagination_bailed" \
        --argjson null_node "$null_node" \
        --argjson walked_nums "$walked_nums" \
        '{
           nodes: $nodes,
           pagination_bailed: $pagination_bailed,
           null_node: $null_node,
           walked_nums: $walked_nums
         }'
}

cmd_sprint() {
    load_config

    local sprint_name=""
    local show_urls=true

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-urls)
                show_urls=false
                shift
                ;;
            *)
                if [[ -z "$sprint_name" ]]; then
                    sprint_name="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$sprint_name" ]]; then
        error "Usage: zh sprint <name> [--no-urls]

View issues in a sprint.

Examples:
  zh sprint \"Sprint 5\"
  zh sprint current          # View active sprint
  zh sprint current --no-urls"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting sprint details..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # Resolve sprint id by name (case-insensitive) or current/active.
    # Walk every page of sprints so a workspace with >50 sprints can
    # still resolve older names (review finding #5).
    local sprints_json
    sprints_json=$(zh_sprints_fetch_all "$workspace_id" "")

    local sprint_id
    if [[ "$sprint_name" == "current" ]] || [[ "$sprint_name" == "active" ]]; then
        sprint_id=$(echo "$sprints_json" | jq -r '.active_sprint_id // empty')
        if [[ -z "$sprint_id" ]]; then
            error "No active sprint found"
        fi
        sprint_name=$(echo "$sprints_json" | jq -r --arg id "$sprint_id" '.nodes[] | select(.id == $id) | .name' | head -1)
    else
        sprint_id=$(echo "$sprints_json" | jq -r --arg name "$sprint_name" \
            '.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .id' | head -1)

        if [[ -z "$sprint_id" ]]; then
            echo -e "${RED}Error:${NC} Sprint '${sprint_name}' not found." >&2
            echo "" >&2
            echo "Available sprints:" >&2
            echo "$sprints_json" | jq -r '.nodes[] | "  - \(.name) (\(.state))"' >&2
            exit 1
        fi
    fi

    # Fetch sprint header (single page) + paginated sprintIssues.
    local detail_query='
    query($sprintId: ID!) {
        node(id: $sprintId) {
            ... on Sprint {
                id
                name
                description
                state
                startAt
                endAt
                completedPoints
                totalPoints
                closedIssuesCount
            }
        }
    }'

    local detail_vars
    detail_vars=$(jq -n --arg sprint_id "$sprint_id" '{sprintId: $sprint_id}')

    local detail_response
    detail_response=$(zh_graphql "$detail_query" "$detail_vars")

    local issues_json
    issues_json=$(zh_sprint_issues_fetch_all "$sprint_id")

    # Round-6 #13: the read-only sprint view used to silently
    # truncate the issues list under partial coverage. Now mirror
    # cmd_sprint_remove's footer — surface the bail reason so the
    # user knows the listing was incomplete.
    local sprint_pagination_bailed
    sprint_pagination_bailed=$(echo "$issues_json" | jq -r '.pagination_bailed // ""')

    local sprint_state start_at end_at completed_pts total_pts closed_count description
    sprint_state=$(echo "$detail_response" | jq -r '.data.node.state // "UNKNOWN"')
    start_at=$(echo "$detail_response" | jq -r '.data.node.startAt[:10] // "?"')
    end_at=$(echo "$detail_response" | jq -r '.data.node.endAt[:10] // "?"')
    completed_pts=$(echo "$detail_response" | jq -r '.data.node.completedPoints // 0')
    total_pts=$(echo "$detail_response" | jq -r '.data.node.totalPoints // 0')
    closed_count=$(echo "$detail_response" | jq -r '.data.node.closedIssuesCount // 0')
    description=$(echo "$detail_response" | jq -r '.data.node.description // empty')

    local issue_count
    issue_count=$(echo "$issues_json" | jq '.nodes | length')

    echo ""
    # `printf '%s\n'` instead of `echo -e` so backslash sequences in the
    # sprint name (user-controlled) aren't interpreted. Review #12.
    printf "${BOLD}Sprint: %s${NC}\n" "$sprint_name"
    echo ""
    echo -e "  ${CYAN}State:${NC}     ${sprint_state}"
    echo -e "  ${CYAN}Period:${NC}    ${start_at} → ${end_at}"
    echo -e "  ${CYAN}Points:${NC}    ${completed_pts}/${total_pts} completed"
    echo -e "  ${CYAN}Closed:${NC}    ${closed_count} issues"
    if [[ -n "$description" ]]; then
        # Same printf treatment for the description — it's user-typed
        # in ZenHub and may contain backslash sequences (review #12).
        printf "  ${CYAN}Description:${NC} %s\n" "$description"
    fi
    echo ""
    echo -e "${BOLD}Issues (${issue_count}):${NC}"
    echo ""

    if [[ "$issue_count" -eq 0 ]]; then
        echo "  No issues in this sprint"
    else
        if [[ "$show_urls" == "true" ]]; then
            echo "$issues_json" | jq -r '.nodes[].issue |
                "\(.state)" as $state |
                "  #\(.number) │ \(.repository.ownerName)/\(.repository.name) │ \((.estimate.value // "—") | tostring) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end) │ \(.pipelineIssues.nodes[0].pipeline.name // "—")\n    \(if $state == "CLOSED" then "✓ " else "" end)\(.title)\n    → \(.htmlUrl)\n"'
        else
            echo "$issues_json" | jq -r '.nodes[].issue |
                "\(.state)" as $state |
                "  #\(.number)  \((.estimate.value // "—") | tostring) pts │ \([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end) │ \(if $state == "CLOSED" then "✓ " else "  " end)\(.title)"'
        fi
    fi
    echo ""

    # Round-6 #13: footer warning when the issues walk was
    # partial. Exit 2 so scripted callers can branch on it.
    if [[ -n "$sprint_pagination_bailed" ]]; then
        warn "Showing the first ${issue_count} issue(s) only — pagination incomplete: ${sprint_pagination_bailed}."
        warn "  Re-run 'zh sprint show \"${sprint_name}\"' to retry the listing."
        exit 2
    fi
}

cmd_sprint_current() {
    cmd_sprint "current" "$@"
}

# Internal: resolve a sprint name (or current/active) to its GraphQL id.
# Emits "<id>\t<name>" on stdout on success; calls `error` on failure
# (which exits non-zero). Walks every page of sprints so a workspace
# with >50 sprints can still resolve older names.
zh_resolve_sprint_id() {
    local workspace_id="$1"
    local sprint_name="$2"

    local sprints_json
    sprints_json=$(zh_sprints_fetch_all "$workspace_id" "")

    # Round-6 #11: when the sprints listing bailed mid-walk, a
    # "not found" message is misleading — the sprint may exist on
    # an unreached page. Tell the user.
    local listing_bailed
    listing_bailed=$(echo "$sprints_json" | jq -r '.pagination_bailed // ""')

    local sprint_id sprint_actual_name
    if [[ "$sprint_name" == "current" || "$sprint_name" == "active" ]]; then
        sprint_id=$(echo "$sprints_json" | jq -r '.active_sprint_id // empty')
        if [[ -z "$sprint_id" ]]; then
            error "No active sprint found"
        fi
        sprint_actual_name=$(echo "$sprints_json" | jq -r --arg id "$sprint_id" \
            '.nodes[] | select(.id == $id) | .name' | head -1)
    else
        sprint_id=$(echo "$sprints_json" | jq -r --arg name "$sprint_name" \
            '.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .id' | head -1)
        sprint_actual_name=$(echo "$sprints_json" | jq -r --arg name "$sprint_name" \
            '.nodes[] | select((.name | ascii_downcase) == ($name | ascii_downcase)) | .name' | head -1)

        if [[ -z "$sprint_id" ]]; then
            echo -e "${RED}Error:${NC} Sprint '${sprint_name}' not found." >&2
            if [[ -n "$listing_bailed" ]]; then
                echo "" >&2
                echo "  Listing was incomplete due to: ${listing_bailed}." >&2
                echo "  The sprint may exist on an unreached page; try re-running." >&2
            fi
            echo "" >&2
            echo "Available sprints:" >&2
            echo "$sprints_json" | jq -r '.nodes[] | "  - \(.name) (\(.state))"' >&2
            exit 1
        fi
    fi

    printf '%s\t%s\n' "$sprint_id" "$sprint_actual_name"
}

# Resolve every issue number (in the cwd's repo) to its GraphQL id.
# Emits one line per issue on stdout: "<id>\t<number>\t<title>".
# Errors out (non-zero exit) listing every not-found number rather than
# stopping at the first one — same accumulator pattern as
# cmd_subissue_remove's pre-flight.
zh_resolve_issue_ids_for_sprint() {
    local repo_id="$1"
    shift
    local nums=("$@")

    local query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
        }
    }'

    local results=""
    local missing=""
    local num stripped issue_response issue_id issue_title
    # Conditional expansion to keep bash 3.2 + set -u happy when nums
    # happens to be empty (caller normally validates $# > 0 but
    # defensive layering matches round-3 #5).
    for num in ${nums[@]+"${nums[@]}"}; do
        stripped="${num#\#}"
        if ! [[ "$stripped" =~ ^[0-9]+$ ]]; then
            error "Invalid issue number: ${num}"
        fi

        local variables
        variables=$(jq -n --arg repo_id "$repo_id" --argjson n "$stripped" \
            '{repoId: $repo_id, issueNumber: $n}')

        # v1.9.3 pattern-sweep: fail-soft envelope mirroring the
        # subissue-side lookups. cmd_sprint_add / cmd_sprint_remove
        # rely on this helper to build a per-input "missing" list;
        # bailing under set-e on the first transient zh_graphql
        # `.errors` would lose every name discovered before it.
        local _spr_err_file
        _spr_err_file=$(mktemp -t zh_sprresolve.XXXXXX 2>/dev/null) || _spr_err_file=/dev/null
        issue_response=$(zh_graphql "$query" "$variables" 2>"$_spr_err_file") || issue_response=""
        if [[ "$_spr_err_file" != "/dev/null" ]]; then
            rm -f "$_spr_err_file" 2>/dev/null || true
        fi
        if [[ -z "$issue_response" ]]; then
            missing="${missing} #${stripped}"
            continue
        fi
        issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
        issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title // ""')

        if [[ -z "$issue_id" ]]; then
            missing="${missing} #${stripped}"
        else
            # Tab-separated to keep the title intact even if it has
            # spaces.
            results+="${issue_id}	${stripped}	${issue_title}"$'\n'
        fi
    done

    if [[ -n "$missing" ]]; then
        error "Issue(s) not found in this repository:${missing}"
    fi

    printf '%s' "$results"
}

cmd_sprint_add() {
    load_config

    local sprint_name="${1:-}"
    shift || true

    if [[ -z "$sprint_name" ]] || [[ $# -eq 0 ]]; then
        error "Usage: zh sprint add <sprint_name> <issue#> [<issue#> ...]

Add one or more issues to a sprint.

Examples:
  zh sprint add \"Sprint 5\" 42
  zh sprint add current 42 43 44       # Add to active sprint
  zh sprint add active 42              # 'active' is an alias for current"
    fi

    # Dedup the input numbers (preserving first-occurrence order) so a
    # repeated arg can't inflate the success count when the API
    # returns one link per unique issue. Mirrors the Python boundary
    # dedup in add_issues_to_sprint. Uses a plain-array contains-check
    # rather than an associative array so it stays portable to the
    # bash 3.2 that ships on macOS.
    # Bash 3.2 (stock /bin/bash on macOS) errors under `set -u` when
    # an empty array is expanded as "${arr[@]}" — the first iteration
    # of the for-loop below sees `inputs` empty and trips on
    # `inputs[@]: unbound variable`. The `${arr[@]+"${arr[@]}"}` form
    # makes the expansion conditional: it produces nothing when the
    # array is unset/empty, so the inner loop is a no-op on the first
    # iteration. Bash 4.4+ fixed this behaviour but the script ships
    # to macOS too.
    local -a inputs=()
    local raw_num stripped_arg seen_num
    for raw_num in "$@"; do
        stripped_arg="${raw_num#\#}"
        local already_seen=false
        for seen_num in ${inputs[@]+"${inputs[@]}"}; do
            if [[ "$seen_num" == "$stripped_arg" ]]; then
                already_seen=true
                break
            fi
        done
        if [[ "$already_seen" != "true" ]]; then
            inputs+=("$stripped_arg")
        fi
    done
    set -- ${inputs[@]+"${inputs[@]}"}

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    info "Resolving sprint '${sprint_name}'..."
    local sprint_resolved sprint_id sprint_actual_name
    sprint_resolved=$(zh_resolve_sprint_id "$workspace_id" "$sprint_name")
    sprint_id=$(echo "$sprint_resolved" | cut -f1)
    sprint_actual_name=$(echo "$sprint_resolved" | cut -f2)

    info "Resolving ${#} issue(s)..."
    local issues_resolved
    issues_resolved=$(zh_resolve_issue_ids_for_sprint "$repo_id" "$@")

    # Build JSON array of issue ids from the tab-separated result.
    local issue_ids_json
    issue_ids_json=$(echo "$issues_resolved" | awk -F'\t' 'NF >= 1 {print $1}' | jq -R . | jq -s .)

    # Fire the mutation. Ask for sprintIssues back so we can detect
    # partial failures (the API doesn't return failedIssues for this
    # mutation — anything not in the response inferred-failed).
    # Project repository on each link so we can filter by repo before
    # crediting numbers — sibling repos can share issue numbers in a
    # multi-repo workspace.
    local mutation='
    mutation($input: AddIssuesToSprintsInput!) {
        addIssuesToSprints(input: $input) {
            sprintIssues {
                issue {
                    number
                    repository { ownerName name }
                }
                sprint { id }
            }
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg sprint_id "$sprint_id" --argjson issue_ids "$issue_ids_json" \
        '{input: {sprintIds: [$sprint_id], issueIds: $issue_ids}}')

    # v1.9.3 pattern-sweep: fail-soft envelope mirroring the
    # cmd_subissue_add (zh:5971) and cmd_set_type (zh:3762) pattern.
    # Under set-e a bare assignment died when zh_graphql exited 1 on a
    # `.errors` response, aborting cmd_sprint_add before the partial-
    # applied gate below could classify the outcome. With this envelope
    # the partial classifier stays reachable; an empty response is a
    # hard failure surfaced with the cause hint.
    local response="" response_err=""
    local _sprintadd_err_file
    _sprintadd_err_file=$(mktemp -t zh_sprintadd.XXXXXX 2>/dev/null) || _sprintadd_err_file=/dev/null
    response=$(zh_graphql "$mutation" "$mutation_vars" 2>"$_sprintadd_err_file") || response=""
    if [[ "$_sprintadd_err_file" != "/dev/null" ]]; then
        response_err=$(zh_cause_hint "$_sprintadd_err_file")
        rm -f "$_sprintadd_err_file" 2>/dev/null || true
    fi
    if [[ -z "$response" ]]; then
        if [[ -n "$response_err" ]]; then
            error "Failed to add issue(s) to sprint '${sprint_actual_name}' (cause: ${response_err}). Verify with 'zh sprint show \"${sprint_actual_name}\"' before retrying."
        else
            error "Failed to add issue(s) to sprint '${sprint_actual_name}': ZenHub API call returned no usable response (check token / network / rate limits, then verify with 'zh sprint show \"${sprint_actual_name}\"' before retrying)."
        fi
    fi

    # Detect which input numbers came back as links. Filter by sprint id
    # AND by repo so a sibling repo's same-numbered issue can't credit
    # as our success in a multi-repo workspace.
    local owner_lc repo_lc
    owner_lc="${owner_repo%%/*}"
    repo_lc="${owner_repo##*/}"

    local returned_nums_csv
    returned_nums_csv=$(echo "$response" | jq -r \
        --arg sid "$sprint_id" \
        --arg owner "$owner_lc" \
        --arg repo "$repo_lc" \
        '[
           .data.addIssuesToSprints.sprintIssues[]
           | select(.sprint.id == $sid)
           | select(
               ((.issue.repository.ownerName // "") | ascii_downcase) == ($owner | ascii_downcase)
               and ((.issue.repository.name // "") | ascii_downcase) == ($repo | ascii_downcase)
             )
           | .issue.number
         ] | map(tostring) | join(",")')

    local input_nums_csv
    input_nums_csv=$(echo "$issues_resolved" | awk -F'\t' 'NF >= 2 {print $2}' | paste -sd, -)

    # Split inputs into succeeded / failed by membership.
    local succeeded failed
    succeeded=$(jq -nr --arg inputs "$input_nums_csv" --arg returned "$returned_nums_csv" \
        '($inputs | split(",")) as $in | ($returned | split(",")) as $out |
         [$in[] | select(. as $n | $out | any(. == $n))] | join(",")')
    failed=$(jq -nr --arg inputs "$input_nums_csv" --arg returned "$returned_nums_csv" \
        '($inputs | split(",")) as $in | ($returned | split(",")) as $out |
         [$in[] | select(. as $n | $out | all(. != $n))] | join(",")')

    local total_input
    total_input=$(echo "$input_nums_csv" | awk -F',' '{print NF}')
    local success_count
    success_count=$(echo "$succeeded" | awk -F',' '{if ($0 == "") {print 0} else {print NF}}')
    local failed_count
    failed_count=$(echo "$failed" | awk -F',' '{if ($0 == "") {print 0} else {print NF}}')

    echo ""
    if [[ "$success_count" -gt 0 ]]; then
        success "Added ${success_count}/${total_input} issue(s) to sprint '${sprint_actual_name}': ${succeeded//,/, }"
    fi
    if [[ "$failed_count" -gt 0 ]]; then
        warn "${failed_count} not linked (already in sprint, archived, or rejected by API): ${failed//,/, }"
    fi

    # Exit non-zero on partial / fail so scripted callers notice.
    if [[ "$failed_count" -gt 0 ]] || [[ "$success_count" -eq 0 ]]; then
        exit 1
    fi
}

cmd_sprint_remove() {
    load_config

    local sprint_name="${1:-}"
    shift || true

    if [[ -z "$sprint_name" ]] || [[ $# -eq 0 ]]; then
        error "Usage: zh sprint remove <sprint_name> <issue#> [<issue#> ...]

Remove one or more issues from a sprint.

Examples:
  zh sprint remove \"Sprint 5\" 42
  zh sprint remove current 42 43       # Remove from active sprint
  zh sprint rm active 42               # 'rm' is an alias for remove"
    fi

    # Dedup input numbers (first-occurrence order) so a repeated arg
    # can't be over-counted. Mirrors the Python boundary dedup in
    # remove_issues_from_sprint. Plain-array contains-check for
    # bash 3.2 portability (no associative arrays).
    # Bash 3.2 (stock /bin/bash on macOS) errors under `set -u` when
    # an empty array is expanded as "${arr[@]}" — the first iteration
    # of the for-loop below sees `inputs` empty and trips on
    # `inputs[@]: unbound variable`. The `${arr[@]+"${arr[@]}"}` form
    # makes the expansion conditional: it produces nothing when the
    # array is unset/empty, so the inner loop is a no-op on the first
    # iteration. Bash 4.4+ fixed this behaviour but the script ships
    # to macOS too.
    local -a inputs=()
    local raw_num stripped_arg seen_num
    for raw_num in "$@"; do
        stripped_arg="${raw_num#\#}"
        local already_seen=false
        for seen_num in ${inputs[@]+"${inputs[@]}"}; do
            if [[ "$seen_num" == "$stripped_arg" ]]; then
                already_seen=true
                break
            fi
        done
        if [[ "$already_seen" != "true" ]]; then
            inputs+=("$stripped_arg")
        fi
    done
    set -- ${inputs[@]+"${inputs[@]}"}

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    info "Resolving sprint '${sprint_name}'..."
    local sprint_resolved sprint_id sprint_actual_name
    sprint_resolved=$(zh_resolve_sprint_id "$workspace_id" "$sprint_name")
    sprint_id=$(echo "$sprint_resolved" | cut -f1)
    sprint_actual_name=$(echo "$sprint_resolved" | cut -f2)

    info "Resolving ${#} issue(s)..."
    local issues_resolved
    issues_resolved=$(zh_resolve_issue_ids_for_sprint "$repo_id" "$@")

    local issue_ids_json
    issue_ids_json=$(echo "$issues_resolved" | awk -F'\t' 'NF >= 1 {print $1}' | jq -R . | jq -s .)

    # The mutation returns the sprint's post-state. Anything STILL
    # attached after the call is inferred-failed. We ask for the full
    # post-state via a paginated walk, since the response cap of 100
    # would otherwise mis-classify removed-but-on-page-2 issues as
    # still-attached.
    local mutation='
    mutation($input: RemoveIssuesFromSprintsInput!) {
        removeIssuesFromSprints(input: $input) {
            sprints { id }
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg sprint_id "$sprint_id" --argjson issue_ids "$issue_ids_json" \
        '{input: {sprintIds: [$sprint_id], issueIds: $issue_ids}}')

    zh_graphql "$mutation" "$mutation_vars" > /dev/null

    # Post-state walk to determine which inputs are still in the sprint.
    # zh_sprint_issues_fetch_all already projects repository per issue,
    # so we can filter by repo here — sibling repos can share issue
    # numbers in a multi-repo workspace and we must not mis-classify
    # our removal as failed because some other repo's same-numbered
    # issue is still in the sprint.
    #
    # We pass soft_null=1 because the mutation has already fired by
    # this point. If the post-state walk hits a null node (sprint
    # deleted / ACL-revoked between mutation and walk — rare but
    # possible), we want a structured "could not confirm" message
    # rather than `error`-exiting and leaving the user with no
    # indication the mutation may have already taken effect.
    # (Round-4 #1.)
    local post_state
    # Pass owner_repo so the walker repo-filters `walked_nums` in
    # the JSON output. Without this, a sibling-repo same-number
    # issue lands in walked_nums but NOT in still_attached_nums_csv
    # (which is already repo-filtered), so the SPEC's
    # `succeeded = inputs ∩ walked - still_attached` would
    # incorrectly classify the input as removed. Round-6 #2.
    post_state=$(zh_sprint_issues_fetch_all "$sprint_id" "1" "$owner_repo")

    # Pull out the soft-fail sentinels the walker may have set.
    local null_node pagination_bailed
    null_node=$(echo "$post_state" | jq -r '.null_node // false')
    pagination_bailed=$(echo "$post_state" | jq -r '.pagination_bailed // ""')

    if [[ "$null_node" == "true" ]]; then
        # Mutation already fired; post-state can't be confirmed. Tell
        # the user clearly and exit with a distinct non-zero code so
        # scripted callers notice. Recovery: a separate
        # `zh sprint show '<name>'` call (which will itself error on
        # the null sprint, but at least the user knows what happened).
        echo ""
        warn "Mutation landed (removeIssuesFromSprints succeeded), but post-state could not be confirmed:"
        warn "  Sprint '${sprint_actual_name}' resolved to null in the post-state walk"
        warn "  (sprint was deleted / ACL-revoked / otherwise inaccessible between mutation and walk)"
        warn "Re-verify with 'zh sprints --all' to see the current state."
        exit 2
    fi

    local owner_lc repo_lc
    owner_lc="${owner_repo%%/*}"
    repo_lc="${owner_repo##*/}"

    # `still_attached_nums_csv` — issue numbers in our repo that
    # remain in the sprint post-mutation. Repo-filtered.
    local still_attached_nums_csv
    still_attached_nums_csv=$(echo "$post_state" | jq -r \
        --arg owner "$owner_lc" \
        --arg repo "$repo_lc" \
        '[
           .nodes[]
           | select(
               ((.issue.repository.ownerName // "") | ascii_downcase) == ($owner | ascii_downcase)
               and ((.issue.repository.name // "") | ascii_downcase) == ($repo | ascii_downcase)
             )
           | .issue.number
         ] | map(tostring) | join(",")')

    # `walked_nums_csv` — list of issue numbers the walker iterated,
    # already POST-REPO-FILTER because `cmd_sprint_remove` invoked
    # `zh_sprint_issues_fetch_all "$sprint_id" "1" "$owner_repo"` —
    # the third arg made the walker repo-filter `walked_nums` before
    # emitting it. Load-bearing for round-5 #2 / round-6 #2: when
    # the walker bails mid-flight, an input the walker didn't reach
    # in OUR repo is NOT in `walked_nums`, so it can't be classified
    # as succeeded (which would inflate the count and lie to the
    # user). Honest SPEC mirrors the Python side (zh_graphql_ops
    # round-6 #1: post-repo-filter walked_numbers).
    #
    # Round-7 #6: drop the legacy `// [.nodes[].issue.number]`
    # fallback. That fallback was pre-repo-filter and would
    # re-introduce round-6 #2 silently if the walker ever stopped
    # emitting `walked_nums`. The walker always emits it; treat its
    # absence as a structural bug rather than masking it. Read-only
    # callers of the walker (`cmd_sprint`) don't compute
    # `walked_nums_csv` at all, so the fallback was dead in
    # practice.
    #
    # Round-8 #6: change the missing-field handler from `error`
    # (exit 1, "re-run") to `warn` + `exit 2`. The mutation has
    # already fired at zh:3633 — bailing with "re-run if it
    # persists" lies to scripted callers about whether the change
    # landed. Mirror the null-node soft-fail pattern at zh:3663-3675:
    # tell the user the mutation succeeded but post-state can't be
    # confirmed, and exit with the same distinct non-zero code
    # (2) so callers can disambiguate "real failure" from
    # "coverage incomplete, re-verify."
    #
    # Round-8 #13 folded in: tighten the jq emit to distinguish
    # "missing/non-array" (structural bug) from "empty array"
    # (legitimate zero-walk under e.g. a fresh empty sprint). The
    # pre-fix `if .walked_nums then ...` short-circuited on the
    # empty list `[]` because jq treats `[]` as falsy in `if`,
    # mis-classifying empty as missing. Use a type check instead.
    # The jq emit distinguishes:
    #   walked_nums: []   -> ""           (legitimate zero-walk; e.g.
    #                                       sprint emptied by our own
    #                                       successful removal)
    #   walked_nums absent or non-array -> "__MISSING__"
    #                                       (structural bug; walker
    #                                        must emit the field as an
    #                                        array on every call)
    # Only the sentinel branch is the structural-bug case. An empty
    # CSV is the normal "nothing left in the sprint" outcome and must
    # fall through to the regular success path so the user sees
    # "Removed N/N issue(s)", not a spurious "internal bug" warning.
    # The `2>/dev/null || echo "__MISSING__"` recovery covers jq itself
    # failing (since `set -euo pipefail` does not propagate through
    # command substitution without `shopt -s inherit_errexit`, which we
    # don't enable here).
    local walked_nums_csv
    walked_nums_csv=$(echo "$post_state" | jq -r 'if (.walked_nums | type) == "array" then (.walked_nums | map(tostring) | join(",")) else "__MISSING__" end' 2>/dev/null || echo "__MISSING__")
    if [[ "$walked_nums_csv" == "__MISSING__" ]]; then
        echo ""
        warn "Mutation landed (removeIssuesFromSprints succeeded), but post-state could not be confirmed:"
        warn "  Walker output is missing the 'walked_nums' field (internal bug)"
        warn "Re-verify with 'zh sprint show \"${sprint_actual_name}\"' to see the current state."
        exit 2
    fi

    local input_nums_csv
    input_nums_csv=$(echo "$issues_resolved" | awk -F'\t' 'NF >= 2 {print $2}' | paste -sd, -)

    local succeeded failed
    if [[ -z "$pagination_bailed" ]]; then
        # Full coverage: walker observed the entire post-state (either
        # the response was <100 nodes OR we walked all pages). Naive
        # `inputs - still_attached` is correct.
        succeeded=$(jq -nr --arg inputs "$input_nums_csv" --arg attached "$still_attached_nums_csv" \
            '($inputs | split(",")) as $in | ($attached | split(",")) as $att |
             [$in[] | select(. as $n | $att | all(. != $n))] | join(",")')
        failed=$(jq -nr --arg inputs "$input_nums_csv" --arg attached "$still_attached_nums_csv" \
            '($inputs | split(",")) as $in | ($attached | split(",")) as $att |
             [$in[] | select(. as $n | $att | any(. == $n))] | join(",")')
    else
        # Partial coverage: walker bailed before observing the whole
        # sprint. Honest SPEC:
        #   succeeded = inputs ∩ walked - still_attached
        #   failed    = inputs ∩ walked ∩ still_attached
        #   un-verified inputs (not in walked) are neither — they're
        #     surfaced as a count in the bail diagnostic.
        succeeded=$(jq -nr \
            --arg inputs "$input_nums_csv" \
            --arg walked "$walked_nums_csv" \
            --arg attached "$still_attached_nums_csv" \
            '($inputs | split(",")) as $in
             | ($walked | split(",")) as $w
             | ($attached | split(",")) as $att
             | [$in[] | select(. as $n | $w | any(. == $n))
                       | select(. as $n | $att | all(. != $n))]
             | join(",")')
        failed=$(jq -nr \
            --arg inputs "$input_nums_csv" \
            --arg walked "$walked_nums_csv" \
            --arg attached "$still_attached_nums_csv" \
            '($inputs | split(",")) as $in
             | ($walked | split(",")) as $w
             | ($attached | split(",")) as $att
             | [$in[] | select(. as $n | $w | any(. == $n))
                       | select(. as $n | $att | any(. == $n))]
             | join(",")')
    fi

    local total_input
    total_input=$(echo "$input_nums_csv" | awk -F',' '{print NF}')
    local success_count
    success_count=$(echo "$succeeded" | awk -F',' '{if ($0 == "") {print 0} else {print NF}}')
    local failed_count
    failed_count=$(echo "$failed" | awk -F',' '{if ($0 == "") {print 0} else {print NF}}')
    local unverified_count=$((total_input - success_count - failed_count))

    echo ""
    if [[ "$success_count" -gt 0 ]]; then
        if [[ -n "$pagination_bailed" ]]; then
            # Coverage-incomplete: even our confirmed `succeeded` set
            # is partial — un-verified inputs may or may not have
            # been removed. Downgrade the message so the user doesn't
            # read a clean "Removed" as a confirmed outcome.
            warn "Confirmed removal of ${success_count}/${total_input} issue(s) from sprint '${sprint_actual_name}': ${succeeded//,/, }"
        else
            success "Removed ${success_count}/${total_input} issue(s) from sprint '${sprint_actual_name}': ${succeeded//,/, }"
        fi
    fi
    if [[ "$failed_count" -gt 0 ]]; then
        warn "${failed_count} still in sprint (API rejected the removal): ${failed//,/, }"
    fi
    # Round-5 #11: bail diagnostic must surface independent of
    # `success_count`. Previously it was gated inside the success
    # branch, so a fully-failed batch with walker-bailed coverage
    # would never see the diagnostic.
    if [[ -n "$pagination_bailed" ]]; then
        warn "Post-state coverage incomplete — re-verify."
        warn "  Walker bailed: ${pagination_bailed}."
        if [[ "$unverified_count" -gt 0 ]]; then
            warn "  ${unverified_count}/${total_input} input(s) un-verified (walker never reached them)."
        fi
        warn "  Re-verify with 'zh sprint show \"${sprint_actual_name}\"'."
    fi

    # Exit codes (round-5 #5):
    #
    #   0 — clean success, no failures, full coverage
    #   1 — real failure: at least one input still attached, OR
    #       zero confirmed positives. "Definitely wrong" takes
    #       precedence over coverage warnings.
    #   2 — coverage incomplete only (no real failures, walker
    #       bailed mid-walk). "Re-verify before retrying."
    #
    # The order matters: `failed_count > 0` is checked BEFORE
    # `pagination_bailed`, so a real failure beats a coverage
    # warning. Scripted callers reading the exit code get the more
    # actionable signal.
    if [[ "$failed_count" -gt 0 ]]; then
        exit 1
    fi
    if [[ "$success_count" -eq 0 ]] && [[ -z "$pagination_bailed" ]]; then
        # Zero positives with FULL coverage = real failure. Zero
        # positives with PARTIAL coverage is a coverage problem
        # (exit 2, below), not a real failure.
        exit 1
    fi
    if [[ -n "$pagination_bailed" ]]; then
        exit 2
    fi
}


# Shared helper: resolve a list of issue numbers to ZenHub issue IDs.
# Echoes a JSON array of IDs (one per resolved issue) on stdout; errors out
# if any issue is missing.
zh_resolve_issue_ids() {
    local repo_id="$1"
    shift
    local issue_nums=("$@")

    local ids="[]"
    for num in ${issue_nums[@]+"${issue_nums[@]}"}; do
        local stripped="${num#\#}"
        if ! [[ "$stripped" =~ ^[0-9]+$ ]]; then
            error "Invalid issue number: ${num}"
        fi

        local query='
        query($repoId: ID!, $issueNumber: Int!) {
            issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
                id
            }
        }'

        local variables
        variables=$(jq -n --arg repo_id "$repo_id" --argjson n "$stripped" \
            '{repoId: $repo_id, issueNumber: $n}')

        # v1.9.3 pattern-sweep: fail-soft envelope mirroring the
        # cmd_subissue_add mutation pattern (round-4 #1). This helper
        # feeds cmd_subissue_add via the dedup loop above; a bare
        # `response=$(zh_graphql ...)` aborts the whole script under
        # `set -euo pipefail` when zh_graphql `error`s on `.errors`,
        # so the loop above can never reach the cmd-level "not found
        # in this repository" diagnostic. Capture-and-branch keeps
        # the lookup loop responsible for its own error surface, with
        # the cause hint surfaced when available.
        local response="" response_err=""
        local _resolve_err_file
        _resolve_err_file=$(mktemp -t zh_resolve.XXXXXX 2>/dev/null) || _resolve_err_file=/dev/null
        response=$(zh_graphql "$query" "$variables" 2>"$_resolve_err_file") || response=""
        if [[ "$_resolve_err_file" != "/dev/null" ]]; then
            response_err=$(zh_cause_hint "$_resolve_err_file")
            rm -f "$_resolve_err_file" 2>/dev/null || true
        fi
        if [[ -z "$response" ]]; then
            if [[ -n "$response_err" ]]; then
                error "Failed to resolve issue #${stripped} (cause: ${response_err})."
            else
                error "Failed to resolve issue #${stripped}: ZenHub API call returned no usable response (check token / network / rate limits)."
            fi
        fi

        local issue_id
        issue_id=$(echo "$response" | jq -r '.data.issueByInfo.id // empty')

        if [[ -z "$issue_id" ]]; then
            error "Issue #${stripped} not found in this repository"
        fi

        ids=$(echo "$ids" | jq --arg id "$issue_id" '. + [$id]')
    done

    echo "$ids"
}


# =============================================================================
# Sub-issue Commands
# =============================================================================
#
# Sub-issues are the 3rd hierarchy tier (Epic, then Issue, then Sub-issue). A
# sub-issue is an Issue whose parent points to another Issue. ZenHub exposes
# the wiring via three GraphQL mutations:
#
#   addSubIssues:         link one or more child issues under a parent
#   removeSubIssues:      unlink one or more children (parent inferred)
#   reprioritizeSubIssue: reorder a single child relative to siblings
#
# Sub-issue connection model (verified live against a GitHub-backed workspace,
# 2026-05-29): both addSubIssues and CreateIssueInput.parentIssueId write to
# the GitHub-native connection (githubChildIssues / githubParentIssue), and
# the union field parentIssue resolves to that same parent. The separate
# zenhubChildIssues connection is for ZenHub-only cards and stays empty for
# our writes. The whole zh codebase therefore reads `githubChildIssues`
# everywhere (the walkers below, cmd_subissue_list, cmd_hierarchy_show,
# cmd_issue). See the cmd_create header for the same note. Do not relapse to
# zenhubChildIssues.

# Resolve a single issue number to its ZenHub issue ID. Thin wrapper around
# zh_resolve_issue_ids that returns the first element rather than a JSON
# array, since most sub-issue ops only need one parent at a time.
zh_resolve_issue_id() {
    local repo_id="$1"
    local issue_num="$2"

    local ids_json
    ids_json=$(zh_resolve_issue_ids "$repo_id" "$issue_num")

    echo "$ids_json" | jq -r '.[0]'
}

cmd_subissue_add() {
    local parent_num="${1:-}"
    shift || true

    if [[ -z "$parent_num" ]] || [[ $# -eq 0 ]]; then
        error "Usage: zh subissue add <parent#> <child#> [<child#> ...]
Example: zh subissue add 42 100 101"
    fi

    # Dedup input numbers (first-occurrence order) so a repeated arg
    # can't inflate the success count when the API returns one link
    # per unique issue. Same SPEC as the sprint mutations and the
    # Python add_sub_issues boundary dedup.
    local -a child_nums=()
    local raw_num stripped_arg seen_num
    for raw_num in "$@"; do
        stripped_arg="${raw_num#\#}"
        local already_seen=false
        for seen_num in ${child_nums[@]+"${child_nums[@]}"}; do
            if [[ "$seen_num" == "$stripped_arg" ]]; then
                already_seen=true
                break
            fi
        done
        if [[ "$already_seen" != "true" ]]; then
            child_nums+=("$stripped_arg")
        fi
    done

    local stripped_parent="${parent_num#\#}"

    # Argument-format validation up-front so typos surface before any git or
    # network round-trip (matches the posture in cmd_subissue_remove).
    if ! [[ "$stripped_parent" =~ ^[0-9]+$ ]]; then
        error "Invalid parent issue number: ${parent_num}"
    fi
    for raw_num in ${child_nums[@]+"${child_nums[@]}"}; do
        local stripped="${raw_num#\#}"
        if ! [[ "$stripped" =~ ^[0-9]+$ ]]; then
            error "Invalid issue number: ${raw_num}"
        fi
    done

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    info "Adding ${#child_nums[@]} sub-issue(s) to parent #${stripped_parent}..."

    # Resolve parent and children separately. The parent ID goes into parentId
    # (scalar); the child IDs go into childIssueIds (list).
    local parent_id
    parent_id=$(zh_resolve_issue_id "$repo_id" "$parent_num")

    local child_ids_json
    child_ids_json=$(zh_resolve_issue_ids "$repo_id" ${child_nums[@]+"${child_nums[@]}"})

    local mutation_vars
    mutation_vars=$(jq -n \
        --arg parent_id "$parent_id" \
        --argjson child_ids "$child_ids_json" \
        '{input: {parentId: $parent_id, childIssueIds: $child_ids}}')

    # Project failedIssues fully so we can name which children were rejected,
    # rather than the prior "{failedIssues: [...]}" opaque dump.
    local mutation='
    mutation($input: AddSubIssuesInput!) {
        addSubIssues(input: $input) {
            successCount
            failedIssues {
                number
                repository { ownerName name }
            }
            githubErrors
        }
    }'

    # v1.9.2 round-4 (PR #27) finding #1: fail-soft envelope mirroring
    # cmd_set_type (zh:3713) and the six cmd_create envelopes. The
    # pre-fix bare assignment died under `set -euo pipefail` whenever
    # zh_graphql exited 1 on a `.errors` response. Under the
    # round-3 #2 partial-applied contract, the divergence-only
    # partial path (data block populated + .errors envelope) is
    # EXACTLY the scenario the gate at zh:6042 is meant to detect;
    # the bare assignment aborted before reaching it. With this
    # envelope the partial classifier stays reachable, and an
    # empty response is treated as a real failure with the cause
    # hint surfaced.
    local response="" response_err=""
    local _ssa_err_file
    _ssa_err_file=$(mktemp -t zh_ssadd.XXXXXX 2>/dev/null) || _ssa_err_file=/dev/null
    response=$(zh_graphql "$mutation" "$mutation_vars" 2>"$_ssa_err_file") || response=""
    if [[ "$_ssa_err_file" != "/dev/null" ]]; then
        response_err=$(zh_cause_hint "$_ssa_err_file")
        [[ "$_ssa_err_file" != "/dev/null" ]] && rm -f "$_ssa_err_file" 2>/dev/null || true
    fi
    if [[ -z "$response" ]]; then
        if [[ -n "$response_err" ]]; then
            error "Failed to add sub-issues to #${parent_num} (cause: ${response_err}). Verify with 'zh subissue list ${parent_num}' before retrying."
        else
            error "Failed to add sub-issues to #${parent_num}: ZenHub API call returned no usable response (check token / network / rate limits, then verify with 'zh subissue list ${parent_num}' before retrying)."
        fi
    fi

    local success_count failed_count
    success_count=$(echo "$response" | jq -r '.data.addSubIssues.successCount // 0')
    failed_count=$(echo "$response" | jq -r '(.data.addSubIssues.failedIssues // []) | length')

    # Derive the actual added/failed sets from the API response. The naive
    # "summary = printf #N from inputs" approach we used to do here named
    # children as "Added" even when the API rejected them — see release-
    # review finding #5. Instead, take the failed-children numbers from the
    # mutation payload, subtract them from the input list, and call the
    # remainder the added set.
    # CSV format for the RESULT line MUST be space-free — the MCP parser
    # tokenises that line on " ", so any space inside a value (e.g. "#100, #101")
    # would split a single CSV across multiple tokens, the bare "#101" without
    # an "=" would be silently dropped, and the parsed `added` list would
    # under-count. See round-3 review finding #1.
    #
    # We DO still want the human-readable spaces in the warn/success lines —
    # those go through a separate formatter below.
    local failed_nums_csv added_nums_csv
    failed_nums_csv=$(echo "$response" | jq -r \
        '(.data.addSubIssues.failedIssues // []) | map("#" + (.number|tostring)) | join(",")')

    # Input children minus failed children = inferred-added children.
    # Compute it in shell because addSubIssues only returns
    # failedIssues (not the inverse).
    local added_nums_csv_parts=""
    for raw_num in ${child_nums[@]+"${child_nums[@]}"}; do
        local stripped="${raw_num#\#}"
        local was_failed
        was_failed=$(echo "$response" | jq -r --argjson n "$stripped" \
            '[(.data.addSubIssues.failedIssues // [])[] | .number] | any(. == $n)')
        if [[ "$was_failed" != "true" ]]; then
            added_nums_csv_parts+="#${stripped},"
        fi
    done
    added_nums_csv="${added_nums_csv_parts%,}"

    # Round-6 #4 — divergence guard. The Python side
    # (zh_graphql_ops.add_sub_issues) refuses to identify which inputs
    # succeeded when `success_count != (total_inputs - failed_count)`.
    # Pre-fix bash printed "Added 1 sub-issue(s) to #42: #100, #101,
    # #102" — claiming all three landed because none appeared in
    # failedIssues. SPEC: when the count diverges, do NOT name the
    # inferred-added children; tell the user to re-list.
    local total_inputs="${#child_nums[@]}"
    local inferred_added_count=$((total_inputs - failed_count))
    local divergence=false
    if [[ "$success_count" != "$inferred_added_count" ]]; then
        divergence=true
    fi

    # Pretty form for human output. `added_nums_pretty` is suppressed
    # under divergence so we don't lie about which inputs landed.
    local failed_nums_pretty added_nums_pretty
    failed_nums_pretty="${failed_nums_csv//,/, }"
    added_nums_pretty="${added_nums_csv//,/, }"

    echo ""
    if [[ "$success_count" -gt 0 ]]; then
        if [[ "$divergence" == "true" ]]; then
            warn "Added ${success_count}/${total_inputs} sub-issue(s) to #${stripped_parent} (cannot identify which — re-run 'zh subissue list ${stripped_parent}' to verify)"
        else
            success "Added ${success_count} sub-issue(s) to #${stripped_parent}: ${added_nums_pretty}"
        fi
    fi
    if [[ "$failed_count" -gt 0 ]]; then
        warn "${failed_count} failed: ${failed_nums_pretty}"
        local gh_errors gh_errors_len
        gh_errors=$(echo "$response" | jq -c '.data.addSubIssues.githubErrors // {}')
        # v1.9.1 item #1: the prior guard rejected {} and null but accepted
        # an empty array []. ZenHub's mutation payload returns githubErrors
        # as an empty list when there are no GitHub-side errors, so the
        # original "no errors to print" intent was leaking a literal "[]"
        # into the warn line. Compute the JSON length and gate on that
        # instead of stringly comparing against every empty shape.
        gh_errors_len=$(echo "$gh_errors" | jq 'if type == "object" or type == "array" then length else 1 end')
        if [[ "$gh_errors_len" -gt 0 ]]; then
            warn "  githubErrors: ${gh_errors}"
        fi
        # Round-10 Pattern C (round-9 #4): surface the fail-divergence
        # case (API reported failures but did not account for every
        # input). Mirrors the Python `partial_success_warning` fail
        # variant.
        local unaccounted_count=$((total_inputs - failed_count - success_count))
        if [[ "$unaccounted_count" -gt 0 ]]; then
            warn "  ${unaccounted_count} input(s) un-reported (neither succeeded nor in failedIssues). Re-list to confirm."
        fi
    fi
    if [[ "$success_count" -eq 0 ]] && [[ "$failed_count" -eq 0 ]]; then
        # Some ZenHub mutations silently no-op when the child already
        # has the same parent. Round-10 Pattern C (round-9 #4): name
        # the strict-noop-divergence shape distinctly so the operator
        # knows to re-list. cmd_subissue_add requires total_inputs >= 1,
        # so this is always a strict no-op despite N inputs.
        warn "No sub-issues added — API returned strict no-op (successCount=0, failedIssues=[]) despite ${total_inputs} input(s). Re-list to confirm."
    fi

    # v1.6.0 removed the `RESULT:add` machine-summary line. The sole
    # consumer (the MCP server) now calls the GraphQL mutation directly
    # and reads successCount / failedIssues from the JSON response.
    #
    # We still classify the outcome here for the exit-code contract that
    # scripted callers (humans + CI) rely on. Precedence (round-5 #5):
    # real failure > coverage/divergence warning > success.
    #
    # Round-10 Pattern C (round-9 #5): align exit-code semantics with
    # cmd_sprint_remove (canonical 0/1/2 convention). Divergence-only
    # partial means "the API claimed N succeeded but we can't identify
    # which inputs" — that's coverage-incomplete (re-verify with
    # `zh subissue list`), not a real failure. Exit 2 disambiguates
    # this from `failed_count > 0` (real rejections).
    local outcome
    if [[ "$failed_count" -gt 0 ]] && [[ "$success_count" -gt 0 ]]; then
        outcome="partial"
    elif [[ "$failed_count" -gt 0 ]]; then
        outcome="fail"
    elif [[ "$success_count" -eq 0 ]]; then
        outcome="noop"
    elif [[ "$divergence" == "true" ]]; then
        # Round-6 #4: signal must match data. ok→partial when we
        # can't identify which inputs landed.
        outcome="partial"
    else
        outcome="ok"
    fi

    # v1.9.3 pattern-sweep: machine-readable outcome sentinel on stderr.
    # The Python `_planning_add_children` wrapper used to overstate
    # `added=child_numbers` on a noop because exit_code was 0 (round-4 #5
    # idempotent-success) and the wrapper couldn't distinguish "every
    # child landed" from "every child was already attached". Emitting the
    # sentinel as a single stderr line lets the wrapper override `added`
    # to `[]` and report `outcome="noop"` truthfully. Stdout stays clean
    # for human consumption.
    echo "__ZH_OUTCOME__:${outcome}" >&2

    # v1.9.2 round-3 (PR #27) finding #2: align partial-applied
    # exit-code convention with cmd_set_type and the rest of the
    # v1.9.x cycle. outcome=partial (some succeeded, some failed)
    # is exit 2, not exit 1. This makes the bash CLI's exit code
    # match what `subissue_add_children` MCP returns
    # (partial_applied=True) and what `_planning_add_children`
    # (which keys partial_applied on exit==2) reports. The old gate
    # collapsed any failed_count>0 to exit 1, which made the bash
    # side treat partial-success as full failure, silently
    # contradicting the MCP-GraphQL-direct surface.
    #
    # v1.9.2 round-4 (PR #27) finding #5: outcome=noop (zero positives,
    # zero negatives) is idempotent success for add — every input was
    # already linked, so the desired state is already true. Exit 0
    # with the noop wording. The pre-fix exit 1 made agents retry an
    # operation whose intent was already satisfied.
    if [[ "$outcome" == "ok" ]]; then
        :  # exit 0 (implicit)
    elif [[ "$outcome" == "noop" ]]; then
        :  # exit 0 — idempotent success (children already attached)
    elif [[ "$outcome" == "partial" ]]; then
        exit 2  # partial-applied: some succeeded, agent should not retry blindly
    elif [[ "$outcome" == "fail" ]]; then
        exit 1  # all-fail: safe to retry
    else
        exit 2  # divergence-only partial = coverage incomplete
    fi
}

cmd_subissue_remove() {
    local parent_num="${1:-}"
    shift || true

    if [[ -z "$parent_num" ]] || [[ $# -eq 0 ]]; then
        error "Usage: zh subissue remove <parent#> <child#> [<child#> ...]
Example: zh subissue remove 42 100

Each named child must currently be a sub-issue of <parent#>. The
underlying removeSubIssues mutation only takes child IDs (it unlinks each
from its actual parent), so we cross-check parents before firing to catch
mis-typed parent numbers — otherwise 'remove 9999 100' would happily
unlink #100 from its real parent while reporting 'removed from #9999'."
    fi

    # Dedup input numbers (first-occurrence order) so a repeated arg
    # can't inflate the success count. Mirrors cmd_subissue_add and
    # the Python remove_sub_issues boundary dedup.
    local -a child_nums=()
    local raw_num stripped_arg seen_num
    for raw_num in "$@"; do
        stripped_arg="${raw_num#\#}"
        local already_seen=false
        for seen_num in ${child_nums[@]+"${child_nums[@]}"}; do
            if [[ "$seen_num" == "$stripped_arg" ]]; then
                already_seen=true
                break
            fi
        done
        if [[ "$already_seen" != "true" ]]; then
            child_nums+=("$stripped_arg")
        fi
    done

    local stripped_parent="${parent_num#\#}"

    # Argument-format validation BEFORE any network or git lookup, so typos
    # surface immediately regardless of cwd.
    if ! [[ "$stripped_parent" =~ ^[0-9]+$ ]]; then
        error "Invalid parent issue number: ${parent_num}"
    fi
    for raw_num in ${child_nums[@]+"${child_nums[@]}"}; do
        local stripped="${raw_num#\#}"
        if ! [[ "$stripped" =~ ^[0-9]+$ ]]; then
            error "Invalid issue number: ${raw_num}"
        fi
    done

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # For each named child, fetch its current parent and confirm it matches
    # the user-supplied parent number. We do this in one query per child
    # rather than batching because the schema doesn't expose a multi-lookup
    # issuesByInfo. All validation failures (not-found, no-parent,
    # wrong-parent) accumulate into $mismatches and surface as a single
    # consolidated error after the loop — failing mid-loop would drop any
    # findings recorded earlier in the same batch.
    local child_id_list="[]"
    local mismatches=""
    for raw_num in ${child_nums[@]+"${child_nums[@]}"}; do
        local stripped="${raw_num#\#}"

        local lookup_query='
        query($repoId: ID!, $issueNumber: Int!) {
            issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
                id
                parentIssue {
                    number
                }
                repository {
                    ownerName
                    name
                }
            }
        }'

        local lookup_vars
        lookup_vars=$(jq -n --arg repo_id "$repo_id" --argjson n "$stripped" \
            '{repoId: $repo_id, issueNumber: $n}')

        # v1.9.3 pattern-sweep: fail-soft envelope for the pre-validation
        # lookup, mirroring the round-4 #1 envelope already applied to
        # the removeSubIssues mutation at zh:6299. Pre-fix, a transient
        # zh_graphql `.errors` response on one child's lookup aborted
        # the function under set-e and stole the consolidated mismatch
        # report from the user. With this envelope an unparseable
        # response is funneled into the same mismatches accumulator so
        # the loop completes and the user sees every issue's status.
        local lookup_response="" lookup_response_err=""
        local _lookup_err_file
        _lookup_err_file=$(mktemp -t zh_ssrlookup.XXXXXX 2>/dev/null) || _lookup_err_file=/dev/null
        lookup_response=$(zh_graphql "$lookup_query" "$lookup_vars" 2>"$_lookup_err_file") || lookup_response=""
        if [[ "$_lookup_err_file" != "/dev/null" ]]; then
            lookup_response_err=$(zh_cause_hint "$_lookup_err_file")
            rm -f "$_lookup_err_file" 2>/dev/null || true
        fi
        if [[ -z "$lookup_response" ]]; then
            if [[ -n "$lookup_response_err" ]]; then
                mismatches+="  #${stripped}: lookup failed (cause: ${lookup_response_err})
"
            else
                mismatches+="  #${stripped}: lookup failed (no usable response)
"
            fi
            continue
        fi

        local child_id actual_parent child_owner child_repo
        child_id=$(echo "$lookup_response" | jq -r '.data.issueByInfo.id // empty')
        actual_parent=$(echo "$lookup_response" | jq -r '.data.issueByInfo.parentIssue.number // empty')
        child_owner=$(echo "$lookup_response" | jq -r '.data.issueByInfo.repository.ownerName // empty')
        child_repo=$(echo "$lookup_response" | jq -r '.data.issueByInfo.repository.name // empty')

        # Funnel all validation failures (not-found, cross-repo, no-parent,
        # wrong-parent) into the same accumulator. Erroring out mid-loop on
        # "not found" would drop any findings recorded earlier — the user
        # would have to retry to learn about them. Consolidate-then-report
        # is the documented UX intent in the comment above.
        if [[ -z "$child_id" ]]; then
            mismatches+="  #${stripped}: not found in this repository
"
        # Defense-in-depth against the multi-repo workspace surprise: if the
        # API resolved the issue but the child's repository differs from the
        # checkout we ran from, the parent-match check below could pass by
        # coincidence (same issue number in repo A AND repo B, both with
        # parentIssue.number == stripped_parent) and unlink the wrong child.
        # Reject with a clear "cd or pass --repo" hint instead.
        elif [[ -n "$child_owner" ]] && [[ "${child_owner}/${child_repo}" != "$owner_repo" ]]; then
            mismatches+="  #${stripped}: lives in ${child_owner}/${child_repo}, but you're working from ${owner_repo} (cross-repo sub-issues not supported)
"
        elif [[ -z "$actual_parent" ]]; then
            mismatches+="  #${stripped}: has no parent (not a sub-issue)
"
        # Arithmetic comparison with forced base-10 so '0042' typed by the
        # user compares equal to '42' returned by the API, AND so '08'/'09'
        # don't trigger bash's octal parser.
        elif (( 10#$actual_parent != 10#$stripped_parent )); then
            mismatches+="  #${stripped}: actual parent is #${actual_parent}, not #${stripped_parent}
"
        else
            child_id_list=$(echo "$child_id_list" | jq --arg id "$child_id" '. + [$id]')
        fi
    done

    if [[ -n "$mismatches" ]]; then
        # Trailing newline already in mismatches; trim it for the error frame.
        error "Cannot remove — one or more children are not sub-issues of #${stripped_parent}:
${mismatches%$'\n'}

Use 'zh issue <N>' or 'zh subissue list ${stripped_parent}' to verify the
parent relationship before retrying."
    fi

    info "Removing ${#child_nums[@]} sub-issue(s) from parent #${stripped_parent}..."

    local mutation_vars
    mutation_vars=$(jq -n --argjson child_ids "$child_id_list" \
        '{input: {childIssueIds: $child_ids}}')

    # Project failedIssues fully so we can name which children the API
    # rejected; the prior opaque dump made partial-failure reporting
    # ambiguous (see release-review finding #1).
    local mutation='
    mutation($input: RemoveSubIssuesInput!) {
        removeSubIssues(input: $input) {
            successCount
            failedIssues {
                number
                repository { ownerName name }
            }
            githubErrors
        }
    }'

    # v1.9.2 round-4 (PR #27) finding #1: same fail-soft envelope as
    # cmd_subissue_add. The bare assignment died under set -e when
    # zh_graphql exited 1 on a `.errors` response, missing the
    # partial classifier at zh:6313.
    local response="" response_err=""
    local _ssr_err_file
    _ssr_err_file=$(mktemp -t zh_ssrm.XXXXXX 2>/dev/null) || _ssr_err_file=/dev/null
    response=$(zh_graphql "$mutation" "$mutation_vars" 2>"$_ssr_err_file") || response=""
    if [[ "$_ssr_err_file" != "/dev/null" ]]; then
        response_err=$(zh_cause_hint "$_ssr_err_file")
        [[ "$_ssr_err_file" != "/dev/null" ]] && rm -f "$_ssr_err_file" 2>/dev/null || true
    fi
    if [[ -z "$response" ]]; then
        if [[ -n "$response_err" ]]; then
            error "Failed to remove sub-issues from #${parent_num} (cause: ${response_err}). Verify with 'zh subissue list ${parent_num}' before retrying."
        else
            error "Failed to remove sub-issues from #${parent_num}: ZenHub API call returned no usable response (check token / network / rate limits, then verify with 'zh subissue list ${parent_num}' before retrying)."
        fi
    fi

    local success_count failed_count
    success_count=$(echo "$response" | jq -r '.data.removeSubIssues.successCount // 0')
    failed_count=$(echo "$response" | jq -r '(.data.removeSubIssues.failedIssues // []) | length')

    # Derive removed / failed sets from the API response, not from the raw
    # input list. See release-review finding #5: the prior summary named
    # every input as "Removed" regardless of outcome.
    #
    # RESULT-line CSVs are space-free (round-3 finding #1); pretty variants
    # below are for human output only.
    local failed_nums_csv removed_nums_csv
    failed_nums_csv=$(echo "$response" | jq -r \
        '(.data.removeSubIssues.failedIssues // []) | map("#" + (.number|tostring)) | join(",")')

    local removed_nums_csv_parts=""
    for raw_num in ${child_nums[@]+"${child_nums[@]}"}; do
        local stripped="${raw_num#\#}"
        local was_failed
        was_failed=$(echo "$response" | jq -r --argjson n "$stripped" \
            '[(.data.removeSubIssues.failedIssues // [])[] | .number] | any(. == $n)')
        if [[ "$was_failed" != "true" ]]; then
            removed_nums_csv_parts+="#${stripped},"
        fi
    done
    removed_nums_csv="${removed_nums_csv_parts%,}"

    # Round-6 #4 mirror — divergence guard. See cmd_subissue_add for
    # the full rationale; SPEC: when count disagrees with inferred
    # set, do NOT name the inferred-removed children.
    local total_inputs="${#child_nums[@]}"
    local inferred_removed_count=$((total_inputs - failed_count))
    local divergence=false
    if [[ "$success_count" != "$inferred_removed_count" ]]; then
        divergence=true
    fi

    local failed_nums_pretty removed_nums_pretty
    failed_nums_pretty="${failed_nums_csv//,/, }"
    removed_nums_pretty="${removed_nums_csv//,/, }"

    echo ""
    if [[ "$success_count" -gt 0 ]]; then
        if [[ "$divergence" == "true" ]]; then
            warn "Removed ${success_count}/${total_inputs} sub-issue(s) from #${stripped_parent} (cannot identify which — re-run 'zh subissue list ${stripped_parent}' to verify)"
        else
            success "Removed ${success_count} sub-issue(s) from #${stripped_parent}: ${removed_nums_pretty}"
        fi
    fi
    if [[ "$failed_count" -gt 0 ]]; then
        warn "${failed_count} failed: ${failed_nums_pretty}"
        local gh_errors gh_errors_len
        gh_errors=$(echo "$response" | jq -c '.data.removeSubIssues.githubErrors // {}')
        # v1.9.1 item #1 mirror: same length-based guard as
        # cmd_subissue_add (the prior comparison missed the empty-array
        # shape that ZenHub actually returns for "no GitHub-side
        # errors").
        gh_errors_len=$(echo "$gh_errors" | jq 'if type == "object" or type == "array" then length else 1 end')
        if [[ "$gh_errors_len" -gt 0 ]]; then
            warn "  githubErrors: ${gh_errors}"
        fi
        # Round-10 Pattern C (round-9 #4): symmetric fail-divergence
        # surface with cmd_subissue_add.
        local unaccounted_count=$((total_inputs - failed_count - success_count))
        if [[ "$unaccounted_count" -gt 0 ]]; then
            warn "  ${unaccounted_count} input(s) un-reported (neither succeeded nor in failedIssues). Re-list to confirm."
        fi
    fi
    if [[ "$success_count" -eq 0 ]] && [[ "$failed_count" -eq 0 ]]; then
        # We pre-validated every child belongs to this parent, so a zero
        # successCount at this point would be an API-side oddity (e.g. a race
        # where someone unlinked the child between our validation and the
        # mutation). Surface it explicitly rather than claiming "no-op".
        warn "No sub-issues removed — response showed successCount=0 with no failures.
This is unexpected after pre-flight validation succeeded; check the parent
state with 'zh subissue list ${stripped_parent}'."
    fi

    # v1.6.0 removed the `RESULT:remove` machine-summary line. The sole
    # consumer (the MCP server) now reads successCount / failedIssues
    # directly from the GraphQL response. Exit-code contract preserved
    # for scripted callers. Round-6 #4: divergence forces partial.
    #
    # Round-10 Pattern C (round-9 #5): symmetric exit-code update with
    # cmd_subissue_add — divergence-only partial → exit 2.
    local outcome
    if [[ "$failed_count" -gt 0 ]] && [[ "$success_count" -gt 0 ]]; then
        outcome="partial"
    elif [[ "$failed_count" -gt 0 ]]; then
        outcome="fail"
    elif [[ "$success_count" -eq 0 ]]; then
        outcome="noop"
    elif [[ "$divergence" == "true" ]]; then
        outcome="partial"
    else
        outcome="ok"
    fi
    # v1.9.3 pattern-sweep: machine-readable outcome sentinel on stderr
    # (mirrors cmd_subissue_add). Lets the Python wrapper override
    # `removed=child_numbers` to `[]` on a noop, so a remove call that
    # finds nothing linked no longer overstates what the API touched.
    echo "__ZH_OUTCOME__:${outcome}" >&2

    # v1.9.2 round-3 (PR #27) finding #2: align partial exit code
    # with cmd_subissue_add (see comment there). outcome=partial is
    # exit 2 so MCP _planning_remove_children correctly reports
    # partial_applied=True and matches subissue_remove_children's
    # GraphQL-direct contract.
    #
    # v1.9.2 round-4 (PR #27) finding #5: outcome=noop for REMOVE
    # means "none of the requested inputs were linked to begin with"
    # — the desired state ("not linked") is already true. Exit 0 for
    # idempotent-success symmetry with cmd_subissue_add's noop arm.
    if [[ "$outcome" == "ok" ]]; then
        :  # exit 0 (implicit)
    elif [[ "$outcome" == "noop" ]]; then
        :  # exit 0 — idempotent success (none were linked to remove)
    elif [[ "$outcome" == "partial" ]]; then
        exit 2  # partial-applied: some succeeded, agent should not retry blindly
    elif [[ "$outcome" == "fail" ]]; then
        exit 1  # all-fail: safe to retry
    else
        exit 2  # divergence-only partial = coverage incomplete
    fi
}

# Fetch ALL sub-issues for a parent issue, walking the githubChildIssues
# connection with cursor pagination until pageInfo.hasNextPage is false.
#
# Echoes a single JSON object on stdout:
#   { totalCount: N, parentTitle: "...", nodes: [ {number,title,state,assignees,pipelineIssue,repository}, ... ] }
#
# Or echoes the literal string "null" if the parent issue is not found.
#
# Arguments: repo_id, workspace_id, parent_num
zh_subissue_fetch_all() {
    local repo_id="$1"
    local workspace_id="$2"
    local parent_num="$3"

    local query='
    query($repoId: ID!, $issueNumber: Int!, $workspaceId: ID!, $after: String) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            number
            title
            state
            githubChildIssues(first: 100, after: $after) {
                totalCount
                pageInfo {
                    hasNextPage
                    endCursor
                }
                nodes {
                    number
                    title
                    state
                    assignees {
                        nodes { login }
                    }
                    pipelineIssue(workspaceId: $workspaceId) {
                        pipeline { name }
                    }
                    repository {
                        ownerName
                        name
                    }
                }
            }
        }
    }'

    local cursor="null"
    local prev_cursor=""
    local iterations=0
    local all_nodes="[]"
    local total_count=0
    local parent_title=""
    local first_page=true

    while :; do
        # Stuck-cursor / runaway-pagination defenses:
        #   1. If the API returns the same endCursor we just used (server bug
        #      or regression on hasNextPage), we'd loop forever fetching the
        #      same page. Detect and bail.
        #   2. Hard iteration cap as a belt-and-suspenders backstop. 200
        #      pages × 100 children = 20,000 sub-issues, well above any
        #      realistic parent. If we hit it, something is wrong upstream
        #      and we should fail loudly rather than spin.
        iterations=$((iterations + 1))
        if [[ "$iterations" -gt 200 ]]; then
            warn "Pagination iteration cap (200) hit on parent — returning partial result"
            break
        fi

        local variables
        variables=$(jq -n \
            --arg repo_id "$repo_id" \
            --argjson issue_num "$parent_num" \
            --arg workspace_id "$workspace_id" \
            --argjson after "$cursor" \
            '{repoId: $repo_id, issueNumber: $issue_num, workspaceId: $workspace_id, after: $after}')

        local response
        response=$(zh_graphql "$query" "$variables")

        local issue_json
        issue_json=$(echo "$response" | jq '.data.issueByInfo')

        if [[ "$issue_json" == "null" ]]; then
            echo "null"
            return
        fi

        if [[ "$first_page" == "true" ]]; then
            parent_title=$(echo "$issue_json" | jq -r '.title // ""')
            total_count=$(echo "$issue_json" | jq -r '.githubChildIssues.totalCount // 0')
            first_page=false
        fi

        # Append this page's nodes to all_nodes. `select(. != null)`
        # strips null page entries — same defensive normalization the
        # other walkers (zh_workspaces_fetch_all, zh_sprints_fetch_all,
        # zh_sprint_issues_fetch_all) apply, and the Python
        # list_sub_issues walker enforces. Round-5 #8 closes the
        # last walker that missed this filter.
        local page_nodes
        page_nodes=$(echo "$issue_json" | jq -c '[(.githubChildIssues.nodes // [])[] | select(. != null)]')
        all_nodes=$(jq -n --argjson a "$all_nodes" --argjson b "$page_nodes" '$a + $b')

        local has_next end_cursor
        has_next=$(echo "$issue_json" | jq -r '.githubChildIssues.pageInfo.hasNextPage // false')
        end_cursor=$(echo "$issue_json" | jq -r '.githubChildIssues.pageInfo.endCursor // empty')

        if [[ "$has_next" != "true" ]] || [[ -z "$end_cursor" ]]; then
            break
        fi

        # Stuck-cursor check: a well-behaved connection always advances
        # endCursor when hasNextPage=true. If it doesn't, abort.
        if [[ -n "$prev_cursor" ]] && [[ "$end_cursor" == "$prev_cursor" ]]; then
            warn "Pagination cursor did not advance (endCursor=${end_cursor:0:16}…) — returning partial result"
            break
        fi
        prev_cursor="$end_cursor"

        cursor=$(jq -n --arg c "$end_cursor" '$c')
    done

    jq -n \
        --argjson nodes "$all_nodes" \
        --argjson total "$total_count" \
        --arg title "$parent_title" \
        '{totalCount: $total, parentTitle: $title, nodes: $nodes}'
}

# Lightweight variant of zh_subissue_fetch_all that returns only
# {id, number, repository{ownerName,name}} per child. Used by reorder to
# look up sibling IDs across all pages.
#
# Repository projection (round-3 finding #5): in a multi-repo workspace two
# of a parent's sub-issues can share an issue number — the after/before
# anchor lookup must filter by repo as well as number, otherwise
# `first(.nodes[] | select(.number == X))` picks whichever the API
# returned first and anchors against the wrong sibling silently.
#
# Echoes JSON: { totalCount: N, nodes: [{id, number, repository{...}}, ...] }
# or "null" if the parent isn't found.
#
# Arguments: repo_id, parent_num
zh_subissue_fetch_ids_only() {
    local repo_id="$1"
    local parent_num="$2"

    local query='
    query($repoId: ID!, $issueNumber: Int!, $after: String) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            githubChildIssues(first: 100, after: $after) {
                totalCount
                pageInfo {
                    hasNextPage
                    endCursor
                }
                nodes {
                    id
                    number
                    repository {
                        ownerName
                        name
                    }
                }
            }
        }
    }'

    local cursor="null"
    local prev_cursor=""
    local iterations=0
    local all_nodes="[]"
    local total_count=0
    local first_page=true
    # Round-6 #10: emit a `pagination_bailed` sentinel mirroring
    # zh_sprint_issues_fetch_all's pattern, so cmd_subissue_reorder
    # can refuse top/bottom mutations under partial coverage (same
    # SPEC as the Python round-6 #5 fix in reorder_sub_issue).
    local pagination_bailed=""

    while :; do
        # Same stuck-cursor / iteration-cap defense as zh_subissue_fetch_all.
        iterations=$((iterations + 1))
        if [[ "$iterations" -gt 200 ]]; then
            warn "Pagination iteration cap (200) hit on parent — returning partial result"
            pagination_bailed="iteration_cap"
            break
        fi

        local variables
        variables=$(jq -n \
            --arg repo_id "$repo_id" \
            --argjson issue_num "$parent_num" \
            --argjson after "$cursor" \
            '{repoId: $repo_id, issueNumber: $issue_num, after: $after}')

        local response
        response=$(zh_graphql "$query" "$variables")

        local issue_json
        issue_json=$(echo "$response" | jq '.data.issueByInfo')

        if [[ "$issue_json" == "null" ]]; then
            echo "null"
            return
        fi

        if [[ "$first_page" == "true" ]]; then
            total_count=$(echo "$issue_json" | jq -r '.githubChildIssues.totalCount // 0')
            first_page=false
        fi

        # Round-6 #7: `select(. != null)` strips null page entries
        # at aggregation, matching the other three walkers. Last
        # walker without the filter.
        local page_nodes
        page_nodes=$(echo "$issue_json" | jq -c '[(.githubChildIssues.nodes // [])[] | select(. != null)]')
        all_nodes=$(jq -n --argjson a "$all_nodes" --argjson b "$page_nodes" '$a + $b')

        local has_next end_cursor
        has_next=$(echo "$issue_json" | jq -r '.githubChildIssues.pageInfo.hasNextPage // false')
        end_cursor=$(echo "$issue_json" | jq -r '.githubChildIssues.pageInfo.endCursor // empty')

        if [[ "$has_next" != "true" ]]; then
            break
        fi
        if [[ -z "$end_cursor" ]] || ( [[ -n "$prev_cursor" ]] && [[ "$end_cursor" == "$prev_cursor" ]] ); then
            warn "Pagination cursor did not advance — returning partial result"
            pagination_bailed="stuck_cursor"
            break
        fi
        prev_cursor="$end_cursor"

        cursor=$(jq -n --arg c "$end_cursor" '$c')
    done

    jq -n \
        --argjson nodes "$all_nodes" \
        --argjson total "$total_count" \
        --arg pagination_bailed "$pagination_bailed" \
        '{totalCount: $total, nodes: $nodes, pagination_bailed: $pagination_bailed}'
}

cmd_subissue_list() {
    # Human-formatted table listing of a parent's sub-issues.
    #
    # v1.6.0 removed the `--machine` TSV mode. The sole consumer was the
    # MCP server, which now talks to ZenHub's GraphQL API directly from
    # Python (see zh_graphql_ops.list_sub_issues). Bash stays focused on
    # the human-facing rendering.
    #
    # v1.9.1 item #6: this command reads the canonical githubChildIssues
    # connection via zh_subissue_fetch_all. cmd_create, cmd_issue,
    # cmd_hierarchy_show, cmd_subissue_reorder, and the
    # add/remove/reorder walkers all share the same reader; live
    # validation against a GitHub-backed workspace (2026-05-29) confirmed
    # that BOTH addSubIssues and CreateIssueInput.parentIssueId write to
    # this connection. The zenhubChildIssues connection is for ZenHub-only
    # cards (issues with no GitHub backing) and stays empty for the writes
    # this tool performs. Do not relapse to zenhubChildIssues; pick a
    # different connection only if a new use case justifies covering the
    # ZenHub-only-card surface explicitly.
    local parent_num="${1:-}"

    if [[ -z "$parent_num" ]]; then
        error "Usage: zh subissue list <parent#>
Example: zh subissue list 42"
    fi

    parent_num="${parent_num#\#}"

    # Argument-format validation up-front (same posture as remove).
    if ! [[ "$parent_num" =~ ^[0-9]+$ ]]; then
        error "Invalid parent issue number: ${parent_num}"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    local children_json
    children_json=$(zh_subissue_fetch_all "$repo_id" "$workspace_id" "$parent_num")

    if [[ "$children_json" == "null" ]]; then
        error "Issue #${parent_num} not found in this repository"
    fi

    local parent_title child_count fetched_count
    parent_title=$(echo "$children_json" | jq -r '.parentTitle')
    child_count=$(echo "$children_json" | jq -r '.totalCount // 0')

    # Normalize once: strip any null page entries up-front so the
    # count we report and the loop we iterate share the same view of
    # the data. Round-4 #7: the pre-fix code counted `.nodes | length`
    # (pre-filter) and iterated `.nodes[] | select(. != null)`
    # (post-filter), so the divergence warning below could compare
    # inflated counts against `child_count`.
    local children_clean
    children_clean=$(echo "$children_json" | jq -c '[.nodes[] | select(. != null)]')
    fetched_count=$(echo "$children_clean" | jq -r 'length')

    echo ""
    echo -e "${BOLD}Sub-issues of #${parent_num}${NC} ${parent_title}"
    echo ""
    echo -e "  ${CYAN}Children:${NC} ${child_count}"
    echo ""

    # Gate the empty-parent early-return on `fetched_count`, not `child_count`.
    # If the API ever returns totalCount=0 with a non-empty nodes list (the
    # exact regression the divergence warning below is meant to surface), the
    # early-return would otherwise pre-empt the warning and silently report
    # "No sub-issues" while data sat in the response.
    if [[ "$fetched_count" -eq 0 ]]; then
        if [[ "$child_count" -ne 0 ]]; then
            warn "API reported ${child_count} children but returned 0 nodes (pagination drift)"
        else
            echo "  No sub-issues"
            echo ""
        fi
        return
    fi

    # Iterate the normalized intermediate so the display matches the
    # count above. Null entries were already filtered out.
    echo "$children_clean" | jq -r '.[] |
        "\(.number)\t\(.state)\t\(.pipelineIssue.pipeline.name // "—")\t\([.assignees.nodes[].login] | join(",") | if . == "" then "unassigned" else . end)\t\(.title)"' | \
        while IFS=$'\t' read -r num istate pipeline assignees ititle; do
            local marker="  "
            local color="$NC"
            if [[ "$istate" == "CLOSED" ]]; then
                marker="✓ "
                color="$YELLOW"
            fi
            printf "  ${BOLD}#%-5s${NC} │ %-20s │ %-15s │ ${color}%s%s${NC}\n" \
                "$num" "${pipeline:0:20}" "${assignees:0:15}" "$marker" "$ititle"
        done

    # Defensive: surface any mismatch between totalCount and what we actually
    # fetched. This shouldn't happen with cursor pagination, but if a future
    # API change broke pageInfo.hasNextPage we'd at least notice.
    if [[ "$fetched_count" -ne "$child_count" ]]; then
        warn "Listed ${fetched_count} of ${child_count} sub-issues (pagination drift)"
    fi

    echo ""
}

cmd_subissue_reorder() {
    local child_num="${1:-}"
    local position="${2:-}"
    local sibling_num="${3:-}"

    if [[ -z "$child_num" ]] || [[ -z "$position" ]]; then
        error "Usage: zh subissue reorder <child#> top
       zh subissue reorder <child#> bottom
       zh subissue reorder <child#> after <sibling#>
       zh subissue reorder <child#> before <sibling#>

Examples:
  zh subissue reorder 100 top              # Move to top of sibling list
  zh subissue reorder 100 bottom           # Move to bottom
  zh subissue reorder 100 after 101        # Place after sibling #101
  zh subissue reorder 100 before 102       # Place before sibling #102

Note: ZenHub's reprioritizeSubIssue mutation uses sibling-anchored positioning
(after/before another child), not integer positions. 'top' and 'bottom' are
resolved to the first/last sibling on the client side."
    fi

    # Argument-only validation up-front, before any network round-trips:
    # numeric format, position keyword, sibling-required-for-after/before,
    # and self-anchor guard. Doing these checks here rather than inside the
    # case below surfaces typos before we touch the API.
    local stripped_child="${child_num#\#}"
    if ! [[ "$stripped_child" =~ ^[0-9]+$ ]]; then
        error "Invalid child issue number: ${child_num}"
    fi
    local stripped_sib=""
    if [[ -n "$sibling_num" ]]; then
        stripped_sib="${sibling_num#\#}"
        if ! [[ "$stripped_sib" =~ ^[0-9]+$ ]]; then
            error "Invalid sibling issue number: ${sibling_num}"
        fi
    fi
    case "$position" in
        top|first|bottom|last)
            ;;
        after|before)
            if [[ -z "$sibling_num" ]]; then
                error "'${position}' requires a sibling issue number.
Example: zh subissue reorder ${child_num} ${position} 101"
            fi
            # Reject self-anchor: passing the same number for child and
            # sibling would send `afterId == childIssueId` to the API, which
            # is at best a no-op and at worst undefined behavior. Compare
            # arithmetically with forced base-10 so '0100' vs '100' doesn't
            # sneak through and '08'/'09' don't trip bash's octal parser.
            if (( 10#$stripped_child == 10#$stripped_sib )); then
                error "Cannot anchor #${stripped_child} against itself.
'${position}' requires a different sibling issue number."
            fi
            ;;
        *)
            error "Invalid position: ${position}
Use 'top', 'bottom', 'after <sibling#>', or 'before <sibling#>'."
            ;;
    esac

    child_num="$stripped_child"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # Step 1: resolve the child to its ZenHub ID + parent reference. We don't
    # fetch the sibling list here — that comes from the paginated fetcher
    # below — because the parent could have >100 children and the sibling we
    # need to anchor against may be on a later page.
    local lookup_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            parentIssue {
                id
                number
            }
            repository {
                ownerName
                name
            }
        }
    }'

    local lookup_vars
    lookup_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$child_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local lookup_response
    lookup_response=$(zh_graphql "$lookup_query" "$lookup_vars")

    local child_id child_title parent_id parent_num child_owner child_repo
    child_id=$(echo "$lookup_response" | jq -r '.data.issueByInfo.id // empty')
    child_title=$(echo "$lookup_response" | jq -r '.data.issueByInfo.title // ""')
    parent_id=$(echo "$lookup_response" | jq -r '.data.issueByInfo.parentIssue.id // empty')
    parent_num=$(echo "$lookup_response" | jq -r '.data.issueByInfo.parentIssue.number // empty')
    child_owner=$(echo "$lookup_response" | jq -r '.data.issueByInfo.repository.ownerName // empty')
    child_repo=$(echo "$lookup_response" | jq -r '.data.issueByInfo.repository.name // empty')

    if [[ -z "$child_id" ]]; then
        error "Issue #${child_num} not found"
    fi
    # Cross-repo defense: if a coincidentally-numbered sub-issue exists in
    # repo A while the real target lives in repo B, the API resolves issue
    # by (repoId, number) and silently picks the wrong one. Compare the
    # resolved repository to the checkout repo and refuse if they differ.
    if [[ -n "$child_owner" ]] && [[ "${child_owner}/${child_repo}" != "$owner_repo" ]]; then
        error "Issue #${child_num} lives in ${child_owner}/${child_repo}, but you're working from ${owner_repo}.
Cross-repo sub-issue operations are not supported by this CLI — cd into a
checkout of ${child_owner}/${child_repo} and re-run."
    fi
    if [[ -z "$parent_id" ]]; then
        error "Issue #${child_num} has no parent — cannot reorder a non-sub-issue.
Use 'zh subissue add <parent#> ${child_num}' first."
    fi

    # Step 2: fetch ALL sibling IDs via the paginated helper. For top/bottom
    # we need first/last sibling IDs; for after/before we need to look up the
    # named sibling by issue number, which could live on any page. The
    # ids-only variant skips assignee/pipeline/repo projection since reorder
    # doesn't need them.
    local sibling_ids_json
    sibling_ids_json=$(zh_subissue_fetch_ids_only "$repo_id" "$parent_num")

    if [[ "$sibling_ids_json" == "null" ]]; then
        error "Could not load siblings of #${child_num} (parent #${parent_num} not found?)"
    fi

    # Round-6 #10: when the sibling walk bailed mid-coverage,
    # top/bottom anchoring is unsafe — the "first" or "last" sibling
    # in a partial set isn't the workspace-global first/last, so the
    # mutation would silently corrupt order. Refuse the mutation for
    # top/bottom; allow after/before since the user named an
    # explicit anchor we'll either find or fail on cleanly. Mirrors
    # the Python round-6 #5 fix in reorder_sub_issue.
    local sibling_pagination_bailed
    sibling_pagination_bailed=$(echo "$sibling_ids_json" | jq -r '.pagination_bailed // ""')
    case "$position" in
        top|first|bottom|last)
            if [[ -n "$sibling_pagination_bailed" ]]; then
                error "Cannot determine sibling order for '${position}' under partial pagination — sub-issue listing bailed: ${sibling_pagination_bailed}. Re-list ('zh subissue list ${parent_num}') and retry once full coverage is available, OR use 'after' / 'before' with an explicit sibling number."
            fi
            ;;
    esac

    # Resolve the position keyword to an afterId or beforeId. ZenHub treats
    # `afterId: null` and `beforeId: null` specially:
    #   - afterId only set → place right after that sibling
    #   - beforeId only set → place right before that sibling
    #   - both null         → place at the top (no anchor)
    #   - top → beforeId = first sibling's id (excluding self)
    #   - bottom → afterId = last sibling's id (excluding self)
    local after_id="null"
    local before_id="null"
    local position_desc=""

    case "$position" in
        top|first)
            local first_sib_id
            first_sib_id=$(echo "$sibling_ids_json" | \
                jq -r --arg cid "$child_id" \
                '[.nodes[] | select(.id != $cid)][0].id // empty')
            if [[ -z "$first_sib_id" ]]; then
                # Only child — there is nothing to reorder against. Skip the
                # mutation entirely rather than firing a vacuous reorder
                # whose ✓ output would suggest something happened.
                echo ""
                warn "#${child_num} is the only sub-issue of #${parent_num} — nothing to reorder."
                exit 1
            fi
            before_id="\"${first_sib_id}\""
            position_desc="top"
            ;;
        bottom|last)
            local last_sib_id
            last_sib_id=$(echo "$sibling_ids_json" | \
                jq -r --arg cid "$child_id" \
                '[.nodes[] | select(.id != $cid)][-1].id // empty')
            if [[ -z "$last_sib_id" ]]; then
                echo ""
                warn "#${child_num} is the only sub-issue of #${parent_num} — nothing to reorder."
                exit 1
            fi
            after_id="\"${last_sib_id}\""
            position_desc="bottom"
            ;;
        after)
            sibling_num="${sibling_num#\#}"
            # Filter siblings by (number, owner, repo) — number alone is
            # ambiguous in a multi-repo workspace where two of a parent's
            # children share an issue number (round-3 finding #5). The
            # owner/repo are taken from the cwd-resolved $owner_repo so we
            # anchor against the sibling in the SAME repo the user is
            # working in.
            local sib_id
            sib_id=$(echo "$sibling_ids_json" | \
                jq -r --arg n "$sibling_num" \
                    --arg owner "${owner_repo%%/*}" \
                    --arg name "${owner_repo##*/}" \
                'first(
                    .nodes[]
                    | select((.number|tostring) == $n)
                    | select(.repository.ownerName == $owner and .repository.name == $name)
                    | .id
                ) // empty')
            if [[ -z "$sib_id" ]]; then
                error "Anchor #${sibling_num} not found among sub-issues of #${parent_num} in ${owner_repo}.
The sibling may live in a different repo of this workspace, or it may not
be linked to this parent. Use 'zh subissue list ${parent_num}' to verify."
            fi
            after_id="\"${sib_id}\""
            position_desc="after #${sibling_num}"
            ;;
        before)
            sibling_num="${sibling_num#\#}"
            local sib_id
            sib_id=$(echo "$sibling_ids_json" | \
                jq -r --arg n "$sibling_num" \
                    --arg owner "${owner_repo%%/*}" \
                    --arg name "${owner_repo##*/}" \
                'first(
                    .nodes[]
                    | select((.number|tostring) == $n)
                    | select(.repository.ownerName == $owner and .repository.name == $name)
                    | .id
                ) // empty')
            if [[ -z "$sib_id" ]]; then
                error "Anchor #${sibling_num} not found among sub-issues of #${parent_num} in ${owner_repo}.
The sibling may live in a different repo of this workspace, or it may not
be linked to this parent. Use 'zh subissue list ${parent_num}' to verify."
            fi
            before_id="\"${sib_id}\""
            position_desc="before #${sibling_num}"
            ;;
    esac

    info "Reordering sub-issue #${child_num} to ${position_desc} under parent #${parent_num}..."

    # Build the input. We have to construct the JSON manually because the
    # after/before IDs may be null vs a string, which jq's --arg can't model.
    local input_json
    input_json=$(jq -n \
        --arg parent_id "$parent_id" \
        --arg child_id "$child_id" \
        --argjson after_id "$after_id" \
        --argjson before_id "$before_id" \
        '{parentId: $parent_id, childIssueId: $child_id, afterId: $after_id, beforeId: $before_id}')

    local mutation_vars
    mutation_vars=$(jq -n --argjson input "$input_json" '{input: $input}')

    local mutation='
    mutation($input: ReprioritizeSubIssueInput!) {
        reprioritizeSubIssue(input: $input) {
            success
            githubErrors
        }
    }'

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local ok
    ok=$(echo "$response" | jq -r '.data.reprioritizeSubIssue.success // false')

    if [[ "$ok" != "true" ]]; then
        local gh_errors
        gh_errors=$(echo "$response" | jq -c '.data.reprioritizeSubIssue.githubErrors // null')
        error "Failed to reorder sub-issue #${child_num} (githubErrors: ${gh_errors})"
    fi

    echo ""
    success "Reordered sub-issue #${child_num}: ${child_title}"
    echo -e "  Now at ${CYAN}${position_desc}${NC} under parent ${GREEN}#${parent_num}${NC}"
}

cmd_subissue() {
    load_config

    local sub="${1:-}"
    shift || true

    case "$sub" in
        add)
            cmd_subissue_add "$@"
            ;;
        remove|rm)
            cmd_subissue_remove "$@"
            ;;
        list|ls)
            cmd_subissue_list "$@"
            ;;
        reorder|order|pos)
            cmd_subissue_reorder "$@"
            ;;
        ""|help|-h|--help)
            cat << 'EOF'
zh subissue - Manage ZenHub sub-issues (Issue → Sub-issue hierarchy tier)

USAGE:
    zh subissue <subcommand> [args]

SUBCOMMANDS:
    add <parent#> <child#> [...]      Link one or more issues as sub-issues
                                      of a parent (single API call)
    remove <parent#> <child#> [...]   Unlink one or more sub-issues from a parent
                                      (aliases: rm)
    list <parent#>                    List sub-issues of a parent
                                      (aliases: ls)
    reorder <child#> <position>       Reorder a sub-issue among its siblings
                                      Position: top | bottom |
                                                after <sibling#> |
                                                before <sibling#>
                                      (aliases: order, pos)

EXAMPLES:
    zh subissue add 42 100 101 102          # Link three sub-issues under #42
    zh subissue remove 42 100               # Unlink #100 from #42
    zh subissue list 42                     # Show sub-issues of #42
    zh subissue reorder 100 top             # Move #100 to top of siblings
    zh subissue reorder 100 after 101       # Place #100 right after #101

NOTES:
    Sub-issues form a 3rd hierarchy tier below Epic → Issue → Sub-issue. A
    sub-issue is a regular Issue whose parentIssue points to another Issue.
    Use 'zh issue <N>' to see whether an issue has a parent or children.

    Sub-issue reordering uses sibling-anchored positioning (after/before
    another child), not integer positions like 'zh reorder'. This matches
    ZenHub's reprioritizeSubIssue mutation semantics.
EOF
            ;;
        *)
            error "Unknown subissue subcommand: ${sub}

Run 'zh subissue help' for usage information."
            ;;
    esac
}

# =============================================================================
# Main
# =============================================================================
#
# Exit-code convention for mutation-emitting subcommands (round-10
# Pattern C / round-9 #5):
#
#   0 — clean success: outcome == "ok", no warnings, full coverage.
#   1 — real failure: at least one input rejected by the API
#        (failed_count > 0), OR zero positives confirmed under
#        full coverage. "Definitely wrong" takes precedence over
#        coverage warnings.
#   2 — coverage incomplete / re-verify: divergence-only partial
#        (API count disagrees with inferred set), walker bailed
#        mid-walk, OR post-state can't be confirmed after a
#        successful mutation. Scripted callers should re-verify
#        before retrying.
#
# `error` (zh utility func, line ~30) exits 1 for pre-mutation
# validation failures (bad usage, parent-not-found, etc.) — those
# don't get their own tier because no mutation has fired and the
# caller can fix and retry without coverage concerns.
#
# This convention is observed by: cmd_subissue_add, cmd_subissue_remove,
# cmd_sprint_add, cmd_sprint_remove.

main() {
    # Global flag parsing (peel off `-r` / `--repo` and `-w` /
    # `--workspace` before the subcommand). Config-file defaults are
    # already in the environment via load_config when the subcommand
    # body runs, so we seed the override vars from them here for a
    # uniform consumption point.
    #
    # Precedence (highest first):
    #   1. command-line flag (-r / -w)
    #   2. ZH_REPO / ZH_WORKSPACE env var (also set by load_config from
    #      the config file)
    #   3. git remote / first-workspace inference (in get_repo_info /
    #      get_workspace_id)
    #
    # Note: load_config hasn't run yet at this point — subcommand bodies
    # call it themselves — so ZH_REPO / ZH_WORKSPACE here only reflect
    # the SHELL env, not the config file. The config-file path comes
    # into play later: load_config sources the file, exposing ZH_REPO
    # and ZH_WORKSPACE; get_repo_info / get_workspace_id then read them
    # if ZH_REPO_OVERRIDE / ZH_WORKSPACE_NAME aren't set. So the flag
    # always wins; env wins over config; config wins over inference.
    ZH_REPO_OVERRIDE="${ZH_REPO_OVERRIDE:-}"
    ZH_WORKSPACE_NAME="${ZH_WORKSPACE_NAME:-}"

    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--repo)
                if [[ -z "${2:-}" ]]; then
                    error "Option $1 requires an owner/repo value"
                fi
                ZH_REPO_OVERRIDE="$2"
                shift 2
                ;;
            -w|--workspace)
                if [[ -z "${2:-}" ]]; then
                    error "Option $1 requires a workspace name"
                fi
                ZH_WORKSPACE_NAME="$2"
                shift 2
                ;;
            --)
                shift
                args+=("$@")
                break
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done
    # Export so subshells / piped invocations also see them
    export ZH_REPO_OVERRIDE ZH_WORKSPACE_NAME
    # Conditional expansion for bash 3.2 portability — `set --
    # "${args[@]}"` on an empty array under `set -u` (which we
    # set at the top of the script) errors with "args[@]: unbound
    # variable" on bash 3.2. The fix lets `zh -w foo` with no
    # subcommand fall through cleanly to the help dispatcher.
    # Round-5 #9.
    set -- ${args[@]+"${args[@]}"}

    local command="${1:-help}"
    shift || true

    case "$command" in
        help|--help|-h)
            cmd_help
            ;;
        version|--version|-v)
            echo "zh version ${VERSION}"
            ;;
        issue|i|show)
            cmd_issue "$@"
            ;;
        mine|my)
            cmd_mine "$@"
            ;;
        board|b|overview)
            cmd_board "$@"
            ;;
        pipeline|pipe|col)
            cmd_pipeline "$@"
            ;;
        pipelines|pipes|p)
            cmd_pipelines "$@"
            ;;
        workspaces|ws)
            cmd_workspaces "$@"
            ;;
        move|mv|m)
            cmd_move "$@"
            ;;
        reorder|order|pos)
            cmd_reorder "$@"
            ;;
        estimate|est|points)
            cmd_estimate "$@"
            ;;
        assign)
            cmd_assign "$@"
            ;;
        unassign)
            cmd_unassign "$@"
            ;;
        create|new)
            cmd_create "$@"
            ;;
        comment|c)
            cmd_comment "$@"
            ;;
        attach)
            cmd_attach "$@"
            ;;
        close)
            cmd_close "$@"
            ;;
        reopen)
            cmd_reopen "$@"
            ;;
        delete)
            cmd_delete "$@"
            ;;
        types)
            cmd_types "$@"
            ;;
        type|set-type|retype)
            cmd_set_type "$@"
            ;;
        labels)
            cmd_labels "$@"
            ;;
        users)
            cmd_users "$@"
            ;;
        block|blocked-by|depends)
            cmd_block "$@"
            ;;
        unblock)
            cmd_unblock "$@"
            ;;
        priority|prio)
            cmd_priority "$@"
            ;;
        priorities|prios)
            cmd_priorities "$@"
            ;;
        epic|epics)
            cmd_epic "$@"
            ;;
        initiative|initiatives)
            cmd_initiative "$@"
            ;;
        project|projects)
            cmd_project "$@"
            ;;
        subtask|subtasks|sub-task|sub-tasks)
            # `subtask` / `subtasks` are the canonical user-facing verbs.
            # `sub-task` / `sub-tasks` remain permanent aliases for
            # back-compat: pre-v1.9.1 builds rendered Tips/Usage as
            # `zh sub-task ...` (the lowercased ZenHub issue-type name
            # "Sub-task"), so any user, doc, or script copy-pasting that
            # form continues to work. v1.9.1 item #11 split the
            # type-name from the display-noun via
            # zh_display_noun_for_type, so every NEW Tip / Usage / hint
            # now renders the hyphenless `subtask` form.
            cmd_subtask "$@"
            ;;
        subissue|subissues|sub|child|children)
            cmd_subissue "$@"
            ;;
        sprints|sp)
            cmd_sprints "$@"
            ;;
        sprint)
            # `zh sprint` with no args defaults to the active sprint.
            if [[ $# -eq 0 ]]; then
                cmd_sprint_current
            else
                local first="$1"
                shift
                case "$first" in
                    current|active)
                        cmd_sprint_current "$@"
                        ;;
                    add)
                        cmd_sprint_add "$@"
                        ;;
                    remove|rm)
                        cmd_sprint_remove "$@"
                        ;;
                    *)
                        cmd_sprint "$first" "$@"
                        ;;
                esac
            fi
            ;;
        sa)
            # Top-level alias for `zh sprint add` (per @jeremiahrose's PR #2)
            cmd_sprint_add "$@"
            ;;
        sr)
            # Top-level alias for `zh sprint remove`
            cmd_sprint_remove "$@"
            ;;
        *)
            error "Unknown command: $command

Run 'zh help' for usage information."
            ;;
    esac
}

# v1.9.2: sourceable-mode guard. The test suite sources this script
# (via tests/_bash_runner.py's `run_zh_with_stubs` helper) to invoke
# the actual `cmd_*` functions against production logic, instead of
# carrying parallel snippets that re-implement them. The standard
# bash idiom `(return 0 2>/dev/null)` succeeds only when the script
# is sourced — when executed, `return` outside a function is a
# syntax error, so the subshell exits non-zero. Without this guard,
# sourcing `zh` would fire `main "$@"` with the test process's argv,
# which is never what we want.
if ! (return 0 2>/dev/null); then
    main "$@"
fi
