cmd_delete() {
    load_config

    local assume_yes=false
    local issue_num=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -y|--yes) assume_yes=true; shift ;;
            --) shift; issue_num="${1:-}"; break ;;
            -*) error "Unknown flag for delete: $1 (usage: zh delete <issue#> [-y|--yes])" ;;
            *) issue_num="$1"; shift ;;
        esac
    done

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh delete <issue#> [-y|--yes]

PERMANENTLY delete a GitHub issue (via 'gh issue delete'). ZenHub tracks
GitHub issues, so the card disappears from the board too. A sub-issue is
just an issue, so this deletes sub-issues as well.

DANGER: This is permanent, cannot be undone, and requires admin or triage
permission on the repository. For the normal case use 'zh close <issue#>'
instead. Epics are normal issues in v1.9.0, so this command deletes them
too: 'zh delete <epic-issue#>'.

When run from an interactive terminal you'll be asked to retype the issue
number to confirm; pass -y/--yes to skip the prompt (also implied for
non-interactive callers such as agents, pipes, and CI).

NOTE: This targets GitHub issues. ZenHub's own deleteZenhubIssue mutation
only accepts ZenHub-native cards (e.g. the onboarding sample seeded into a
new workspace) and rejects GitHub-backed issues — so deletion is done
through GitHub, mirroring how 'close'/'reopen' wrap gh. A purely
ZenHub-native card with no GitHub issue behind it must be removed in the
ZenHub web UI.

Example: zh delete 42"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    # Fetch the title first — both for the confirmation message and to
    # verify the issue exists before attempting deletion. The `|| true`
    # is load-bearing under `set -euo pipefail`: when the issue does not
    # exist, gh exits non-zero, and a bare assignment would let set -e
    # kill the script silently (exit 1, no message) before the not-found
    # guard below can fire its helpful message.
    local issue_title=""
    issue_title=$(gh issue view "$issue_num" --repo "$owner_repo" --json title --jq '.title' 2>/dev/null) || true

    if [[ -z "$issue_title" ]]; then
        error "Issue #${issue_num} not found in ${owner_repo}.
(Note: 'zh delete' targets GitHub issues. A ZenHub-native card with no
GitHub issue behind it must be removed in the ZenHub web UI.)"
    fi

    # Confirmation gate: deletion is permanent and irreversible (unlike
    # close/reopen). When stdin is an interactive terminal and -y/--yes
    # was not given, require the user to retype the issue number — mirrors
    # gh's own interactive confirmation. Non-interactive callers (agents,
    # pipes, CI) proceed without prompting: a blocking read would hang
    # them, and the agent's propose-first protocol is the guardrail there.
    if [[ "$assume_yes" != true && -t 0 ]]; then
        warn "PERMANENTLY delete #${issue_num}: ${issue_title}"
        warn "This cannot be undone."
        printf "Type the issue number (%s) to confirm, or anything else to cancel: " "$issue_num" >&2
        local reply=""
        # `|| true`: on EOF (Ctrl-D) read exits non-zero, which under
        # `set -euo pipefail` would kill the script before the friendly
        # abort message. reply stays empty, so the mismatch check below
        # still cancels safely.
        read -r reply || true
        if [[ "$reply" != "$issue_num" ]]; then
            error "Aborted — confirmation did not match. Nothing was deleted."
        fi
    fi

    info "Deleting issue #${issue_num}: ${issue_title}..."

    # Delete via GitHub (gh), mirroring how 'close' / 'reopen' wrap gh.
    # --yes skips gh's own prompt (zh has already gated on confirmation
    # above). Capture gh's stderr so a real failure cause (auth, network,
    # rate limit, race) is surfaced rather than always blaming permissions.
    # ZenHub's board reflects GitHub issue state, so the card disappears
    # from the board automatically.
    local gh_err
    if gh_err=$(gh issue delete "$issue_num" --repo "$owner_repo" --yes 2>&1); then
        echo ""
        success "Deleted #${issue_num}: ${issue_title}"
    else
        error "Failed to delete issue #${issue_num}: ${gh_err:-(no error output)}
(gh issue delete typically needs admin or triage permission on ${owner_repo}.)"
    fi
}

cmd_create() {
    load_config

    local title=""
    local body=""
    local body_file=""
    local issue_type=""
    local labels=""
    local assignee=""
    local pipeline=""
    local estimate=""
    local parent=""
    local priority_name=""
    local json_out="false"
    local quiet_out="false"

    # Parse arguments.
    # v1.9.1 round-3 finding #4: every long flag uses an exact-match
    # case arm, so `--priority=High` (and `--type=...`, `--pipeline=...`,
    # etc.) would fall into `*)` and be silently swallowed as the title
    # or discarded. Normalize `--flag=value` into `--flag value` at the
    # top of each iteration so every long-form GNU-style invocation is
    # accepted on the same code path.
    #
    # v1.9.1 round-4 finding #4: an empty value (`--type=`, `--priority=`,
    # `--pipeline=`, often produced by an unset shell variable in a
    # wrapper script) used to slip past the arity guard because the
    # normalizer produced `--type ""` and the arity guard counts `""`
    # as a present argument. Empty values are now rejected up-front so
    # `--type=` no longer silently creates an untyped issue (the
    # nastiest variant).
    while [[ $# -gt 0 ]]; do
        # Round-6 finding #8: a literal title starting with `--`
        # (e.g. `zh create "--rotate=enabled fails on retry" -t Bug`)
        # used to be silently split by the unconditional normalizer
        # and lose the user's text. Two-stage disambiguation: only
        # normalize when (a) the title has already been captured (any
        # later `--foo=bar` is unambiguously a flag), OR (b) the
        # `--foo` prefix matches a flag name this verb actually
        # accepts. Anything else is treated as a positional and falls
        # through to `*)` where it becomes the title.
        if [[ "$1" == --*=* ]]; then
            local _norm_flag="${1%%=*}"
            local _norm_val="${1#*=}"
            local _is_known_flag="false"
            local _is_boolean_flag="false"
            case "$_norm_flag" in
                --type|--parent|--priority|--label|--labels|--assign|--assignee|--pipeline|--estimate|--body|--file|--body-file|--description)
                    _is_known_flag="true"
                    ;;
                --json|--quiet|--stdin)
                    # v1.9.2 round-7 finding #2: these flags are boolean
                    # (their case arms use single shift, no value
                    # consumed). The pre-fix code listed them as known
                    # flags and let the normalizer split them; the case
                    # arm consumed only the flag token and left the
                    # value as the next positional, which would fall to
                    # `*)` and become the title. Reject the GNU-equals
                    # form up-front with a clear diagnostic.
                    _is_known_flag="true"
                    _is_boolean_flag="true"
                    ;;
            esac
            if [[ -n "$title" || "$_is_known_flag" == "true" ]]; then
                if [[ "$_is_boolean_flag" == "true" ]]; then
                    error "Option ${_norm_flag} is a boolean flag and does not accept a value (received '${1}')"
                fi
                if [[ -z "$_norm_val" ]]; then
                    error "Option ${_norm_flag} requires a value (received empty string from '${1}')"
                fi
                set -- "$_norm_flag" "$_norm_val" "${@:2}"
            fi
        fi
        case "$1" in
            -t|--type)
                issue_type="$2"
                shift 2
                ;;
            --parent)
                parent="$2"
                shift 2
                ;;
            --priority)
                # v1.9.1 item #8 (G5): set priority at create time. Resolved
                # against the workspace's configured priorities using the
                # same name-resolution helper as cmd_priority.
                if [[ $# -lt 2 ]]; then
                    error "Option ${1} requires a value"
                fi
                priority_name="$2"
                shift 2
                ;;
            --json)
                json_out="true"
                shift
                ;;
            -q|--quiet)
                quiet_out="true"
                shift
                ;;
            -l|--label|--labels)
                labels="$2"
                shift 2
                ;;
            -a|--assign|--assignee)
                assignee="$2"
                shift 2
                ;;
            -p|--pipeline)
                pipeline="$2"
                shift 2
                ;;
            -e|--estimate)
                estimate="$2"
                shift 2
                ;;
            -b|--body|--description)
                # v1.9.2 round-7 finding #1: `--description` was in the
                # normalizer's known-flag list at zh:2414 (so the GNU-
                # equals form normalized) but had NO case arm. The
                # normalized token fell to `*)` and silently dropped
                # the body (or, if title was unset, captured `--description`
                # as the title and dropped the user's intended title).
                # cmd_hierarchy_create translates the planning-noun
                # `--description` to `-b`, but a user passing
                # `--description` directly to `zh create` lost their
                # input. Accept it as an alias for `-b|--body` so both
                # entry points work.
                body="$2"
                shift 2
                ;;
            -f|--file|--body-file)
                body_file="$2"
                shift 2
                ;;
            --stdin)
                body=$(cat)
                shift
                ;;
            *)
                if [[ -z "$title" ]]; then
                    title="$1"
                fi
                shift
                ;;
        esac
    done

    # Read body from file if specified
    if [[ -n "$body_file" ]]; then
        if [[ -f "$body_file" ]]; then
            body=$(cat "$body_file")
        else
            error "Body file not found: $body_file"
        fi
    fi

    if [[ -z "$title" ]]; then
        error "Usage: zh create <title> [options]

Options:
  -t, --type <type>       Issue type (discover with 'zh types')
  -l, --labels <labels>   Comma-separated labels
  -a, --assignee <user>   GitHub username to assign
  -p, --pipeline <name>   Pipeline to place issue in
  -e, --estimate <pts>    Story points estimate
  --parent <issue#>       Wire the new issue as a sub-issue of <issue#>
  --priority <name>       Set a configured priority by name (case-insensitive)
  -b, --body <text>       Issue body/description (short)
  -f, --file <path>       Read body from file (for longer descriptions)
  --stdin                 Read body from stdin
  --json                  Emit a JSON object on stdout (for batch callers)
  -q, --quiet             Emit only the new issue number on stdout

Examples:
  zh create \"Fix login bug\" -t Bug -l \"priority:high\"
  zh create \"Add dark mode\" -t Feature -a acme-user -e 5
  zh create \"Research OAuth options\" -t Task -p \"Product Backlog\"
  zh create \"Auth service\" -t Epic --json"
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # In --json / --quiet mode, human chatter goes to stderr so stdout stays
    # pure JSON (or a bare number) for batch callers piping into jq.
    if [[ "$json_out" == "true" ]] || [[ "$quiet_out" == "true" ]]; then
        info "Creating issue: ${title}..." >&2
    else
        info "Creating issue: ${title}..."
    fi

    # Build the create mutation variables
    local create_vars
    create_vars=$(jq -n --arg repo_id "$repo_id" --arg title "$title" \
        '{input: {repositoryId: $repo_id, title: $title}}')

    # Add body if provided
    if [[ -n "$body" ]]; then
        create_vars=$(echo "$create_vars" | jq --arg body "$body" '.input.body = $body')
    fi

    # Add labels if provided (as array of label names)
    if [[ -n "$labels" ]]; then
        local labels_array
        labels_array=$(echo "$labels" | jq -R 'split(",") | map(gsub("^\\s+|\\s+$"; ""))')
        create_vars=$(echo "$create_vars" | jq --argjson labels "$labels_array" '.input.labels = $labels')
    fi

    # Add assignee if provided
    if [[ -n "$assignee" ]]; then
        assignee="${assignee#@}"
        create_vars=$(echo "$create_vars" | jq --arg assignee "$assignee" '.input.assignees = [$assignee]')
    fi

    # Add issue type if provided. v1.9.0: resolve via assignableIssueTypes
    # (covers both GithubIssueType and ZenhubIssueType) instead of the old
    # githubIssueTypes-only query that could not see Epic/Initiative/Project/
    # Sub-task. A name that resolves to no type is now a hard error (with the
    # available types listed) rather than a silently-typeless create, since
    # the planning nouns depend on the type actually being set.
    if [[ -n "$issue_type" ]]; then
        local types_json
        types_json=$(zh_fetch_issue_types "$owner_repo" "$workspace_id")

        local type_id
        type_id=$(zh_issue_type_id_from "$types_json" "$issue_type")

        if [[ -n "$type_id" ]]; then
            create_vars=$(echo "$create_vars" | jq --arg type_id "$type_id" '.input.issueTypeId = $type_id')
        else
            local available
            available=$(zh_issue_type_names_from "$types_json")
            error "Issue type '${issue_type}' not found in this workspace. Available: ${available:-(none)}. Discover with 'zh types'."
        fi
    fi

    # Validate --parent and --estimate up-front, BEFORE the createIssue
    # mutation runs. Format checks happen here so a typo never produces a
    # half-created orphan issue. The actual addSubIssues wiring still
    # happens after create (the new child id has to exist first), but
    # `--parent`'s EXISTENCE is also resolved here (review finding #2):
    # zh_resolve_issue_id errors and exits 1 if the parent is missing, and
    # under `set -e` that would otherwise kill the script in the middle of
    # the post-create block, leaving the new issue with no JSON emit. We
    # cache the resolved parent id so the post-create block can reuse it.
    #
    # Sub-issue connection model (verified live against a GitHub-backed
    # workspace, 2026-05-29): BOTH addSubIssues and
    # CreateIssueInput.parentIssueId write to the GitHub-native sub-issue
    # connection (githubChildIssues / githubParentIssue), and the union
    # field parentIssue resolves to the same parent. The separate
    # zenhubChildIssues connection is for ZenHub-only cards (issues with
    # no GitHub backing) and stays empty for our writes. The whole zh
    # codebase therefore reads `githubChildIssues` everywhere: in
    # cmd_subissue_list, cmd_hierarchy_show, cmd_issue, and the walker
    # queries used by the subissue write verbs. Do not relapse to
    # zenhubChildIssues.
    local parent_stripped=""
    local parent_id=""
    if [[ -n "$parent" ]]; then
        parent_stripped="${parent#\#}"
        if ! [[ "$parent_stripped" =~ ^[0-9]+$ ]]; then
            error "Invalid parent issue number: ${parent}"
        fi
        # Existence check BEFORE create so a bad parent does not orphan the
        # new issue. Review finding #2.
        #
        # CRITICAL bash gotcha: `local parent_id=$(zh_resolve_issue_id ...)`
        # would silently swallow the called function's `exit 1` because
        # `local` ALWAYS returns 0 under `set -e`. The failing command-
        # substitution's exit code never propagates, so the script
        # continues and createIssue runs anyway, producing the very orphan
        # this guard is meant to prevent. We therefore declare `parent_id`
        # on its own line (above) and do a bare assignment here so set -e
        # sees and acts on the failure.
        parent_id=$(zh_resolve_issue_id "$repo_id" "$parent_stripped")
        if [[ -z "$parent_id" ]]; then
            error "Could not resolve parent issue #${parent_stripped}"
        fi
    fi

    # Validate --estimate up-front so a non-numeric value never aborts jq
    # AFTER createIssue has run (review finding #3). Allow integer or
    # decimal points.
    if [[ -n "$estimate" ]] && ! [[ "$estimate" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
        error "Invalid estimate: ${estimate} (must be numeric, e.g. 1, 3, 0.5)"
    fi

    # v1.9.1 item #8 (G5): resolve --priority BEFORE createIssue runs so a
    # bad name does not leave a created-but-unprioritized issue behind. The
    # mutation itself fires after the pipeline assignment (priority lives
    # on the pipelineIssue, not the raw issue), but the name -> id lookup
    # belongs in the pre-flight block alongside --parent and --estimate
    # validation. Mirrors cmd_priority's name resolution path.
    local priority_id=""
    if [[ -n "$priority_name" ]]; then
        local priorities_json
        priorities_json=$(zh_fetch_priorities "$workspace_id")
        priority_id=$(zh_priority_id_from "$priorities_json" "$priority_name")
        if [[ -z "$priority_id" ]]; then
            local available
            available=$(echo "$priorities_json" | jq -r 'if length == 0 then "(none configured)" else ([.[].name] | join(", ")) end')
            error "No priority named '${priority_name}' in this workspace. Available: ${available}. Add it in ZenHub workspace settings if you want to use it (discover with 'zh priorities')."
        fi
    fi

    local mutation='
    mutation($input: CreateIssueInput!) {
        createIssue(input: $input) {
            issue {
                id
                number
                title
                htmlUrl
                issueType {
                    __typename
                    ... on GithubIssueType { name level }
                    ... on ZenhubIssueType { name level }
                }
            }
        }
    }'

    local response
    response=$(zh_graphql "$mutation" "$create_vars")

    local new_issue_id new_issue_num new_issue_url new_type_name new_type_level
    new_issue_id=$(echo "$response" | jq -r '.data.createIssue.issue.id // empty')
    new_issue_num=$(echo "$response" | jq -r '.data.createIssue.issue.number // empty')
    new_issue_url=$(echo "$response" | jq -r '.data.createIssue.issue.htmlUrl // empty')
    new_type_name=$(echo "$response" | jq -r '.data.createIssue.issue.issueType.name // empty')
    new_type_level=$(echo "$response" | jq -r '.data.createIssue.issue.issueType.level // empty')

    if [[ -z "$new_issue_num" ]]; then
        error "Failed to create issue: $(echo "$response" | jq -r '.errors[0].message // "unknown error"')"
    fi

    # `human` is true only when neither --json nor --quiet was requested.
    local human="true"
    if [[ "$json_out" == "true" ]] || [[ "$quiet_out" == "true" ]]; then
        human="false"
    fi

    if [[ "$human" == "true" ]]; then
        echo ""
        success "Created issue #${new_issue_num}: ${title}"
        echo -e "  URL: ${CYAN}${new_issue_url}${NC}"
        if [[ -n "$new_type_name" ]]; then
            echo -e "  Type: ${GREEN}${new_type_name}${NC} (level ${new_type_level})"
        fi
    fi

    # Wire the new issue under its parent via addSubIssues (the same mutation
    # 'zh epic add' / 'zh subissue add' use), so it shows up under
    # 'zh <noun> show'. The parent id was already resolved up-front (see the
    # pre-create validation block) so a bad parent could not orphan the new
    # issue; here we just reuse it.
    local parent_wired=""
    if [[ -n "$parent_stripped" ]]; then
        local sub_mutation='
        mutation($input: AddSubIssuesInput!) {
            addSubIssues(input: $input) {
                successCount
                failedIssues { number }
            }
        }'
        local sub_vars
        sub_vars=$(jq -n --arg pid "$parent_id" --arg cid "$new_issue_id" \
            '{input: {parentId: $pid, childIssueIds: [$cid]}}')

        # Round-6 finding #5: fail-soft envelope. The prior bare
        # assignment `sub_response=$(zh_graphql ...)` died under set -e
        # when zh_graphql `error`s and exits 1 on a .errors response,
        # killing the script BEFORE the --json emit, even though the
        # issue was already created. Capture failures so the parent-
        # wire becomes a recoverable warn that points at the manual
        # re-wire verb.
        # v1.9.2 round-7 finding #12: capture stderr alongside stdout
        # so the "could not attach" warn includes the root-cause
        # diagnostic. Pre-fix, `2>/dev/null` silenced messages like
        # "Error: ZenHub API error: Invalid token" — leaving the user
        # with six generic "could not X" warns across the create flow
        # and no hint that the token needed refreshing. Use a temp
        # file to keep stdout and stderr separable; both go through
        # the helper so additional envelopes can reuse the pattern.
        local sub_response="" sub_err="" sub_ok=0
        local _sub_err_file
        _sub_err_file=$(mktemp -t zh_subwire.XXXXXX 2>/dev/null) || _sub_err_file=/dev/null
        sub_response=$(zh_graphql "$sub_mutation" "$sub_vars" 2>"$_sub_err_file") || sub_response=""
        sub_err=$(zh_cause_hint "$_sub_err_file")
        # v1.9.3 pattern-sweep: harden rm-f against set-e abort (mirrors
        # the round-4 #10 fix already applied to cmd_subissue_add /
        # cmd_subissue_remove / cmd_set_type). A read-only TMPDIR or a
        # sibling-process unlink would otherwise abort the function AFTER
        # the mutation has run.
        [[ "$_sub_err_file" != "/dev/null" ]] && rm -f "$_sub_err_file" 2>/dev/null || true
        if [[ -n "$sub_response" ]]; then
            sub_ok=$(echo "$sub_response" | jq -r '.data.addSubIssues.successCount // 0')
        fi
        if [[ "$sub_ok" -ge 1 ]]; then
            parent_wired="$parent_stripped"
            if [[ "$human" == "true" ]]; then
                echo -e "  Parent: ${GREEN}#${parent_stripped}${NC}"
            fi
        else
            if [[ -n "$sub_err" ]]; then
                warn "Created #${new_issue_num} but could not attach it to parent #${parent_stripped} (cause: ${sub_err}). Re-wire with 'zh subissue add ${parent_stripped} ${new_issue_num}'."
            else
                warn "Created #${new_issue_num} but could not attach it to parent #${parent_stripped}. Re-wire with 'zh subissue add ${parent_stripped} ${new_issue_num}'."
            fi
        fi
    fi

    # Set estimate if provided.
    # v1.9.1 round-4 finding #1: fail-soft. Round-3 #7 wrapped only the
    # priority block's zh_graphql calls, but this estimate mutation, the
    # pipeline lookup, and the moveIssue mutation all run AFTER
    # createIssue succeeded and BEFORE the --json emit. A transient
    # .errors response on any of them used to abort the script under
    # set -e, leaving stdout empty even though the issue WAS created.
    # A retry would then produce a duplicate. Wrap each call so any
    # failure falls through to a warn, and the JSON still emits.
    # Round-6 finding #1: the prior `if zh_graphql ...; then ... else`
    # form CANNOT intercept `error → exit 1` from a .errors response,
    # because the `error` call inside zh_graphql calls `exit 1` in the
    # current shell. Only running zh_graphql inside a $(...)
    # command-substitution puts it in a subshell whose `exit` is
    # contained, and the outer `|| <fallback>` then captures the
    # non-zero status. This mirrors the WORKING pattern the priority
    # block already uses below.
    local estimate_applied="false"
    if [[ -n "$estimate" ]]; then
        local est_mutation='
        mutation($input: SetEstimateInput!) {
            setEstimate(input: $input) {
                issue { id }
            }
        }'

        local est_vars
        est_vars=$(jq -n --arg issue_id "$new_issue_id" --argjson value "$estimate" \
            '{input: {issueId: $issue_id, value: $value}}')

        # v1.9.2 round-7 finding #12: same root-cause capture pattern
        # as the parent-wire envelope.
        local est_result="" est_err=""
        local _est_err_file
        _est_err_file=$(mktemp -t zh_estwire.XXXXXX 2>/dev/null) || _est_err_file=/dev/null
        est_result=$(zh_graphql "$est_mutation" "$est_vars" 2>"$_est_err_file") || est_result=""
        est_err=$(zh_cause_hint "$_est_err_file")
        # v1.9.3 pattern-sweep: rm-f hardening (see _sub_err_file comment).
        [[ "$_est_err_file" != "/dev/null" ]] && rm -f "$_est_err_file" 2>/dev/null || true
        if [[ -n "$est_result" ]]; then
            estimate_applied="true"
            if [[ "$human" == "true" ]]; then
                echo -e "  Estimate: ${GREEN}${estimate}${NC} points"
            fi
        else
            if [[ -n "$est_err" ]]; then
                warn "Created #${new_issue_num} but the estimate mutation failed (cause: ${est_err}). Retry with 'zh estimate #${new_issue_num} ${estimate}'."
            else
                warn "Created #${new_issue_num} but the estimate mutation failed. Retry with 'zh estimate #${new_issue_num} ${estimate}'."
            fi
        fi
    fi

    # Move to pipeline if provided.
    # Same round-4 #1 envelope on the pipelines lookup AND the moveIssue
    # mutation. An empty pipelines_response (due to a transient error)
    # cleanly falls through to the "Pipeline not found" warn, so the
    # downstream priority block also short-circuits correctly.
    local pipeline_set=""
    if [[ -n "$pipeline" ]]; then
        # Get pipeline ID
        local pipelines_query='
        query($workspaceId: ID!) {
            workspace(id: $workspaceId) {
                pipelinesConnection {
                    nodes {
                        id
                        name
                    }
                }
            }
        }'

        local pipelines_vars
        pipelines_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

        # v1.9.2 round-7 finding #12: capture stderr so a "Pipeline
        # '...' not found" warn that's actually caused by a network
        # / auth failure carries the cause hint.
        local pipelines_response="" pipelines_err=""
        local _pipelines_err_file
        _pipelines_err_file=$(mktemp -t zh_pipelookup.XXXXXX 2>/dev/null) || _pipelines_err_file=/dev/null
        pipelines_response=$(zh_graphql "$pipelines_query" "$pipelines_vars" 2>"$_pipelines_err_file") || pipelines_response=""
        pipelines_err=$(zh_cause_hint "$_pipelines_err_file")
        # v1.9.3 pattern-sweep: rm-f hardening (see _sub_err_file comment).
        [[ "$_pipelines_err_file" != "/dev/null" ]] && rm -f "$_pipelines_err_file" 2>/dev/null || true
        local pipeline_id=""
        if [[ -n "$pipelines_response" ]]; then
            pipeline_id=$(echo "$pipelines_response" | jq -r --arg name "$pipeline" \
                '.data.workspace.pipelinesConnection.nodes[] | select((.name | gsub("^\\s+|\\s+$"; "") | ascii_downcase) == ($name | gsub("^\\s+|\\s+$"; "") | ascii_downcase)) | .id')
        fi

        if [[ -n "$pipeline_id" ]]; then
            local move_mutation='
            mutation($input: MoveIssueInput!) {
                moveIssue(input: $input) {
                    issue { id }
                }
            }'

            local move_vars
            move_vars=$(jq -n --arg issue_id "$new_issue_id" --arg pipeline_id "$pipeline_id" \
                '{input: {issueId: $issue_id, pipelineId: $pipeline_id, position: 0}}')

            # Round-6 finding #2: same `$(...)` capture pattern as the
            # estimate envelope. The prior `if zh_graphql ...; then ...
            # else` form would not have caught `error → exit 1` from
            # zh_graphql, so the round-5 #1 priority_id cleanup in the
            # else branch was unreachable. Now both the success arm and
            # the priority-cleanup branch run as intended.
            # v1.9.2 round-7 finding #12: same root-cause capture.
            local move_result="" move_err=""
            local _move_err_file
            _move_err_file=$(mktemp -t zh_movewire.XXXXXX 2>/dev/null) || _move_err_file=/dev/null
            move_result=$(zh_graphql "$move_mutation" "$move_vars" 2>"$_move_err_file") || move_result=""
            move_err=$(zh_cause_hint "$_move_err_file")
            # v1.9.3 pattern-sweep: rm-f hardening (see _sub_err_file comment).
            [[ "$_move_err_file" != "/dev/null" ]] && rm -f "$_move_err_file" 2>/dev/null || true
            if [[ -n "$move_result" ]]; then
                pipeline_set="$pipeline"
                if [[ "$human" == "true" ]]; then
                    echo -e "  Pipeline: ${GREEN}${pipeline}${NC}"
                fi
            else
                if [[ -n "$move_err" ]]; then
                    warn "Created #${new_issue_num} but the move-to-'${pipeline}' mutation failed (cause: ${move_err}). Retry with 'zh move #${new_issue_num} \"${pipeline}\"'."
                else
                    warn "Created #${new_issue_num} but the move-to-'${pipeline}' mutation failed. Retry with 'zh move #${new_issue_num} \"${pipeline}\"'."
                fi
                # Round-5 finding #1: mirror the "Pipeline not found"
                # defense. setPriorityOnPipelineIssues binds to whichever
                # pipelineIssue exists for the issue, which is still the
                # default placement when the move did not land. Skip
                # priority application here for the same reason as the
                # not-found branch; the user retries both with explicit
                # follow-ups.
                if [[ -n "$priority_id" ]]; then
                    warn "Skipping --priority '${priority_name}' because the move-to-'${pipeline}' mutation failed: priority lives on the pipelineIssue and would bind to the wrong placement. Re-run 'zh priority #${new_issue_num} \"${priority_name}\"' after the move retries."
                    priority_id=""
                fi
            fi
        else
            # v1.9.2 round-7 finding #12: include the cause hint
            # when the pipeline lookup actually failed (vs. a clean
            # "name truly does not match any pipeline" outcome).
            if [[ -z "$pipelines_response" && -n "$pipelines_err" ]]; then
                warn "Pipeline '${pipeline}' not found (cause: ${pipelines_err})"
            else
                warn "Pipeline '${pipeline}' not found"
            fi
            # Round-2 finding #3: when --priority is ALSO requested, we
            # cannot apply it cleanly. setPriorityOnPipelineIssues
            # writes to whichever pipelineIssue the create mutation
            # produced (the default pipeline, e.g. Triage / New Issues),
            # NOT the pipeline the user asked for. A later `zh move`
            # would materialise a fresh pipelineIssue in the target
            # pipeline without the priority, and the operator would
            # think both flags landed when only the priority did, in
            # the wrong place. Skip the priority mutation in that case
            # and surface the trade-off so the operator can decide
            # whether to retry with the correct pipeline name.
            if [[ -n "$priority_id" ]]; then
                warn "Skipping --priority '${priority_name}' because --pipeline did not resolve: priority lives on the pipelineIssue and would bind to the wrong placement. Re-run 'zh priority #${new_issue_num} \"${priority_name}\"' after moving the issue into '${pipeline}'."
                priority_id=""
            fi
        fi
    fi

    # v1.9.1 item #8 (G5): apply --priority after pipeline placement.
    # setPriorityOnPipelineIssues requires a pipelineIssue id, which only
    # exists once the issue lives in a pipeline. If no --pipeline was
    # passed, the create mutation drops the new issue in a default
    # pipeline (New Issues / Triage); look up its pipelineIssue id from
    # the issue and set priority on that.
    #
    # Round-6 finding #7: when --priority is requested but no --pipeline
    # was supplied at all (so we never tried to move), the priority
    # will still bind to whatever default pipelineIssue the workspace
    # produces. That's USABLE (the priority does land), but a future
    # `zh move` materialises a new pipelineIssue in the target and the
    # priority does NOT carry over. Warn the operator about the
    # implicit lifetime so they can plan around it.
    if [[ -n "$priority_id" ]] && [[ -z "$pipeline" ]]; then
        warn "--priority '${priority_name}' will bind to the workspace's default pipelineIssue (e.g. Triage) and will be lost if you later 'zh move' this issue. Pass --pipeline at create time or re-apply with 'zh priority #${new_issue_num} \"${priority_name}\"' after moving."
    fi

    local priority_set=""
    if [[ -n "$priority_id" ]]; then
        local pi_lookup_query='
        query($repoId: ID!, $issueNumber: Int!, $workspaceId: ID!) {
            issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
                pipelineIssue(workspaceId: $workspaceId) { id }
            }
        }'
        local pi_lookup_vars
        pi_lookup_vars=$(jq -n --arg repo_id "$repo_id" --argjson n "$new_issue_num" --arg ws "$workspace_id" \
            '{repoId: $repo_id, issueNumber: $n, workspaceId: $ws}')
        # Round-3 finding #7: the post-create priority path runs AFTER
        # createIssue has succeeded. A transient .errors response on
        # either the pipelineIssue lookup or the priority mutation used
        # to abort the script before the --json emit (zh_graphql errors
        # and exits 1; under `set -e` the parent assignment dies). The
        # issue was created but stdout stayed empty, so a script reading
        # `n=$(zh create ... --json | jq -r .number)` would think the
        # create failed and retry, producing a duplicate. Wrap both
        # zh_graphql calls so any failure falls through to the existing
        # warn paths.
        # v1.9.2 round-7 finding #12: capture stderr for the cause hint.
        local pi_lookup_response="" pi_lookup_err="" pipeline_issue_id=""
        local _pi_err_file
        _pi_err_file=$(mktemp -t zh_pilookup.XXXXXX 2>/dev/null) || _pi_err_file=/dev/null
        pi_lookup_response=$(zh_graphql "$pi_lookup_query" "$pi_lookup_vars" 2>"$_pi_err_file") || pi_lookup_response=""
        pi_lookup_err=$(zh_cause_hint "$_pi_err_file")
        # v1.9.3 pattern-sweep: rm-f hardening (see _sub_err_file comment).
        [[ "$_pi_err_file" != "/dev/null" ]] && rm -f "$_pi_err_file" 2>/dev/null || true
        if [[ -n "$pi_lookup_response" ]]; then
            pipeline_issue_id=$(echo "$pi_lookup_response" | jq -r '.data.issueByInfo.pipelineIssue.id // empty')
        fi

        if [[ -z "$pipeline_issue_id" ]]; then
            if [[ -n "$pi_lookup_err" ]]; then
                warn "Created #${new_issue_num} but could not resolve its pipelineIssue id to set priority '${priority_name}' (cause: ${pi_lookup_err}). Retry with 'zh priority #${new_issue_num} \"${priority_name}\"'."
            else
                warn "Created #${new_issue_num} but could not resolve its pipelineIssue id to set priority '${priority_name}'. Retry with 'zh priority #${new_issue_num} \"${priority_name}\"'."
            fi
        else
            local prio_mutation='
            mutation($input: SetPriorityOnPipelineIssuesInput!) {
                setPriorityOnPipelineIssues(input: $input) {
                    pipelineIssues { priority { name } }
                }
            }'
            local prio_vars
            prio_vars=$(jq -n --arg pid "$pipeline_issue_id" --arg priority_id "$priority_id" \
                '{input: {pipelineIssueIds: [$pid], priorityId: $priority_id}}')
            # v1.9.2 round-7 finding #12: capture stderr root-cause.
            local prio_response="" prio_err="" prio_applied=""
            local _prio_err_file
            _prio_err_file=$(mktemp -t zh_priowire.XXXXXX 2>/dev/null) || _prio_err_file=/dev/null
            prio_response=$(zh_graphql "$prio_mutation" "$prio_vars" 2>"$_prio_err_file") || prio_response=""
            prio_err=$(zh_cause_hint "$_prio_err_file")
            # v1.9.3 pattern-sweep: rm-f hardening (see _sub_err_file comment).
            [[ "$_prio_err_file" != "/dev/null" ]] && rm -f "$_prio_err_file" 2>/dev/null || true
            if [[ -n "$prio_response" ]]; then
                prio_applied=$(echo "$prio_response" | jq -r '.data.setPriorityOnPipelineIssues.pipelineIssues[0].priority.name // empty')
            fi
            if [[ -n "$prio_applied" ]]; then
                priority_set="$prio_applied"
                if [[ "$human" == "true" ]]; then
                    echo -e "  Priority: ${GREEN}${prio_applied}${NC}"
                fi
            else
                if [[ -n "$prio_err" ]]; then
                    warn "Created #${new_issue_num} but the priority mutation did not confirm '${priority_name}' (cause: ${prio_err}). Retry with 'zh priority #${new_issue_num} \"${priority_name}\"'."
                else
                    warn "Created #${new_issue_num} but the priority mutation did not confirm '${priority_name}'. Retry with 'zh priority #${new_issue_num} \"${priority_name}\"'."
                fi
            fi
        fi
    fi

    # Machine-readable output (G2). --json wins over --quiet if both are set.
    #
    # Round-2 finding #7: the `priority` field alone cannot distinguish
    # "user did not pass --priority" from "user passed --priority but
    # the post-create mutation did not confirm it" (read-after-write
    # lag, transient API failure). Emit `priority_requested` alongside
    # `priority` so a consumer reading
    # `jq -r '"\(.priority_requested) -> \(.priority)"'` can branch:
    #     null -> null   : not requested
    #     "X"  -> "X"    : applied
    #     "X"  -> null   : requested but not confirmed (retry)
    if [[ "$json_out" == "true" ]]; then
        # Round-6 finding #10: distinguish "estimate not requested"
        # from "estimate requested but the setEstimate mutation
        # didn't confirm". Mirrors the priority_requested / priority
        # split. Three resulting states for a consumer reading
        # `.estimate_requested` and `.estimate`:
        #     null   -> null  : not requested
        #     N      -> N     : applied
        #     N      -> null  : requested but not confirmed (retry)
        local _est_applied_for_json=""
        if [[ "$estimate_applied" == "true" ]]; then
            _est_applied_for_json="$estimate"
        fi
        jq -n \
            --argjson number "$new_issue_num" \
            --arg url "$new_issue_url" \
            --arg title "$title" \
            --arg type "${new_type_name:-}" \
            --arg pipeline "${pipeline_set:-}" \
            --arg estimate "${_est_applied_for_json:-}" \
            --arg estimate_requested "${estimate:-}" \
            --arg parent "${parent_wired:-}" \
            --arg priority "${priority_set:-}" \
            --arg priority_requested "${priority_name:-}" \
            '{number: $number, url: $url, title: $title,
              type: (if $type == "" then null else $type end),
              pipeline: (if $pipeline == "" then null else $pipeline end),
              estimate: (if $estimate == "" then null else ($estimate | tonumber) end),
              estimate_requested: (if $estimate_requested == "" then null else ($estimate_requested | tonumber) end),
              parent: (if $parent == "" then null else ($parent | tonumber) end),
              priority: (if $priority == "" then null else $priority end),
              priority_requested: (if $priority_requested == "" then null else $priority_requested end)}'
    elif [[ "$quiet_out" == "true" ]]; then
        echo "$new_issue_num"
    fi
}

cmd_types() {
    load_config

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Getting issue types for ${owner_repo}..."

    local workspace_id
    workspace_id=$(get_workspace_id "$owner_repo")

    # v1.9.0: assignableIssueTypes returns the full workspace hierarchy
    # (Initiative/Project/Epic + Bug/Feature/Task + Sub-task), each with its
    # level (1-5) and disposition (PLANNING_PANEL vs BOARD) and source
    # (ZenhubIssueType vs GithubIssueType). The old githubIssueTypes query
    # only saw the board-level GitHub types.
    local types_json
    types_json=$(zh_fetch_issue_types "$owner_repo" "$workspace_id")

    echo ""
    echo -e "${BOLD}Issue Types${NC} (assignable in this workspace):"
    echo ""

    if [[ "$types_json" == "[]" ]] || [[ -z "$types_json" ]]; then
        echo "  (none: connect the repo to a ZenHub workspace, or enable types in settings)"
        echo ""
        return
    fi

    printf "  ${BOLD}%-14s %-6s %-15s %s${NC}\n" "NAME" "LEVEL" "DISPOSITION" "SOURCE"
    echo "$types_json" | jq -r 'sort_by(.level)[] |
        "\(.name)\t\(.level)\t\(.disposition)\t\(.typename)"' | \
        while IFS=$'\t' read -r name level disposition source; do
            printf "  %-14s %-6s %-15s %s\n" "$name" "$level" "$disposition" "$source"
        done
    echo ""
    echo -e "${CYAN}Tip:${NC} PLANNING_PANEL types (Initiative/Project/Epic) appear in Goals & Planning;"
    echo -e "     BOARD types (Bug/Feature/Task/Sub-task) appear on the board."
}

