#!/bin/bash
#
# zh - ZenHub CLI Tool
#
# A command-line interface for ZenHub API operations.
# Wraps the ZenHub GraphQL API to manage issues, pipelines, and workspaces.
#
# Repository: https://github.com/acme-user/zenhub-cli
# License: MIT
#

set -euo pipefail

# Read version from VERSION file (same directory as script, resolving symlinks)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VERSION=$(cat "${SCRIPT_DIR}/VERSION" 2>/dev/null | tr -d '[:space:]' || echo "unknown")

# =============================================================================
# Configuration
# =============================================================================

CONFIG_DIR="${HOME}/.config/zh"
CONFIG_FILE="${CONFIG_DIR}/config"
ZENHUB_API="https://api.zenhub.com/public/graphql"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# =============================================================================
# Helper Functions
# =============================================================================

error() {
    echo -e "${RED}Error:${NC} $1" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}Warning:${NC} $1" >&2
}

info() {
    echo -e "${BLUE}Info:${NC} $1"
}

success() {
    echo -e "${GREEN}✓${NC} $1"
}

# Load configuration
load_config() {
    # Check for config file
    if [[ -f "$CONFIG_FILE" ]]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    fi

    # Check for local .env file
    if [[ -f ".env" ]]; then
        # shellcheck source=/dev/null
        source ".env"
    fi

    # Validate required config
    if [[ -z "${ZH_TOKEN:-}" ]]; then
        error "ZH_TOKEN not set. Create ${CONFIG_FILE} with:
  ZH_TOKEN=your_zenhub_api_token

Get your token at: https://app.zenhub.com/settings/tokens"
    fi
}

# Make a GraphQL request to ZenHub API
zh_graphql() {
    local query="$1"
    local variables="${2:-{\}}"

    # Build request body using jq to ensure proper JSON formatting
    local body
    body=$(jq -n --arg q "$query" --argjson v "$variables" '{query: $q, variables: $v}')

    local response
    response=$(curl -s -X POST "$ZENHUB_API" \
        -H "Authorization: Bearer ${ZH_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "$body")

    # Check for errors
    if echo "$response" | jq -e '.errors' > /dev/null 2>&1; then
        local error_msg
        error_msg=$(echo "$response" | jq -r '.errors[0].message // "Unknown error"')
        error "ZenHub API error: $error_msg"
    fi

    echo "$response"
}

# Get GitHub owner/repo. Resolution order:
#   1. ZH_REPO_OVERRIDE — set by the `-r` / `--repo` global flag
#   2. ZH_REPO — config-file value (read by load_config)
#   3. git remote get-url origin in the current directory
#
# The first two paths are explicit; the third is the historical default
# and is what every command does when nothing's overridden.
get_repo_info() {
    if [[ -n "${ZH_REPO_OVERRIDE:-}" ]]; then
        echo "$ZH_REPO_OVERRIDE"
        return
    fi
    if [[ -n "${ZH_REPO:-}" ]]; then
        echo "$ZH_REPO"
        return
    fi

    local remote_url
    remote_url=$(git remote get-url origin 2>/dev/null || echo "")

    if [[ -z "$remote_url" ]]; then
        error "No repository specified.

Either:
  - Use -r owner/repo (or --repo) to target a specific repository
  - Set ZH_REPO=owner/repo in ${CONFIG_FILE}
  - Run from within a git repository with a GitHub remote (origin)

For multi-workspace repos, also see -w / --workspace and ZH_WORKSPACE."
    fi

    # Parse owner/repo from various URL formats.
    #
    # Repo names on GitHub can contain dots (e.g. "docs.github.io",
    # "my.tool", "internal.docs"). The repo group used to be `[^/.]+`
    # which silently failed to match those. The Python `_GH_URL_RE`
    # was fixed previously; this brings the bash regex in line.
    #
    # Bash extended regex doesn't support non-greedy quantifiers, so
    # we match greedily on `[^/]+` and then strip the optional
    # `.git` suffix and trailing `/` from the captured repo name.
    if [[ "$remote_url" =~ github\.com[:/]([^/]+)/([^/]+) ]]; then
        local owner="${BASH_REMATCH[1]}"
        local repo="${BASH_REMATCH[2]}"
        # Drop trailing slash + optional .git suffix.
        repo="${repo%/}"
        repo="${repo%.git}"
        echo "${owner}/${repo}"
    else
        error "Could not parse GitHub repository from remote URL: $remote_url"
    fi
}

# Get ZenHub repository ID from owner/repo (uses gh CLI to get GitHub ID first)
get_repo_id() {
    local owner_repo="$1"

    # First get the GitHub repo ID using gh CLI
    local gh_id
    gh_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>/dev/null)

    if [[ -z "$gh_id" ]]; then
        error "Could not get GitHub repo ID for: $owner_repo (is gh CLI authenticated?)"
    fi

    # Now query ZenHub with the GitHub ID
    local query='
    query($ghIds: [Int!]!) {
        repositoriesByGhId(ghIds: $ghIds) {
            id
            ghId
            name
        }
    }'

    local variables
    variables=$(jq -n --argjson gh_id "$gh_id" '{ghIds: [$gh_id]}')

    local response
    response=$(zh_graphql "$query" "$variables")

    local repo_id
    repo_id=$(echo "$response" | jq -r '.data.repositoriesByGhId[0].id // empty')

    if [[ -z "$repo_id" ]]; then
        error "Repository not found in ZenHub: $owner_repo (GitHub ID: $gh_id)"
    fi

    echo "$repo_id"
}

# Hard cap on workspace-list pagination iterations. 50 pages × 50 nodes
# = 2,500 workspaces, vastly more than any plausible per-repo count, so
# the cap only ever fires on a server-side stuck-cursor bug.
ZH_WORKSPACE_PAGINATION_CAP=50

# Walk every page of `workspacesConnection` for a repo and emit a single
# JSON array of `{id, name}` nodes on stdout. Same stuck-cursor +
# iteration-cap defenses as the sub-issue and sprint walkers.
#
# Argument: gh_id (GitHub numeric repo id).
zh_workspaces_fetch_all() {
    local gh_id="$1"

    local query='
    query($ghIds: [Int!]!, $after: String) {
        repositoriesByGhId(ghIds: $ghIds) {
            id
            workspacesConnection(first: 50, after: $after) {
                pageInfo { hasNextPage endCursor }
                nodes { id name }
            }
        }
    }'

    local cursor="null"
    local last_cursor=""
    local iterations=0
    local all_nodes="[]"

    while :; do
        iterations=$((iterations + 1))
        if [[ "$iterations" -gt "$ZH_WORKSPACE_PAGINATION_CAP" ]]; then
            warn "Workspace pagination iteration cap (${ZH_WORKSPACE_PAGINATION_CAP}) reached"
            break
        fi

        local variables
        variables=$(jq -n --argjson gh_id "$gh_id" --argjson after "$cursor" \
            '{ghIds: [$gh_id], after: $after}')

        local response
        response=$(zh_graphql "$query" "$variables")

        local page_nodes
        page_nodes=$(echo "$response" | jq -c '.data.repositoriesByGhId[0].workspacesConnection.nodes // []')
        all_nodes=$(jq -n --argjson a "$all_nodes" --argjson b "$page_nodes" '$a + $b')

        local has_next end_cursor
        has_next=$(echo "$response" | jq -r '.data.repositoriesByGhId[0].workspacesConnection.pageInfo.hasNextPage // false')
        end_cursor=$(echo "$response" | jq -r '.data.repositoriesByGhId[0].workspacesConnection.pageInfo.endCursor // ""')

        if [[ "$has_next" != "true" ]]; then
            break
        fi
        if [[ -z "$end_cursor" || "$end_cursor" == "$last_cursor" ]]; then
            warn "Workspace pagination cursor not advancing — bailing"
            break
        fi
        last_cursor="$end_cursor"
        cursor=$(jq -n --arg c "$end_cursor" '$c')
    done

    echo "$all_nodes"
}

# Get workspace ID for a repository (using GitHub ID).
#
# Workspace selection precedence:
#   1. ZH_WORKSPACE_NAME (set by `-w` / `--workspace` global flag) — exact
#      case-insensitive match against the workspace name. Errors with the
#      list of available workspaces if there's no match.
#   2. ZH_WORKSPACE (config-file value) — same resolution as above.
#   3. First workspace returned by the API (historical default).
#
# (1) and (2) are merged via ZH_WORKSPACE_NAME -> ZH_WORKSPACE precedence
# below. The Python `resolve_context` follows the same chain.
#
# Walks every page of `workspacesConnection` via zh_workspaces_fetch_all
# so name resolution finds workspaces beyond position 50.
get_workspace_id() {
    local owner_repo="$1"

    # Get GitHub repo ID
    local gh_id
    gh_id=$(gh api "repos/${owner_repo}" --jq '.id' 2>/dev/null)

    if [[ -z "$gh_id" ]]; then
        error "Could not get GitHub repo ID for: $owner_repo"
    fi

    local workspace_nodes
    workspace_nodes=$(zh_workspaces_fetch_all "$gh_id")

    local node_count
    node_count=$(echo "$workspace_nodes" | jq 'length')

    if [[ "$node_count" -eq 0 ]]; then
        error "No workspace found for this repository"
    fi

    # Resolve effective name: flag-set override beats env/config value
    local effective_name="${ZH_WORKSPACE_NAME:-${ZH_WORKSPACE:-}}"

    local workspace_id
    if [[ -n "$effective_name" ]]; then
        # Exact match on the workspace name (case-insensitive).
        workspace_id=$(echo "$workspace_nodes" | jq -r --arg name "$effective_name" \
            '[.[] | select((.name | ascii_downcase) == ($name | ascii_downcase))] | .[0].id // empty')

        if [[ -z "$workspace_id" ]]; then
            echo -e "${RED}Error:${NC} Workspace '${effective_name}' not found for ${owner_repo}." >&2
            echo "" >&2
            echo "Available workspaces:" >&2
            echo "$workspace_nodes" | jq -r '.[] | "  - \(.name)"' >&2
            exit 1
        fi
    else
        # Default: first workspace. Historical behaviour, preserved when
        # neither -w nor ZH_WORKSPACE is set.
        workspace_id=$(echo "$workspace_nodes" | jq -r '.[0].id // empty')
        if [[ -z "$workspace_id" ]]; then
            error "No workspace found for this repository"
        fi
    fi

    echo "$workspace_id"
}

# Build ZenHub URL for an issue
# Format: https://app.zenhub.com/workspaces/<workspace-id>/issues/gh/<owner>/<repo>/<issue-number>
build_zenhub_url() {
    local workspace_id="$1"
    local owner_repo="$2"
    local issue_num="$3"

    echo "https://app.zenhub.com/workspaces/${workspace_id}/issues/gh/${owner_repo}/${issue_num}"
}

