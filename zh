    # Get the ZenHub user IDs from workspace assignees
    local user_query='
    query($workspaceId: ID!) {
        workspace(id: $workspaceId) {
            assignees {
                nodes {
                    id
                    login
                }
            }
        }
    }'

    local user_vars
    user_vars=$(jq -n --arg workspace_id "$workspace_id" '{workspaceId: $workspace_id}')

    local user_response
    user_response=$(zh_graphql "$user_query" "$user_vars")

    # Requested logins (deduped) as a JSON array for set operations.
    local want_json
    want_json=$(printf '%s\n' "${usernames[@]}" | jq -R . | jq -s 'unique_by(.)')

    # Any requested user not present in the workspace is a hard error.
    local not_in_ws
    not_in_ws=$(echo "$user_response" | jq -r --argjson want "$want_json" \
        '($want - [.data.workspace.assignees.nodes[].login]) | join(", ")')
    if [[ -n "$not_in_ws" ]]; then
        error "User(s) not found in workspace: ${not_in_ws}. Use 'zh users' to list available users."
    fi

    # IDs to add = requested users not already assigned to the issue.
    local assigned_json
    assigned_json=$(echo "$issue_response" | jq -c '[.data.issueByInfo.assignees.nodes[].login]')
    local ids_to_add
    ids_to_add=$(echo "$user_response" | jq -c --argjson want "$want_json" --argjson assigned "$assigned_json" \
        '[.data.workspace.assignees.nodes[] | select(.login as $l | ($want | index($l)) != null) | select(.login as $l | ($assigned | index($l)) == null) | .id]')

    if [[ "$ids_to_add" == "[]" ]]; then
        echo ""
        success "${usernames[*]} already assigned to #${issue_num}: ${issue_title}"
        echo -e "  Assignees: ${GREEN}${current_assignees}${NC}"
        return 0
    fi

    info "Assigning ${usernames[*]} to issue #${issue_num}..."

    local mutation='
    mutation($input: AddAssigneesToIssuesInput!) {
        addAssigneesToIssues(input: $input) {
            successCount
            githubErrors
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg issue_id "$issue_id" --argjson assignee_ids "$ids_to_add" \
        '{input: {issueIds: [$issue_id], assigneeIds: $assignee_ids}}')

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local success_count
    success_count=$(echo "$response" | jq -r '.data.addAssigneesToIssues.successCount // 0')

    if [[ "$success_count" -eq 0 ]]; then
        local github_errors
        github_errors=$(echo "$response" | jq -r '.data.addAssigneesToIssues.githubErrors // "Unknown error"')
        error "Failed to assign ${usernames[*]}: ${github_errors}"
    fi

    # Brief delay then re-fetch to get updated assignees list
    sleep 0.5
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")
    local new_assignees
    new_assignees=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].login] | join(", ")')

    echo ""
    success "Assigned ${usernames[*]} to #${issue_num}: ${issue_title}"
    echo -e "  Assignees: ${GREEN}${new_assignees}${NC}"
}

cmd_unassign() {
    load_config

    local issue_num="${1:-}"
    shift || true

    # Parse the remaining args into a list of usernames and an explicit --all
    # flag. Clearing all assignees is now OPT-IN: a bare `zh unassign <n>` used
    # to remove EVERY assignee, so a missing/misnamed target (e.g. the MCP layer
    # silently dropping a wrong kwarg and falling back to the empty default)
    # would silently un-assign teammates on a shared issue (#80). Now the only
    # way to clear everyone is the explicit --all flag.
    local clear_all=false
    local -a usernames=()
    local arg
    for arg in "$@"; do
        case "$arg" in
            --all|-a) clear_all=true ;;
            *) usernames+=("${arg#@}") ;;   # strip @ prefix
        esac
    done

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh unassign <issue_number> <username> [username ...]
       zh unassign <issue_number> --all

Examples:
  zh unassign 42 johndoe          # Remove only johndoe
  zh unassign 42 johndoe janedoe  # Remove both named users
  zh unassign 42 --all            # Remove ALL assignees (explicit)"
    fi

    # SAFETY: refuse to clear everyone unless --all was explicitly passed.
    if [[ "$clear_all" != true ]] && [[ ${#usernames[@]} -eq 0 ]]; then
        error "Refusing to remove all assignees by default (this is a destructive, shared-state change).
Name the user(s) to remove, or pass --all to clear everyone:
  zh unassign ${issue_num#\#} <username> [username ...]
  zh unassign ${issue_num#\#} --all"
    fi
    if [[ "$clear_all" == true ]] && [[ ${#usernames[@]} -gt 0 ]]; then
        error "Pass specific username(s) OR --all, not both."
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local repo_id
    repo_id=$(get_repo_id "$owner_repo")

    # Get the issue ID and current assignees
    local issue_query='
    query($repoId: ID!, $issueNumber: Int!) {
        issueByInfo(repositoryId: $repoId, issueNumber: $issueNumber) {
            id
            title
            assignees {
                nodes {
                    id
                    login
                }
            }
        }
    }'

    local issue_vars
    issue_vars=$(jq -n --arg repo_id "$repo_id" --argjson issue_num "$issue_num" \
        '{repoId: $repo_id, issueNumber: $issue_num}')

    local issue_response
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")

    local issue_id issue_title
    issue_id=$(echo "$issue_response" | jq -r '.data.issueByInfo.id // empty')
    issue_title=$(echo "$issue_response" | jq -r '.data.issueByInfo.title')

    if [[ -z "$issue_id" ]]; then
        error "Issue #${issue_num} not found"
    fi

    # Determine which assignees to remove
    local assignee_ids_to_remove
    if [[ "$clear_all" == true ]]; then
        # Explicit --all: remove every current assignee.
        assignee_ids_to_remove=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].id]')

        if [[ "$assignee_ids_to_remove" == "[]" ]]; then
            error "Issue #${issue_num} has no assignees"
        fi

        info "Removing all assignees from issue #${issue_num}..."
    else
        # Remove ONLY the named users. Each must currently be assigned — a named
        # user who isn't assigned is a hard error (don't silently no-op a typo).
        local want_json
        want_json=$(printf '%s\n' "${usernames[@]}" | jq -R . | jq -s 'unique_by(.)')

        local not_assigned
        not_assigned=$(echo "$issue_response" | jq -r --argjson want "$want_json" \
            '($want - [.data.issueByInfo.assignees.nodes[].login]) | join(", ")')
        if [[ -n "$not_assigned" ]]; then
            error "Not assigned to issue #${issue_num}: ${not_assigned}
Current assignees: $(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].login] | join(", ") | if . == "" then "none" else . end')"
        fi

        assignee_ids_to_remove=$(echo "$issue_response" | jq -r --argjson want "$want_json" \
            '[.data.issueByInfo.assignees.nodes[] | select(.login as $l | ($want | index($l)) != null) | .id]')

        info "Removing ${usernames[*]} from issue #${issue_num}..."
    fi

    local mutation='
    mutation($input: RemoveAssigneesFromIssuesInput!) {
        removeAssigneesFromIssues(input: $input) {
            successCount
            githubErrors
        }
    }'

    local mutation_vars
    mutation_vars=$(jq -n --arg issue_id "$issue_id" --argjson assignee_ids "$assignee_ids_to_remove" \
        '{input: {issueIds: [$issue_id], assigneeIds: $assignee_ids}}')

    local response
    response=$(zh_graphql "$mutation" "$mutation_vars")

    local success_count
    success_count=$(echo "$response" | jq -r '.data.removeAssigneesFromIssues.successCount // 0')

    if [[ "$success_count" -eq 0 ]]; then
        local github_errors
        github_errors=$(echo "$response" | jq -r '.data.removeAssigneesFromIssues.githubErrors // "Unknown error"')
        error "Failed to remove assignee(s): ${github_errors}"
    fi

    # Brief delay then re-fetch to get updated assignees list
    sleep 0.5
    issue_response=$(zh_graphql "$issue_query" "$issue_vars")
    local remaining_assignees
    remaining_assignees=$(echo "$issue_response" | jq -r '[.data.issueByInfo.assignees.nodes[].login] | join(", ") | if . == "" then "none" else . end')

    echo ""
    if [[ "$clear_all" == true ]]; then
        success "Removed all assignees from #${issue_num}: ${issue_title}"
    else
        success "Removed ${usernames[*]} from #${issue_num}: ${issue_title}"
    fi
    echo -e "  Assignees: ${CYAN}${remaining_assignees}${NC}"
}

cmd_comment() {
    load_config

    local issue_num=""
    local body=""
    local body_file=""
    local from_stdin=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--file)
                body_file="$2"
                shift 2
                ;;
            --stdin)
                from_stdin=true
                shift
                ;;
            -m|--message)
                body="$2"
                shift 2
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$issue_num" ]]; then
                    issue_num="$1"
                elif [[ -z "$body" ]]; then
                    body="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh comment <issue_number> [message] [options]

Add a comment to an issue.

Options:
  -m, --message <text>  Comment text (inline)
  -f, --file <path>     Read comment from file
  --stdin               Read comment from stdin

Examples:
  zh comment 42 \"This is fixed in PR #123\"
  zh comment 42 -m \"Quick update: still investigating\"
  zh comment 42 -f ./detailed-notes.md
  echo \"Automated comment\" | zh comment 42 --stdin"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    # Read body from file if specified
    if [[ -n "$body_file" ]]; then
        if [[ ! -f "$body_file" ]]; then
            error "File not found: $body_file"
        fi
        body=$(cat "$body_file")
    fi

    # Read body from stdin if specified
    if [[ "$from_stdin" == true ]]; then
        body=$(cat)
    fi

    if [[ -z "$body" ]]; then
        error "Comment body is required. Use -m, -f, --stdin, or provide text as argument."
    fi

    local owner_repo
    owner_repo=$(get_repo_info)

    info "Adding comment to issue #${issue_num}..."

    # Use GitHub CLI to add comments (comments are a GitHub feature, synced to ZenHub)
    if ! echo "$body" | gh issue comment "$issue_num" --repo "$owner_repo" --body-file - 2>/dev/null; then
        error "Failed to add comment. Issue #${issue_num} may not exist."
    fi

    echo ""
    success "Added comment to #${issue_num}"
    # Show preview of comment (first 100 chars)
    local preview
    preview=$(echo "$body" | head -c 100)
    if [[ ${#body} -gt 100 ]]; then
        preview="${preview}..."
    fi
    echo -e "  Comment: ${preview}"
}

cmd_attach() {
    local issue_num="${1:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh attach <issue_number>

Opens the issue in your browser so you can drag-and-drop attachments.

Note: GitHub's API does not support uploading attachments programmatically.
      File attachments must be added through the web interface.

Example: zh attach 42"
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    local url="https://github.com/${owner_repo}/issues/${issue_num}"

    echo ""
    info "Opening issue #${issue_num} in browser for attachment upload..."
    echo ""
    echo -e "  ${YELLOW}Note:${NC} GitHub's API does not support file uploads to issues."
    echo -e "  Drag and drop files into the comment box in your browser."
    echo ""

    # Open in browser (works on macOS and Linux)
    if command -v open &> /dev/null; then
        open "$url"
    elif command -v xdg-open &> /dev/null; then
        xdg-open "$url"
    else
        echo -e "  URL: ${CYAN}${url}${NC}"
        echo "  (Could not auto-open browser)"
    fi
}

cmd_close() {
    load_config

    local issue_num="${1:-}"
    local comment="${2:-}"

    if [[ -z "$issue_num" ]]; then
        error "Usage: zh close <issue_number> [comment]

Close an issue (moves it to Closed pipeline in ZenHub).

Examples:
  zh close 42
  zh close 42 \"Completed in PR #99\""
    fi

    # Strip # prefix if present
    issue_num="${issue_num#\#}"

    local owner_repo
    owner_repo=$(get_repo_info)

    # Get issue title first for confirmation message. `|| true` is
    # load-bearing under `set -euo pipefail`: gh exits non-zero when the
    # issue does not exist, and a bare assignment would let set -e kill
    # the script silently before the not-found guard can fire.
    local issue_title=""
    issue_title=$(gh issue view "$issue_num" --repo "$owner_repo" --json title --jq '.title' 2>/dev/null) || true

    if [[ -z "$issue_title" ]]; then
        error "Issue #${issue_num} not found"
    fi

    info "Closing issue #${issue_num}..."

    # Close the issue via GitHub CLI (syncs to ZenHub automatically)
    if [[ -n "$comment" ]]; then
        # Add comment and close
        gh issue close "$issue_num" --repo "$owner_repo" --comment "$comment" 2>/dev/null
    else
        gh issue close "$issue_num" --repo "$owner_repo" 2>/dev/null
    fi

    if [[ $? -eq 0 ]]; then
        echo ""
        success "Closed #${issue_num}: ${issue_title}"
        if [[ -n "$comment" ]]; then
            echo -e "  Comment: ${comment}"
        fi
        echo -e "  ${CYAN}Note:${NC} Issue moved to Closed pipeline in ZenHub"
    else
        error "Failed to close issue #${issue_num}"
    fi
}

